{
  "sun_path": [
    "build"
  ],
  "path_variables": {
    "ZLIB_LIB": "/opt/cross/x86_64-linux-musl-cross/x86_64-linux-musl/lib"
  },
  "root": true,
  "entrypoints": [
    {
      "path": "src/sun_serve.sun",
      "type": "library",
      "output_name": "build/sun_serve.moon",
      "test_binary_name": "build/sun_serve_lib_test"
    },
    {
      "path": "cmd/sun_serve/main.sun",
      "type": "binary",
      "output_name": "build/sun_serve",
      "test_binary_name": "build/sun_serve_test"
    },
    {
      "path": "examples/hello_handler/main.sun",
      "type": "binary",
      "output_name": "build/hello_handler",
      "test_binary_name": "build/hello_handler_test"
    }
  ]
}
