{
  "sun_path": [
    "/usr/lib/sun"
  ],
  "path_variables": {
    "MUSL_LIB": "/opt/cross/x86_64-linux-musl-cross/x86_64-linux-musl/lib"
  },
  "root": true,
  "entrypoints": [
    {
      "path": "src/sun_serve.sun",
      "type": "library",
      "name": "sun_serve",
      "export": true
    },
    {
      "path": "cmd/sun_serve/main.sun",
      "type": "binary",
      "name": "server",
      "requires": [
        "sun_serve"
      ]
    },
    {
      "path": "examples/hello_handler/main.sun",
      "type": "binary",
      "name": "hello_handler",
      "requires": [
        "sun_serve"
      ]
    }
  ],
  "package_id": "namo-robotics/sun_serve"
}
