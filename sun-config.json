{
  "supported_targets": [
    "x86_64-linux-gnu",
    "x86_64-linux-musl"
  ],
  "root": true,
  "entrypoints": [
    {
      "path": "src/sun_serve.sun",
      "type": "library",
      "name": "sun_serve",
      "export": true,
      "steps": [
        "native-dependencies"
      ]
    },
    {
      "path": "cmd/sun_serve/main.sun",
      "type": "binary",
      "name": "server",
      "requires": [
        "sun_serve"
      ]
    },
    {
      "path": "examples/hello_handler/main.sun",
      "type": "binary",
      "name": "hello_handler",
      "requires": [
        "sun_serve"
      ]
    }
  ],
  "package_id": "namo-robotics/sun_serve",
  "steps": [
    {
      "name": "native-dependencies",
      "command": [
        "bash",
        "scripts/fetch-native-dependencies.sh",
        "${SUN_BUILD}"
      ],
      "inputs": [
        "scripts/fetch-native-dependencies.sh"
      ],
      "outputs": [
        "${SUN_BUILD}/native/libz.a",
        "${SUN_BUILD}/native/libssl.a",
        "${SUN_BUILD}/native/libcrypto.a",
        "${SUN_BUILD}/native/archives.sha256",
        "${SUN_BUILD}/native/.recipe"
      ]
    }
  ]
}
