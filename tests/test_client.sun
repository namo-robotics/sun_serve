/*
 * test_client.sun - A blocking HTTP client for the integration tests
 *
 * Deliberately naive: it speaks just enough HTTP/1.1 to exercise the server
 * from the outside, with a receive timeout so a server bug fails a test
 * instead of hanging it.
 */

/*
 * Extends the server module with shared test helpers.
 */
public module sun_serve {
  /*
   * Contains integration-test client helpers.
   */
  module tests {
    using std;

    // struct timeval for SO_RCVTIMEO.
    class Timeval {
      var sec: i64;
      var usec: i64 = 0;
      init(sec: i64) {
        this.sec = sec;
      }
    }

    // What the client read back for one request.
    public class ClientResponse {
      // The parsed HTTP status code.
      public var status: i32 = 0;
      // The header block after the status line.
      public var head: String;
      // The decoded response body.
      public var body: String;

      init(alloc: const ref HeapAllocator) {
        this.head = String(alloc, "");
        this.body = String(alloc, "");
      }

      // Report whether the header block has a line equal to the literal.
      public method has_header(line: static_ptr<u8>) bool {
        var lower: String = this.head.clone(HeapAllocator());
        lower.to_lower();
        var want = String(line);
        want.to_lower();
        return lower.contains(want);
      }
    }

    // Parse the Content-Length value from a lowercased header block.
    function content_length_of(alloc: const ref HeapAllocator, lower: const ref String) i64 throws IError {
      var name: static_ptr<u8> = "content-length:";
      var idx: i64 = match lower.find(name) {
        Option.Some(v) => v,
        Option.None => -1
      };
      if (idx < 0) {
        return -1;
      }
      var rest: String = lower.substr(alloc, idx + name.length(), lower.length() - idx - name.length());
      var value: String = rest.split(alloc, "\r\n")[0].clone(alloc);
      value.trim();
      return match value.parse_i64() {
        Option.Some(v) => v,
        Option.None => -1
      };
    }

    // Provides the blocking socket operations used by integration tests.
    public class RawClient {
      var stream: TcpStream = TcpStream();
      var pending: String;  // bytes read but not yet consumed
      var alloc: HeapAllocator;

      // Connect to loopback on port with a receive timeout.
      init(allocator: const ref HeapAllocator, port: i32) throws IError {
        this.alloc = allocator.copy();
        this.pending = String(allocator, "");
        this.stream.connect_local(port);
        set_socket_receive_timeout(this.stream.get_fd(), 10);
      }

      // Send a literal.
      public method send(text: static_ptr<u8>) void throws IError {
        this.stream.send_str(text);
      }

      // Send a String.
      public method send_string(text: const ref String) void throws IError {
        this.stream.send_string(text);
      }

      // Read more bytes into pending. Returns false at end of stream.
      method fill() bool throws IError {
        var chunk = ContiguousBuffer<u8>(this.alloc, 65536);
        var n: i64 = 0;
        try {
          n = this.stream.recv(chunk);
        } catch (e: IError) {
          var msg = String(this.alloc, "recv failed with errno ");
          msg.append(e.code());
          msg.append(" after ");
          msg.append(this.pending.length());
          msg.append(" bytes");
          throw Error(e.code(), msg);
        }
        if (n <= 0) {
          return false;
        }
        for (var i: i64 = 0; i < n; i = i + 1) {
          this.pending.append_char(chunk[i]);
        }
        return true;
      }

      // Read until pending bytes contain a literal or the peer stops sending.
      public method read_until(needle: static_ptr<u8>) String throws IError {
        while (not this.pending.contains(needle)) {
          if (not this.fill()) {
            break;
          }
        }
        return this.pending.clone(this.alloc);
      }

      /*
       * Report whether the server closed the connection (a read returns
       * nothing within the timeout counts as still open).
       */
      public method peer_closed() bool {
        try {
          return not this.fill();
        } catch (e: IError) {
          return false;
        }
      }

      /*
       * Read one response, framed by Content-Length or chunked encoding.
       * Interim 1xx responses are skipped.
       */
      public method read_response() ClientResponse throws IError {
        while (true) {
          var resp: ClientResponse = this.read_one();
          if (resp.status >= 200) {
            return resp;
          }
        }
        return ClientResponse(this.alloc);
      }

      /*
       * Read a response to a HEAD request: head only, whatever length it
       * declares.
       */
      public method read_head_response() ClientResponse throws IError {
        return this.read_framed(true);
      }

      // Read exactly one status line, header block, and body.
      method read_one() ClientResponse throws IError {
        return this.read_framed(false);
      }

      // Read one response; head_only skips the body a HEAD response omits.
      method read_framed(head_only: bool) ClientResponse throws IError {
        var header_end: i64 = -1;
        while (true) {
          header_end = std.find_header_end(this.pending);
          if (header_end >= 0) {
            break;
          }
          if (not this.fill()) {
            throw Error(-1, "connection closed before response head");
          }
        }
        var resp = ClientResponse(this.alloc);
        // The status line is "HTTP/1.1 <code> <reason>"; the head follows it.
        var head: String = this.pending.substr(this.alloc, 0, header_end);
        var lines: Vec<String> = head.split(this.alloc, "\r\n");
        var status_line: Vec<String> = lines[0].split_whitespace(this.alloc);
        if (status_line.size() >= 2) {
          resp.status = match status_line[1].parse_i64() {
            Option.Some(v) => _convert<i32>(v),
            Option.None => 0
          };
        }
        for (var i: i64 = 1; i < lines.size(); i = i + 1) {
          resp.head.append(lines[i]);
          resp.head.append("\r\n");
        }
        var body_start: i64 = header_end + 4;
        var lower: String = resp.head.clone(this.alloc);
        lower.to_lower();
        var consumed: i64 = body_start;
        if (lower.contains("transfer-encoding: chunked")) {
          consumed = this.read_chunked(body_start, resp.body);
        } else {
          var length: i64 = content_length_of(this.alloc, lower);
          if (head_only or resp.status < 200 or resp.status == 204 or resp.status == 304) {
            length = 0;
          }
          if (length < 0) {
            length = 0;
          }
          while (this.pending.length() < body_start + length) {
            if (not this.fill()) {
              throw Error(-1, "connection closed before body ended");
            }
          }
          resp.body = this.pending.substr(this.alloc, body_start, length);
          consumed = body_start + length;
        }
        this.pending = this.pending.substr(this.alloc, consumed, this.pending.length() - consumed);
        return resp;
      }

      /*
       * Decode a chunked body starting at from, filling more as needed.
       * Returns the index just past the terminating chunk.
       */
      method read_chunked(from: i64, out: ref String) i64 throws IError {
        var i: i64 = from;
        while (true) {
          // Need a full size line.
          var eol: i64 = -1;
          while (true) {
            var k: i64 = i;
            while (k + 1 < this.pending.length()) {
              if (this.pending.at(k) == b'\r' and this.pending.at(k + 1) == b'\n') {
                eol = k;
                break;
              }
              k = k + 1;
            }
            if (eol >= 0) {
              break;
            }
            if (not this.fill()) {
              throw Error(-1, "connection closed inside chunked body");
            }
          }
          var size: i64 = 0;
          for (var k: i64 = i; k < eol; k = k + 1) {
            var d: i32 = hex_value(this.pending.at(k));
            if (d < 0) {
              break;
            }
            size = size * 16 + _convert<i64>(d);
          }
          i = eol + 2;
          if (size == 0) {
            while (this.pending.length() < i + 2) {
              if (not this.fill()) {
                throw Error(-1, "connection closed before chunk terminator");
              }
            }
            return i + 2;
          }
          while (this.pending.length() < i + size + 2) {
            if (not this.fill()) {
              throw Error(-1, "connection closed inside chunk");
            }
          }
          out.append(this.pending.substr(this.alloc, i, size));
          i = i + size + 2;
        }
        return i;
      }

      // Close the socket.
      public method close() void {
        this.stream.close();
      }
    }
  }
}
