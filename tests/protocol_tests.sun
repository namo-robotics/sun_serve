// protocol_tests.sun - Unit coverage for HTTP/2, HPACK, and WebSocket wire helpers

/*
 * Extends the server module with protocol tests.
 */
public module sun_serve {

  using std;

  /*
   * Contains HTTP/2, HPACK, and WebSocket tests.
   */
  module protocol_tests {

    using std;
    using std.thread;
    using sun_serve;

    // Send one message through a handle owned by another thread.
    function send_from_thread(handle: WebSocketHandle) std.AllocationResult<bool> {
      var alloc = make_heap_allocator();
      var text = try String(alloc, "thread");
      return std.AllocationResult.Ok(try handle.send_text(text) == WebSocketSendResult.Queued);
    }

    test_function websocket_cross_thread_wake_stale_and_overflow() {
      var alloc = make_heap_allocator();
      var wake_fd: i32 = create_event_counter();
      try std.test.assert(wake_fd > 0, "eventfd created");
      var mailbox = try Shared<WebSocketMailbox>(alloc, try WebSocketMailbox(alloc));

      var generation: i64 = 0;
      if (true) {
        var guard = mailbox.lock();
        generation = guard.get().activate(64, false, wake_fd);
      }
      var handle = WebSocketHandle(mailbox.clone(), generation);
      var sender = try spawn(send_from_thread, try handle.clone());
      try std.test.assert(try sender.join(), "cross-thread send queued");
      var wake_count: u64 = 0;
      try std.test.assert_eq(read_event_counter(wake_fd, wake_count), 8);
      try std.test.assert(wake_count >= 1, "worker notified");
      var frames = try ByteBuffer(alloc, 32);
      if (true) {
        var guard = mailbox.lock();
        try guard.get().drain(generation, frames);
      }
      try std.test.assert((try frames.to_string(alloc)).contains("thread"), "queued frame retained");
      if (true) {
        var guard = mailbox.lock();
        guard.get().activate(4, false, wake_fd);
      }
      var stale = try String(alloc, "x");
      try std.test.assert(
        try handle.send_text(stale) == WebSocketSendResult.Invalid,
        "stale handle rejected"
      );
      var current_generation: i64 = generation + 1;
      var current = WebSocketHandle(
        mailbox.clone(),
        current_generation
      );
      var too_large = try String(alloc, "overflow");
      try std.test.assert(
        try current.send_text(too_large) == WebSocketSendResult.Overloaded,
        "overflow reported"
      );
      close_fd(wake_fd);
    }

    test_function websocket_accept_matches_rfc() {
      var alloc = make_heap_allocator();
      var key = try String(alloc, "dGhlIHNhbXBsZSBub25jZQ==");
      var accept = try websocket_accept(alloc, key);
      try std.test.assert(
        accept.equals_literal("s3pPLMBiTxaQ9kYGzzhZRbK+xOo="),
        "RFC accept value"
      );
      try std.test.assert(websocket_valid_key(key), "valid client nonce");
    }

    test_function websocket_frames_and_utf8() {
      var alloc = make_heap_allocator();
      var out = try ByteBuffer(alloc, 16);
      var hello = try ByteBuffer(alloc, 5);
      try hello.append_literal("hello");
      try websocket_append_frame(out, WebSocketOpcode.Text, hello, 0, 5);
      try std.test.assert_eq(out.readable_len(), 7);
      try std.test.assert_eq(out.byte_at(0), 0x81);
      try std.test.assert_eq(out.byte_at(1), 5);
      try std.test.assert(websocket_valid_utf8(hello, 0, 5), "ASCII is UTF-8");
      var bad = try ByteBuffer(alloc, 2);
      try bad.append_byte(192);
      try bad.append_byte(128);
      try std.test.assert(not websocket_valid_utf8(bad, 0, 2), "overlong UTF-8 rejected");
      var offers = try String(alloc, "other; value=1, permessage-deflate; client_max_window_bits");

      try std.test.assert(try websocket_offers_deflate(alloc, offers), "compression offer found");
      var prefix = try String(alloc, "not-permessage-deflate");
      try std.test.assert(
        not (try websocket_offers_deflate(alloc, prefix)),
        "extension token is exact"
      );
      try std.test.assert_eq(websocket_close_payload_status(bad, 1), 1002);
      var invalid_code = try ByteBuffer(alloc, 2);
      try invalid_code.append_byte(3);
      try invalid_code.append_byte(237);
      try std.test.assert_eq(websocket_close_payload_status(invalid_code, 2), 1002);
    }

    test_function websocket_permessage_deflate_round_trip() {
      var alloc = make_heap_allocator();
      var source = try String(alloc, "hello hello hello hello hello");
      var source_bytes = try ByteBuffer(alloc, source.length());
      try source_bytes.append_string(source);
      var compressed = try ByteBuffer(alloc, 64);
      try std.test.assert(
        try websocket_deflate(source_bytes, 0, source_bytes.readable_len(), compressed),
        "message compressed"
      );
      try std.test.assert(compressed.readable_len() < source.length(), "repetition compressed");
      var inflated = try ByteBuffer(alloc, 64);
      try std.test.assert_eq(
        try websocket_inflate(alloc, compressed, 0, compressed.readable_len(), 1024, inflated),
        0
      );
      var restored = try inflated.to_string(alloc);
      try std.test.assert(
        restored.equals_literal("hello hello hello hello hello"),
        "message restored"
      );
      var limited = try ByteBuffer(alloc, 8);
      try std.test.assert_eq(
        try websocket_inflate(alloc, compressed, 0, compressed.readable_len(), 8, limited),
        2
      );
    }

    test_function h2c_settings_use_unpadded_base64url() {
      var alloc = make_heap_allocator();
      var encoded = try String(alloc, "AAMAAABkAAQAAP__");
      var decoded = try ByteBuffer(alloc, 16);
      try std.test.assert(try h2_decode_settings_header(encoded, decoded), "settings decoded");
      try std.test.assert_eq(decoded.readable_len(), 12);
      try std.test.assert_eq(h2_u32(decoded, 2), 100);
      try std.test.assert_eq(h2_u32(decoded, 8), 65535);
      var invalid = try String(alloc, "A===");
      var discarded = try ByteBuffer(alloc, 4);
      try std.test.assert(not try h2_decode_settings_header(invalid, discarded), "padding rejected");
    }

    test_function http2_large_response_headers_use_continuation() {
      var alloc = make_heap_allocator();
      var conn = try Connection(alloc);
      var value = try String(alloc, "");
      for (var i: i64 = 0; i < 17000; i = i + 1) {
        try value.append_char(b'a');
      }
      try conn.response.add_header_string("X-Large", value);
      var date = try DateCache(alloc);
      try date.refresh();
      try conn.queue_h2_response(date, 1, false, false);
      try std.test.assert_eq(conn.wbuf.byte_at(3), _convert<u8>(H2FrameKind.Headers));
      try std.test.assert_eq(conn.wbuf.byte_at(4) & H2_END_HEADERS, 0);
      var continuation: i64 = H2_FRAME_HEADER_LEN + h2_frame_len(conn.wbuf, 0);
      try std.test.assert_eq(
        conn.wbuf.byte_at(continuation + 3),
        _convert<u8>(H2FrameKind.Continuation)
      );
      try std.test.assert(
        (conn.wbuf.byte_at(continuation + 4) & H2_END_HEADERS) != 0,
        "continuation ends block"
      );
    }

    test_function http2_chunks_are_unframed_data() {
      var alloc = make_heap_allocator();
      var response = try Response(alloc);
      try response.write_chunk_literal("first");
      try response.write_chunk_literal("second");
      try response.end_chunks();
      var date = try String(alloc, "Thu, 01 Jan 1970 00:00:00 GMT");
      var encoded = try ByteBuffer(alloc, 128);
      try response.serialize_h2(encoded, date, 1, false, true);
      var wire = try encoded.to_string(alloc);
      try std.test.assert(wire.contains("firstsecond"), "chunk payload is contiguous");
      try std.test.assert(not wire.contains("5\r\nfirst"), "HTTP/1.1 chunk framing omitted");
    }

    test_function http2_response_waits_for_window_update() {
      var alloc = make_heap_allocator();
      var conn = try Connection(alloc);
      for (var i: i64 = 0; i < 70000; i = i + 1) {
        try conn.response.append_body("x");
      }
      var date = try DateCache(alloc);
      try date.refresh();
      try conn.queue_h2_response(date, 1, false, true);
      try conn.flush_h2_response_data();
      try std.test.assert_eq(conn.h2.send_window, 0);
      var response_index: i64 = conn.find_h2_response_stream(1);
      try std.test.assert(response_index >= 0, "response remains queued");
      try std.test.assert_eq(conn.h2.responses[response_index].data.readable_len(), 4465);
      conn.h2.send_window = 4465;
      conn.h2.responses[response_index].window = 4465;
      try conn.flush_h2_response_data();
      try std.test.assert(conn.find_h2_response_stream(1) < 0, "response completed after update");
    }

    test_function hpack_huffman_and_dynamic_table() {
      var alloc = make_heap_allocator();
      var encoded = try ByteBuffer(alloc, 12);
      try encoded.append_literal("\xf1\xe3\xc2\xe5\xf2\x3a\x6b\xa0\xab\x90\xf4\xff");
      var text: String = match try hpack_huffman_decode(alloc, encoded, 0, 12) {
        Option.Some(v) => v,
        Option.None => try String(alloc, "")
      };
      try std.test.assert(text.equals_literal("www.example.com"), "RFC Huffman example");

      var decoder = try HpackDecoder(alloc);
      var first = try ByteBuffer(alloc, 11);
      try first.append_byte(65);
      try first.append_byte(9);
      try first.append_literal("localhost");
      var headers = try Vec<H2Header>(alloc, 4);
      try std.test.assert(try hpack_decode(alloc, first, 11, decoder, headers), "literal decoded");
      headers.clear();
      var indexed = try ByteBuffer(alloc, 1);
      try indexed.append_byte(190);
      try std.test.assert(
        try hpack_decode(alloc, indexed, 1, decoder, headers),
        "dynamic index decoded"
      );
      try std.test.assert(headers[0].value.equals_literal("localhost"), "dynamic value");

      var first_name = try String(alloc, "x");
      var first_value = try String(alloc, "old");
      var second_name = try String(alloc, "y");
      var second_value = try String(alloc, "new");
      var eviction = try HpackDecoder(alloc);
      try eviction.add(first_name, first_value);
      try eviction.add(second_name, second_value);
      try std.test.assert(eviction.resize(36), "table resized");
      var kept_name = try String(alloc, "");
      var kept_value = try String(alloc, "");
      try std.test.assert(try eviction.lookup(62, kept_name, kept_value), "newest entry retained");
      try std.test.assert(kept_value.equals_literal("new"), "oldest entry evicted first");
    }
  }
}
