/*
 * Defines test outcomes and checks returned errors from server setup.
 */
public module sun_serve {

  /*
   * Reports assertion failures and errors from test fixtures.
   */

  /*
   * Exercises failures that callers can handle without starting workers.
   */
  module error_tests {

    using std;

    /* Answer requests for the server startup tests. */
    function handle(req: const ref Request, resp: ref Response) void throws {
      resp.set_body("ok");

      return;
    }

    test_function missing_handlers_returns_error() {
      var alloc = make_heap_allocator();
      var cfg = Config(alloc);
      cfg.add_listen(std.net.ipv4_loopback(), 0);
      var message_outcome: std.Option<String> = std.Option.None;

      var operation_completed_5 = false;
      try {
        Server<FnHandler>(alloc, cfg, fn_handlers(alloc, handle, 0));
        operation_completed_5 = true;
        message_outcome = std.Option.Some(String(alloc, "unexpected result"));
      } catch (error: std.Error) {
        if (operation_completed_5) {
          throw;
        }
        message_outcome = std.Option.Some(error.message());
      }

      var message = match message_outcome {
        std.Option.Some(value) => value,
        std.Option.None => {
          throw std.Error(1, "Exception handler produced no value");
        }
      };
      std.test.assert(message.equals_literal("a server needs at least one handler"));
    }

    test_function invalid_document_root_returns_error() {
      var alloc = make_heap_allocator();
      var root = String(alloc, "/dev/null");
      var message_outcome: std.Option<String> = std.Option.None;

      var operation_completed_4 = false;
      try {
        static_handlers(alloc, root, StaticOptions(alloc), 1);
        operation_completed_4 = true;
        message_outcome = std.Option.Some(String(alloc, "unexpected result"));
      } catch (error: std.Error) {
        if (operation_completed_4) {
          throw;
        }
        message_outcome = std.Option.Some(error.message());
      }

      var message = match message_outcome {
        std.Option.Some(value) => value,
        std.Option.None => {
          throw std.Error(1, "Exception handler produced no value");
        }
      };
      std.test.assert(message.equals_literal("not a directory: /dev/null"));
    }

    test_function invalid_certificate_preserves_tls_error() {
      var alloc = make_heap_allocator();
      var cfg = Config(alloc);
      cfg.add_tls_listen(std.net.ipv4_loopback(), 0);
      var path = String(alloc, "/dev/null");
      cfg.set_tls(path, path);
      var message_outcome: std.Option<String> = std.Option.None;

      var operation_completed_3 = false;
      try {
        Server<FnHandler>(alloc, cfg, fn_handlers(alloc, handle, 1));
        operation_completed_3 = true;
        message_outcome = std.Option.Some(String(alloc, "unexpected result"));
      } catch (error: TlsError) {
        if (operation_completed_3) {
          throw;
        }
        message_outcome = std.Option.Some(error.message());
      }

      var message = match message_outcome {
        std.Option.Some(value) => value,
        std.Option.None => {
          throw std.Error(1, "Exception handler produced no value");
        }
      };
      std.test.assert(message.contains("failed to load certificate chain"));
    }

    test_function repeated_start_returns_error_and_still_joins() {
      var alloc = make_heap_allocator();
      var cfg = Config(alloc);
      cfg.add_listen(std.net.ipv4_loopback(), 0);
      cfg.timeouts.tick_ms = 10;
      cfg.access_log = false;
      var server = Server<FnHandler>(alloc, cfg, fn_handlers(alloc, handle, 1));
      server.start();
      var message_outcome: std.Option<String> = std.Option.None;

      var operation_completed_2 = false;
      try {
        server.start();
        operation_completed_2 = true;
        message_outcome = std.Option.Some(String(alloc, "unexpected result"));
      } catch (error: std.Error) {
        if (operation_completed_2) {
          throw;
        }
        message_outcome = std.Option.Some(error.message());
      }

      var message = match message_outcome {
        std.Option.Some(value) => value,
        std.Option.None => {
          throw std.Error(1, "Exception handler produced no value");
        }
      };
      std.test.assert(message.equals_literal("server already started"));
      server.stop();
      std.test.assert_eq(server.join(), 0);
    }

    test_function invalid_epoll_descriptor_returns_system_error() {
      var alloc = make_heap_allocator();
      var epoll = Epoll(alloc, probe_epoll_layout(alloc), 1);
      var failed: bool = false;

      try {
        epoll.add(-1, EPOLLIN, 0);

        failed = false;
      } catch (error: std.Error) {
        failed = error.code() != 0;
      }

      std.test.assert(failed);
    }
  }
}
