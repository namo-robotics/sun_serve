// epoll_tests.sun - Layout probe and event round trips through Epoll.

/*
 * Extends the server module with readiness tests.
 */
public module sun_serve {
  /*
   * Contains readiness-polling tests.
   */
  module epoll_tests {
    using std;

    test_function probe_matches_machine() sun_serve.ServerTestResult {
      var alloc = make_heap_allocator();
      var layout: EpollLayout = try probe_epoll_layout(alloc);
      var machine: String = machine_name(alloc);
      if (machine.equals_literal("x86_64")) {
        try std.test.assert_eq(layout.stride, 12);
        try std.test.assert_eq(layout.data_offset, 4);
      } else {
        try std.test.assert_eq(layout.stride, 16);
        try std.test.assert_eq(layout.data_offset, 8);
      }
    }

    test_function pipe_readiness_carries_token() sun_serve.ServerTestResult {
      var alloc = make_heap_allocator();
      var layout: EpollLayout = try probe_epoll_layout(alloc);
      var ep = try Epoll(alloc, layout, 8);
      var pipe = try std.process.open_pipe(alloc);
      try ep.add(pipe.write_fd(), EPOLLOUT, 77);
      var n: i64 = try ep.wait(1000);
      try std.test.assert_eq(n, 1);
      try std.test.assert_eq(ep.event_token(0), 77);
      try std.test.assert((ep.event_mask(0) & EPOLLOUT) != 0, "write end is writable");
      try ep.modify(pipe.write_fd(), EPOLLIN, 78);
      try std.test.assert_eq(try ep.wait(0), 0);
      ep.remove(pipe.write_fd());
    }

    test_function online_cpus_is_positive() sun_serve.ServerTestResult {
      try std.test.assert(online_cpus() >= 1, "at least one cpu");
    }
  }
}
