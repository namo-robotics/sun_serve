/*
 * config.sun - Everything a Server needs to know before it starts
 *
 * Config is plain data. Every worker receives its own clone, so nothing in
 * here is shared between threads once the server is running.
 */

/*
 * Defines server configuration types and defaults.
 */
public module sun_serve {
  using std;

  // One address to listen on and whether it speaks TLS.
  public class ListenSpec {
    // The network address to bind.
    public var addr: Ipv4Addr;
    // The TCP port to bind.
    public var port: i32;
    // Whether accepted connections use TLS.
    public var tls: bool;

    // Describe a listener.
    init(addr: Ipv4Addr, port: i32, tls: bool) {
      this.addr = addr;
      this.port = port;
      this.tls = tls;
    }

    // An independent copy.
    public const method clone() ListenSpec {
      return ListenSpec(this.addr.clone(), this.port, this.tls);
    }
  }

  // Where the server certificate chain and private key live.
  public class TlsSpec {
    // The certificate-chain file path.
    public var cert_path: String;
    // The private-key file path.
    public var key_path: String;

    // Point at PEM files on disk.
    init(alloc: const ref HeapAllocator, cert_path: const ref String, key_path: const ref String) {
      this.cert_path = cert_path.clone(alloc);
      this.key_path = key_path.clone(alloc);
    }

    // No files yet; Config starts with this.
    init(alloc: const ref HeapAllocator) {
      this.cert_path = String(alloc, "");
      this.key_path = String(alloc, "");
    }

    // An independent copy.
    public const method clone(alloc: const ref HeapAllocator) TlsSpec {
      var copy = TlsSpec(alloc, this.cert_path, this.key_path);
      return copy;
    }
  }

  // Caps that keep one client from exhausting a worker. The defaults suit a general-purpose server.
  public class Limits {
    // The largest accepted request head in bytes.
    public var max_header_bytes: i64 = 16384;
    // The largest accepted request body in bytes.
    public var max_body_bytes: i64 = 8388608;
    // The largest accepted header count.
    public var max_headers: i64 = 100;
    // The largest connection count owned by one worker.
    public var max_connections_per_worker: i64 = 8192;
    // The most pipelined requests served for one readiness event.
    public var max_pipelined: i64 = 16;
    // The largest concurrent HTTP/2 stream count.
    public var max_h2_concurrent_streams: i64 = 100;
    // The largest amount of buffered HTTP/2 request data.
    public var max_h2_buffered_bytes: i64 = this.max_body_bytes;

    // An independent copy.
    public const method clone() Limits {
      var copy = Limits();
      copy.max_header_bytes = this.max_header_bytes;
      copy.max_body_bytes = this.max_body_bytes;
      copy.max_headers = this.max_headers;
      copy.max_connections_per_worker = this.max_connections_per_worker;
      copy.max_pipelined = this.max_pipelined;
      copy.max_h2_concurrent_streams = this.max_h2_concurrent_streams;
      copy.max_h2_buffered_bytes = this.max_h2_buffered_bytes;
      return copy;
    }
  }

  // How long a connection may sit in each state, in milliseconds. The defaults are tuned for browsers and command-line clients.
  public class Timeouts {
    // The TLS handshake deadline.
    public var handshake_ms: i64 = 10000;
    // The request-head deadline.
    public var header_ms: i64 = 30000;
    // The request-body deadline.
    public var body_ms: i64 = 60000;
    // The idle keep-alive deadline.
    public var keep_alive_ms: i64 = 75000;
    // The response-write deadline.
    public var write_ms: i64 = 60000;
    // The shutdown grace period for active requests.
    public var drain_ms: i64 = 5000;
    // How often idle workers wake to inspect server state.
    public var tick_ms: i64 = 250;

    // An independent copy.
    public const method clone() Timeouts {
      var copy = Timeouts();
      copy.handshake_ms = this.handshake_ms;
      copy.header_ms = this.header_ms;
      copy.body_ms = this.body_ms;
      copy.keep_alive_ms = this.keep_alive_ms;
      copy.write_ms = this.write_ms;
      copy.drain_ms = this.drain_ms;
      copy.tick_ms = this.tick_ms;
      return copy;
    }
  }

  // Holds all settings needed to start a server.
  public class Config {
    // The addresses the server listens on.
    public var listen: Vec<ListenSpec>;
    // The configured TLS certificate and key.
    public var tls: TlsSpec;
    // Whether TLS credentials have been configured.
    public var has_tls: bool = false;
    // The pending-connection queue size.
    public var backlog: i32 = 1024;
    // The server resource limits.
    public var limits: Limits = Limits();
    // The connection timeouts.
    public var timeouts: Timeouts = Timeouts();
    // The least severe diagnostic level to write.
    public var log_level: LogLevel = LogLevel.Info;
    // Whether completed requests are logged.
    public var access_log: bool = true;
    // Whether responses include the Server header.
    public var server_header: bool = true;
    // Whether HTTP/2 support is enabled.
    public var http2: bool = true;
    // Whether WebSocket compression may be negotiated.
    public var websocket_compression: bool = true;
    var alloc: HeapAllocator;

    // Start from defaults with no listeners.
    init(allocator: const ref HeapAllocator) {
      this.alloc = allocator.copy();
      this.listen = Vec<ListenSpec>(allocator, 4);
      this.tls = TlsSpec(allocator);
    }

    // Add a plain HTTP listener.
    public method add_listen(addr: const ref Ipv4Addr, port: i32) void {
      this.listen.push(ListenSpec(addr.clone(), port, false));
    }

    // Add an HTTPS listener. set_tls() must also be called.
    public method add_tls_listen(addr: const ref Ipv4Addr, port: i32) void {
      this.listen.push(ListenSpec(addr.clone(), port, true));
    }

    // Provide the certificate chain and key for TLS listeners.
    public method set_tls(cert_path: const ref String, key_path: const ref String) void {
      this.tls = TlsSpec(this.alloc, cert_path, key_path);
      this.has_tls = true;
    }

    // Report whether any listener speaks TLS.
    public const method has_tls_listener() bool {
      for (var i: i64 = 0; i < this.listen.size(); i = i + 1) {
        if (this.listen.get_unchecked(i).tls) {
          return true;
        }
      }
      return false;
    }

    // An independent copy for a worker.
    public const method clone() Config {
      var copy = Config(this.alloc);
      for (var i: i64 = 0; i < this.listen.size(); i = i + 1) {
        copy.listen.push(this.listen.get_unchecked(i).clone());
      }
      copy.tls = this.tls.clone(this.alloc);
      copy.has_tls = this.has_tls;
      copy.backlog = this.backlog;
      copy.limits = this.limits.clone();
      copy.timeouts = this.timeouts.clone();
      copy.log_level = this.log_level;
      copy.access_log = this.access_log;
      copy.server_header = this.server_header;
      copy.http2 = this.http2;
      copy.websocket_compression = this.websocket_compression;
      return copy;
    }
  }
}
