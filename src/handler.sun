/*
 * handler.sun - The contract between the server and application code
 *
 * A handler receives each parsed request and fills in the response. Every
 * worker thread owns its own handler instance, so a handler may keep state
 * without locking as long as that state is per-instance. Handlers run on the
 * event loop and must not block.
 */

/*
 * Defines the application handler contract and adapters.
 */
public module sun_serve {

  using std;

  // Defines the HTTP and WebSocket callbacks implemented by applications.
  public interface IHandler {
    // Fill resp for req. The request view is valid only during this call.
    public method handle(req: const ref Request, resp: ref Response) void;

    // Decide whether to accept a validated WebSocket opening request.
    public method handle_websocket(req: const ref Request, handshake: ref WebSocketHandshake) void;

    // Observe a newly opened WebSocket session.
    public method websocket_open(socket: const ref WebSocketHandle) void;

    // Handle one complete text or binary message.
    public method websocket_message(
      socket: const ref WebSocketHandle,
      message: const ref WebSocketMessage
    ) void;

    // Observe a completed WebSocket close exchange.
    public method websocket_close(socket: const ref WebSocketHandle, code: i32) void;

    // Observe a WebSocket protocol error before closure.
    public method websocket_error(socket: const ref WebSocketHandle, code: i32) void;
  }

  // The signature of a plain-function handler.
  public declare HandlerFn = function (const ref Request, ref Response) AllocationResult<void>;

  // Adapts a module-level function to the handler interface.
  public class FnHandler implements IHandler {
    var fn: function (const ref Request, ref Response) AllocationResult<void>;

    // Wrap a function.
    init(fn: function (const ref Request, ref Response) AllocationResult<void>) {
      this.fn = fn;
    }

    // Forward to the wrapped function.
    public method handle(req: const ref Request, resp: ref Response) void {
      match this.fn(req, resp) {
        AllocationResult.Ok => {},
        _ => { _panic("allocation failed in request handler"); }
      };
    }

    // Reject WebSocket upgrades for function handlers.
    public method handle_websocket(req: const ref Request, handshake: ref WebSocketHandshake) void {}

    // Ignore open events in this HTTP-only adapter.
    public method websocket_open(socket: const ref WebSocketHandle) void {}

    // Ignore messages in this HTTP-only adapter.
    public method websocket_message(
      socket: const ref WebSocketHandle,
      message: const ref WebSocketMessage
    ) void {}

    // Ignore close events in this HTTP-only adapter.
    public method websocket_close(socket: const ref WebSocketHandle, code: i32) void {}

    // Ignore protocol errors in this HTTP-only adapter.
    public method websocket_error(socket: const ref WebSocketHandle, code: i32) void {}
  }

  // Answers every request as not found. Useful as a placeholder.
  public class NotFoundHandler implements IHandler {
    // Send a plain-text not-found response.
    public method handle_result(req: const ref Request, resp: ref Response) std.AllocationResult<void> {
      resp.set_status(404);
      try resp.set_content_type("text/plain");
      try resp.set_body("Not Found\n");

      return std.AllocationResult.Ok;
    }

    /** Runs the callback and terminates if its response storage cannot be allocated. */
    public method handle(req: const ref Request, resp: ref Response) void {
      match this.handle_result(req, resp) {
        std.AllocationResult.Ok => {},
        _ => { _panic("allocation failed in server callback"); }
      };
    }

    // Reject WebSocket upgrades for the placeholder handler.
    public method handle_websocket(req: const ref Request, handshake: ref WebSocketHandshake) void {}

    // Ignore open events in the placeholder handler.
    public method websocket_open(socket: const ref WebSocketHandle) void {}

    // Ignore messages in this HTTP-only adapter.
    public method websocket_message(
      socket: const ref WebSocketHandle,
      message: const ref WebSocketMessage
    ) void {}

    // Ignore close events in this HTTP-only adapter.
    public method websocket_close(socket: const ref WebSocketHandle, code: i32) void {}

    // Ignore protocol errors in this HTTP-only adapter.
    public method websocket_error(socket: const ref WebSocketHandle, code: i32) void {}
  }

  /*
   * Builds one FnHandler per worker for the server to own.
   */
  public function fn_handlers(
    alloc: const ref HeapAllocator,
    fn: function (const ref Request, ref Response) AllocationResult<void>,
    count: i32
  ) std.AllocationResult<Vec<FnHandler>> {
    var out = try Vec<FnHandler>(alloc, _convert<i64>(count));
    for (var i: i32 = 0; i < count; i = i + 1) {
      try out.push(FnHandler(fn));
    }
    return std.AllocationResult.Ok(out);
  }
}
