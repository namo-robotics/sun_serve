/*
 * worker.sun - One thread's event loop
 *
 * Each worker owns an epoll instance, its own listening sockets, a table of
 * connections, and its own handler. Nothing here is shared with other workers
 * except the stop flag and WebSocket mailboxes.
 */

/*
 * Runs the server event loop for one worker thread.
 */
public module sun_serve {

  using std;
  using std.time;

  /*
   * Tokens at or above this value identify listeners; below it, connection
   * slots, except for the one token reserved for the wake descriptor.
   */
  const LISTENER_TOKEN_BASE: u64 = 0x100_0000_0000;
  const WORKER_WAKE_TOKEN: u64 = LISTENER_TOKEN_BASE - 1;

  /*
   * How many connections one readiness event on a listener may accept before
   * yielding to other work.
   */
  const ACCEPT_BATCH: i32 = 64;

  /*
   * Owns the concrete handler and resources for one worker thread.
   */
  public class WorkerArgs<H> {
    var id: i32;
    var config: Config;
    var handler: H;
    var listeners: Vec<ListenerSocket>;
    var stop: StopToken;
    var tls: TlsAcceptor;

    // Bundle the pieces for one worker.
    init(
      id: i32,
      config: Config,
      handler: H,
      listeners: Vec<ListenerSocket>,
      stop: StopToken,
      tls: TlsAcceptor
    ) {
      this.id = id;
      this.config = config;
      this.handler = handler;
      this.listeners = listeners;
      this.stop = stop;
      this.tls = tls;
    }
  }

  /*
   * Runs one event loop and owns its connections and listeners.
   */
  public class Worker<H> {
    var args: WorkerArgs<H>;
    var alloc: HeapAllocator;
    var epoll: Epoll;
    var wake_fd: i32;
    var conns: Vec<Connection>;
    var free: Vec<i64>;
    var live: i64 = 0;
    var log: Logger;
    var date: DateCache;
    var epoch: Instant = now();
    var stopping: bool = false;
    var drain_deadline: i64 = 0;
    var next_sweep: i64 = 0;
    var accept_paused_until: i64 = 0;

    // Set up the loop's resources. Listeners are registered in run().
    init(args: WorkerArgs<H>) ServerResult<void> {
      var alloc = make_heap_allocator();
      this.alloc = alloc.copy();
      this.log = try Logger(alloc, args.config.log_level, args.id, args.config.access_log);
      this.date = try DateCache(alloc);
      var layout: EpollLayout = try probe_epoll_layout(alloc);
      this.epoll = try Epoll(alloc, layout, 256);
      this.wake_fd = create_event_counter();
      if (this.wake_fd < 0) {
        return ServerResult.Error(
          Error(last_errno(), "eventfd failed")
        );
      }
      this.conns = try Vec<Connection>(alloc, 64);
      this.free = try Vec<i64>(alloc, 64);
      this.args = args;
      return ServerResult.Ok;
    }

    // Close the worker wake descriptor.
    deinit() {
      close_fd(this.wake_fd);
      this.wake_fd = 0;
    }

    // Milliseconds since the worker started.
    method now_ms() i64 {
      return this.epoch.elapsed().as_millis();
    }

    /*
     * Serve until the stop flag is raised and the connections have drained.
     * Returns the process exit status the worker would like.
     */
    public method run() std.AllocationResult<i32> {
      match this.epoll.add(this.wake_fd, EPOLLIN, WORKER_WAKE_TOKEN) {
        ServerResult.Ok => {},
        (e: const ref IError) => {
          try this.log.error_caught("failed to watch worker wake descriptor", e);
          return std.AllocationResult.Ok(1);
        }
      };
      for (var i: i64 = 0; i < this.args.listeners.size(); i = i + 1) {
        match this.epoll.add(
          this.args.listeners[i].get_fd(),
          EPOLLIN,
          LISTENER_TOKEN_BASE + _convert<u64>(i)
        ) {
          ServerResult.Ok => {},
          (e: const ref IError) => {
            try this.log.error_caught("failed to watch listener", e);
            return std.AllocationResult.Ok(1);
          }
        };
      }
      var tick: i32 = _convert<i32>(this.args.config.timeouts.tick_ms);
      while (true) {
        var n: i64 = 0;
        match this.epoll.wait(tick) {
          ServerResult.Ok(value) => {
            n = value;
          },
          (e: const ref IError) => {
            try this.log.error_caught("epoll_wait failed", e);
            return std.AllocationResult.Ok(1);
          }
        };
        try this.date.refresh();
        var now_ms: i64 = this.now_ms();
        for (var i: i64 = 0; i < n; i = i + 1) {
          var token: u64 = this.epoll.event_token(i);
          var mask: u32 = this.epoll.event_mask(i);
          if (token == WORKER_WAKE_TOKEN) {
            this.drain_wake();
            try this.drive_websockets(now_ms);
          } else if (token >= LISTENER_TOKEN_BASE) {
            try this.accept_ready(_convert<i64>(token - LISTENER_TOKEN_BASE), now_ms);
          } else {
            try this.connection_ready(_convert<i64>(token), mask, now_ms);
          }
        }
        try this.check_stop(now_ms);
        if (now_ms >= this.next_sweep) {
          try this.sweep(now_ms);
          this.next_sweep = now_ms + this.args.config.timeouts.tick_ms;
        }
        if (this.stopping and (this.live == 0 or now_ms >= this.drain_deadline)) {
          try this.close_all();
          return std.AllocationResult.Ok(0);
        }
      }
      return std.AllocationResult.Ok(0);
    }

    // Clear accumulated worker wake notifications.
    method drain_wake() void {
      var value: u64 = 0;
      while (read_event_counter(this.wake_fd, value) > 0) {}
    }

    // Drain asynchronous output for every WebSocket owned by this worker.
    method drive_websockets(now_ms: i64) std.AllocationResult<void> {
      for (var slot: i64 = 0; slot < this.conns.size(); slot = slot + 1) {
        var pending: ref Connection = this.conns[slot];
        if (pending.is_open() and pending.is_websocket()) {
          try this.connection_ready(slot, 0, now_ms);
        }
      }

      return std.AllocationResult.Ok;
    }

    // Accept a batch of pending connections on one listener.
    method accept_ready(index: i64, now_ms: i64) std.AllocationResult<void> {
      if (this.stopping or now_ms < this.accept_paused_until) {
        return std.AllocationResult.Ok;
      }
      var tls: bool = this.args.listeners[index].tls;
      for (var count: i32 = 0; count < ACCEPT_BATCH; count = count + 1) {
        var fd: i32 = this.args.listeners[index].accept();
        if (fd == 0) {
          return std.AllocationResult.Ok;
        }
        if (fd < 0) {
          var code: i32 = 0 - fd;
          if (code == EMFILE or code == ENFILE) {
            try this.log.log(LogLevel.Warn, "out of file descriptors; pausing accept");
            this.accept_paused_until = now_ms + this.args.config.timeouts.tick_ms;
          } else {
            try this.log.error("accept failed", try `errno ${code}`);
          }
          return std.AllocationResult.Ok;
        }
        if (this.live >= this.args.config.limits.max_connections_per_worker) {
          close_fd(fd);
          continue;
        }
        sun_serve.set_tcp_nodelay(fd);
        var slot: i64 = try this.take_slot();
        var opened: bool = try this.open_slot(slot, fd, tls, now_ms);
        if (not opened) {
          try this.free.push(slot);
          continue;
        }
        this.live = this.live + 1;
        // Data often arrives with the connection; try it right away.
        try this.connection_ready(slot, EPOLLIN, now_ms);
      }

      return std.AllocationResult.Ok;
    }

    /*
     * Attach an accepted socket to a slot and register it with epoll.
     * Returns false (with the socket closed) when that fails.
     */
    method open_slot(slot: i64, fd: i32, tls: bool, now_ms: i64) std.AllocationResult<bool> {
      var conn: ref Connection = this.conns[slot];
      if (not conn.open(fd, tls, this.args.tls, now_ms, this.args.config.timeouts, this.wake_fd)) {
        try this.log.log(LogLevel.Warn, "could not start TLS session");
        close_fd(fd);
        return std.AllocationResult.Ok(false);
      }
      match this.epoll.add(fd, conn.want(), _convert<u64>(slot)) {
        ServerResult.Ok => {},
        (e: const ref IError) => {
          try this.log.error_caught("failed to watch connection", e);
          try conn.close();
          return std.AllocationResult.Ok(false);
        }
      };
      conn.set_registered(conn.want());
      return std.AllocationResult.Ok(true);
    }

    // A free connection slot, growing the table when none is spare.
    method take_slot() std.AllocationResult<i64> {
      return std.AllocationResult.Ok(
        match this.free.pop() {
          Option.Some(slot) => slot,
          Option.None => try this.new_slot()
        }
      );
    }

    // Append a fresh connection to the table.
    method new_slot() std.AllocationResult<i64> {
      try this.conns.push(try Connection(this.alloc));
      return std.AllocationResult.Ok(this.conns.size() - 1);
    }

    // Drive one connection for a readiness event and update its interest.
    method connection_ready(slot: i64, mask: u32, now_ms: i64) std.AllocationResult<void> {
      var conn: ref Connection = this.conns[slot];
      if (not conn.is_open()) {
        return std.AllocationResult.Ok;
      }
      try conn.on_event(
        mask,
        this.args.handler,
        this.date,
        this.log,
        this.args.config,
        now_ms,
        this.stopping
      );
      if (not conn.is_open()) {
        try this.free.push(slot);
        this.live = this.live - 1;
        return std.AllocationResult.Ok;
      }
      if (conn.want() != conn.registered()) {
        match this.epoll.modify(conn.get_fd(), conn.want(), _convert<u64>(slot)) {
          ServerResult.Ok => {
            conn.set_registered(conn.want());
          },
          (e: const ref IError) => {
            try this.log.error_caught("failed to update connection interest", e);
            try conn.close();
            try this.free.push(slot);
            this.live = this.live - 1;
          }
        };
      }

      return std.AllocationResult.Ok;
    }

    // Close a live connection and free its slot.
    method drop_connection(slot: i64) std.AllocationResult<void> {
      var conn: ref Connection = this.conns[slot];
      if (conn.is_open()) {
        this.epoll.remove(conn.get_fd());
        try conn.close();
        try this.free.push(slot);
        this.live = this.live - 1;
      }

      return std.AllocationResult.Ok;
    }

    // Report whether the slot holds an open connection past its deadline.
    method slot_expired(slot: i64, now_ms: i64) bool {
      var conn: ref Connection = this.conns[slot];
      return conn.is_open() and conn.expired(now_ms);
    }

    // Report whether the slot holds an open connection idle between requests.
    method slot_idle(slot: i64) bool {
      var conn: ref Connection = this.conns[slot];
      return conn.is_open() and conn.is_idle();
    }

    // Close connections whose current state has taken too long.
    method sweep(now_ms: i64) std.AllocationResult<void> {
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        if (this.slot_expired(i, now_ms)) {
          try this.drop_connection(i);
        }
      }

      return std.AllocationResult.Ok;
    }

    /*
     * Notice a stop request: stop accepting, drop idle connections, and give
     * in-flight requests a grace period.
     */
    method check_stop(now_ms: i64) std.AllocationResult<void> {
      if (this.stopping) {
        return std.AllocationResult.Ok;
      }
      var stop_flag: i32 = this.args.stop.load();
      if (stop_flag == 0 and not shutdown_requested()) {
        return std.AllocationResult.Ok;
      }
      this.stopping = true;
      this.drain_deadline = now_ms + this.args.config.timeouts.drain_ms;
      for (var l: ref ListenerSocket in this.args.listeners) {
        this.epoll.remove(l.get_fd());
        l.close();
      }
      for (var conn: ref Connection in this.conns) {
        if (conn.is_open()) {
          try conn.begin_shutdown();
        }
      }
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        if (this.slot_idle(i)) {
          try this.drop_connection(i);
        }
      }

      return std.AllocationResult.Ok;
    }

    // Close every connection at the end of the drain period.
    method close_all() std.AllocationResult<void> {
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        try this.drop_connection(i);
      }

      return std.AllocationResult.Ok;
    }
  }

  /*
   * The thread entry point: build a worker and run it, reporting any failure
   * on stderr before returning an exit status.
   */
  public function run_worker<H>(args: WorkerArgs<H>) i32 {
    return match run_worker_result<H>(args) {
      AllocationResult.Ok(status) => status,
      _ => { _panic("allocation failed in server worker"); }
    };
  }

  /** Runs a worker and reports startup failures before the thread boundary handles allocation errors. */
  function run_worker_result<H>(args: WorkerArgs<H>) std.AllocationResult<i32> {
    match Worker<H>(args) {
      ServerResult.Ok(value) => {
        var w = value;
        return std.AllocationResult.Ok(try w.run());
      },
      (e: const ref IError) => {
        std.io.eprintln(
          try `error: worker failed to start: ${try e.message()}`
        );
        return AllocationResult.Ok(1);
      }
    };
  }
}
