/*
 * worker.sun - One thread's event loop
 *
 * Each worker owns an epoll instance, its own listening sockets, a table of
 * connections, and its own handler. Nothing here is shared with other workers
 * except the stop flag and WebSocket mailboxes.
 */

/*
 * Runs the server event loop for one worker thread.
 */
public module sun_serve {

  using std;
  using std.time;

  /*
   * Tokens at or above this value identify listeners; below it, connection
   * slots, except for the one token reserved for the wake descriptor.
   */
  const LISTENER_TOKEN_BASE: u64 = 0x100_0000_0000;
  const WORKER_WAKE_TOKEN: u64 = LISTENER_TOKEN_BASE - 1;

  /*
   * How many connections one readiness event on a listener may accept before
   * yielding to other work.
   */
  const ACCEPT_BATCH: i32 = 64;

  /*
   * Owns the concrete handler and resources for one worker thread.
   */
  public class WorkerArgs<H> {
    var id: i32;
    var config: Config;
    var handler: H;
    var listeners: Vec<ListenerSocket>;
    var stop: StopToken;
    var tls: TlsAcceptor;

    // Bundle the pieces for one worker.
    init(
      id: i32,
      config: Config,
      handler: H,
      listeners: Vec<ListenerSocket>,
      stop: StopToken,
      tls: TlsAcceptor
    ) {
      this.id = id;
      this.config = config;
      this.handler = handler;
      this.listeners = listeners;
      this.stop = stop;
      this.tls = tls;
    }
  }

  /*
   * Runs one event loop and owns its connections and listeners.
   */
  public class Worker<H> {
    var args: WorkerArgs<H>;
    var alloc: HeapAllocator;
    var epoll: Epoll;
    var wake_fd: i32;
    var conns: Vec<Connection>;
    var free: Vec<i64>;
    var live: i64 = 0;
    var log: Logger;
    var date: DateCache;
    var epoch: Instant = now();
    var stopping: bool = false;
    var drain_deadline: i64 = 0;
    var next_sweep: i64 = 0;
    var accept_paused_until: i64 = 0;

    // Set up the loop's resources. Listeners are registered in run().
    init(args: WorkerArgs<H>) throws {
      var alloc = make_heap_allocator();
      this.alloc = alloc.copy();
      this.log = Logger(alloc, args.config.log_level, args.id, args.config.access_log);
      this.date = DateCache(alloc);
      var layout: EpollLayout = probe_epoll_layout(alloc);
      this.epoll = Epoll(alloc, layout, 256);
      this.wake_fd = create_event_counter();
      if (this.wake_fd < 0) {
        throw Error(last_errno(), "eventfd failed");
      }
      this.conns = Vec<Connection>(alloc, 64);
      this.free = Vec<i64>(alloc, 64);
      this.args = args;
      return;
    }

    // Close the worker wake descriptor.
    deinit() {
      close_fd(this.wake_fd);
      this.wake_fd = 0;
    }

    // Milliseconds since the worker started.
    method now_ms() i64 {
      return this.epoch.elapsed().as_millis();
    }

    /*
     * Serve until the stop flag is raised and the connections have drained.
     * Returns the process exit status the worker would like.
     */
    public method run() i32 throws {
      try {
        this.epoll.add(this.wake_fd, EPOLLIN, WORKER_WAKE_TOKEN);
      } catch (e: std.Error) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.AllocationError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.InvalidArgumentError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.OverflowError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.IndexOutOfBoundsError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.NotFoundError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.EmptyError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.IOError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.ConversionError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.DivisionByZeroError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.ArithmeticError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.json.JsonError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.xml.XmlError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: std.ProtoDecodeError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      } catch (e: sun_serve.TlsError) {
        this.log.error_caught("failed to watch worker wake descriptor", e);
        return 1;
      }
      for (var i: i64 = 0; i < this.args.listeners.size(); i = i + 1) {
        try {
          this.epoll.add(
            this.args.listeners[i].get_fd(),
            EPOLLIN,
            LISTENER_TOKEN_BASE + _convert<u64>(i)
          );
        } catch (e: std.Error) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.AllocationError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.InvalidArgumentError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.OverflowError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.IndexOutOfBoundsError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.NotFoundError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.EmptyError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.IOError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.ConversionError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.DivisionByZeroError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.ArithmeticError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.json.JsonError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.xml.XmlError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: std.ProtoDecodeError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        } catch (e: sun_serve.TlsError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        }
      }
      var tick: i32 = _convert<i32>(this.args.config.timeouts.tick_ms);
      while (true) {
        var n: i64 = 0;
        try {
          var value = this.epoll.wait(tick);
          n = value;
        } catch (e: std.Error) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.AllocationError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.InvalidArgumentError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.OverflowError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.IndexOutOfBoundsError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.NotFoundError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.EmptyError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.IOError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.ConversionError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.DivisionByZeroError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.ArithmeticError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.json.JsonError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.xml.XmlError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: std.ProtoDecodeError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        } catch (e: sun_serve.TlsError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        }
        this.date.refresh();
        var now_ms: i64 = this.now_ms();
        for (var i: i64 = 0; i < n; i = i + 1) {
          var token: u64 = this.epoll.event_token(i);
          var mask: u32 = this.epoll.event_mask(i);
          if (token == WORKER_WAKE_TOKEN) {
            this.drain_wake();
            this.drive_websockets(now_ms);
          } else if (token >= LISTENER_TOKEN_BASE) {
            this.accept_ready(_convert<i64>(token - LISTENER_TOKEN_BASE), now_ms);
          } else {
            this.connection_ready(_convert<i64>(token), mask, now_ms);
          }
        }
        this.check_stop(now_ms);
        if (now_ms >= this.next_sweep) {
          this.sweep(now_ms);
          this.next_sweep = now_ms + this.args.config.timeouts.tick_ms;
        }
        if (this.stopping and (this.live == 0 or now_ms >= this.drain_deadline)) {
          this.close_all();
          return 0;
        }
      }
      return 0;
    }

    // Clear accumulated worker wake notifications.
    method drain_wake() void {
      var value: u64 = 0;
      while (read_event_counter(this.wake_fd, value) > 0) {}
    }

    // Drain asynchronous output for every WebSocket owned by this worker.
    method drive_websockets(now_ms: i64) void throws {
      for (var slot: i64 = 0; slot < this.conns.size(); slot = slot + 1) {
        var pending: ref Connection = this.conns[slot];
        if (pending.is_open() and pending.is_websocket()) {
          this.connection_ready(slot, 0, now_ms);
        }
      }

      return;
    }

    // Accept a batch of pending connections on one listener.
    method accept_ready(index: i64, now_ms: i64) void throws {
      if (this.stopping or now_ms < this.accept_paused_until) {
        return;
      }
      var tls: bool = this.args.listeners[index].tls;
      for (var count: i32 = 0; count < ACCEPT_BATCH; count = count + 1) {
        var fd: i32 = this.args.listeners[index].accept();
        if (fd == 0) {
          return;
        }
        if (fd < 0) {
          var code: i32 = 0 - fd;
          if (code == EMFILE or code == ENFILE) {
            this.log.log(LogLevel.Warn, "out of file descriptors; pausing accept");
            this.accept_paused_until = now_ms + this.args.config.timeouts.tick_ms;
          } else {
            this.log.error("accept failed", `errno ${code}`);
          }
          return;
        }
        if (this.live >= this.args.config.limits.max_connections_per_worker) {
          close_fd(fd);
          continue;
        }
        sun_serve.set_tcp_nodelay(fd);
        var slot: i64 = this.take_slot();
        var opened: bool = this.open_slot(slot, fd, tls, now_ms);
        if (not opened) {
          this.free.push(slot);
          continue;
        }
        this.live = this.live + 1;
        // Data often arrives with the connection; try it right away.
        this.connection_ready(slot, EPOLLIN, now_ms);
      }

      return;
    }

    /*
     * Attach an accepted socket to a slot and register it with epoll.
     * Returns false (with the socket closed) when that fails.
     */
    method open_slot(slot: i64, fd: i32, tls: bool, now_ms: i64) bool throws {
      var conn: ref Connection = this.conns[slot];
      if (not conn.open(fd, tls, this.args.tls, now_ms, this.args.config.timeouts, this.wake_fd)) {
        this.log.log(LogLevel.Warn, "could not start TLS session");
        close_fd(fd);
        return false;
      }
      try {
        this.epoll.add(fd, conn.want(), _convert<u64>(slot));
      } catch (e: std.Error) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.AllocationError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.InvalidArgumentError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.OverflowError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.IndexOutOfBoundsError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.NotFoundError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.EmptyError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.IOError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.ConversionError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.DivisionByZeroError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.ArithmeticError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.json.JsonError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.xml.XmlError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: std.ProtoDecodeError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      } catch (e: sun_serve.TlsError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      }
      conn.set_registered(conn.want());
      return true;
    }

    // A free connection slot, growing the table when none is spare.
    method take_slot() i64 throws {
      return match this.free.pop() {
        Option.Some(slot) => slot,
        Option.None => this.new_slot()
      };
    }

    // Append a fresh connection to the table.
    method new_slot() i64 throws {
      this.conns.push(Connection(this.alloc));
      return this.conns.size() - 1;
    }

    // Drive one connection for a readiness event and update its interest.
    method connection_ready(slot: i64, mask: u32, now_ms: i64) void throws {
      var conn: ref Connection = this.conns[slot];
      if (not conn.is_open()) {
        return;
      }
      conn.on_event(
        mask,
        this.args.handler,
        this.date,
        this.log,
        this.args.config,
        now_ms,
        this.stopping
      );
      if (not conn.is_open()) {
        this.free.push(slot);
        this.live = this.live - 1;
        return;
      }
      if (conn.want() != conn.registered()) {
        var operation_completed_2 = false;
        try {
          this.epoll.modify(conn.get_fd(), conn.want(), _convert<u64>(slot));
          operation_completed_2 = true;
          conn.set_registered(conn.want());
        } catch (e: std.Error) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.AllocationError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.InvalidArgumentError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.OverflowError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.IndexOutOfBoundsError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.NotFoundError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.EmptyError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.IOError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.ConversionError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.DivisionByZeroError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.ArithmeticError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.json.JsonError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.xml.XmlError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: std.ProtoDecodeError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        } catch (e: sun_serve.TlsError) {
          if (operation_completed_2) {
            throw;
          }
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        }
      }

      return;
    }

    // Close a live connection and free its slot.
    method drop_connection(slot: i64) void throws {
      var conn: ref Connection = this.conns[slot];
      if (conn.is_open()) {
        this.epoll.remove(conn.get_fd());
        conn.close();
        this.free.push(slot);
        this.live = this.live - 1;
      }

      return;
    }

    // Report whether the slot holds an open connection past its deadline.
    method slot_expired(slot: i64, now_ms: i64) bool {
      var conn: ref Connection = this.conns[slot];
      return conn.is_open() and conn.expired(now_ms);
    }

    // Report whether the slot holds an open connection idle between requests.
    method slot_idle(slot: i64) bool {
      var conn: ref Connection = this.conns[slot];
      return conn.is_open() and conn.is_idle();
    }

    // Close connections whose current state has taken too long.
    method sweep(now_ms: i64) void throws {
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        if (this.slot_expired(i, now_ms)) {
          this.drop_connection(i);
        }
      }

      return;
    }

    /*
     * Notice a stop request: stop accepting, drop idle connections, and give
     * in-flight requests a grace period.
     */
    method check_stop(now_ms: i64) void throws {
      if (this.stopping) {
        return;
      }
      var stop_flag: i32 = this.args.stop.load();
      if (stop_flag == 0 and not shutdown_requested()) {
        return;
      }
      this.stopping = true;
      this.drain_deadline = now_ms + this.args.config.timeouts.drain_ms;
      for (var l: ref ListenerSocket in this.args.listeners) {
        this.epoll.remove(l.get_fd());
        l.close();
      }
      for (var conn: ref Connection in this.conns) {
        if (conn.is_open()) {
          conn.begin_shutdown();
        }
      }
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        if (this.slot_idle(i)) {
          this.drop_connection(i);
        }
      }

      return;
    }

    // Close every connection at the end of the drain period.
    method close_all() void throws {
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        this.drop_connection(i);
      }

      return;
    }
  }

  /*
   * The thread entry point: build a worker and run it, reporting any failure
   * on stderr before returning an exit status.
   */
  public function run_worker<H>(args: WorkerArgs<H>) i32 {
    try {
      return run_worker_result<H>(args);
    } catch (error: Error) {
      try {
        std.io.eprintln(error.message());
      } catch {}
      return 1;
    } catch (error: TlsError) {
      try {
        std.io.eprintln(error.message());
      } catch {}
      return 1;
    } catch {
      std.io.eprintln("Server worker failed");
      return 1;
    }
  }

  /** Runs a worker and reports startup failures before the thread boundary handles allocation errors. */
  function run_worker_result<H>(args: WorkerArgs<H>) i32 throws {
    var worker = Worker<H>(args);
    return worker.run();
  }
}
