// worker.sun - One thread's event loop
//
// Each worker owns an epoll instance, its own listening sockets, a table of
// connections, and its own handler. Nothing here is shared with other workers
// except the stop flag, so the loop never takes a lock.

public module sun_serve {
  using std;
  using std.time;

  // Tokens at or above this value identify listeners; below it, connection
  // slots.
  const LISTENER_TOKEN_BASE: u64 = 1099511627776;

  // How many connections one readiness event on a listener may accept before
  // yielding to other work.
  const ACCEPT_BATCH: i32 = 64;

  // Everything a worker thread is given when it starts.
  public class WorkerArgs {
    var id: i32;
    var config: Config;
    var handler: IHandler;
    var listeners: Vec<ListenerSocket>;
    var stop: raw_ptr<i32>;
    var tls: TlsAcceptor;

    // Bundle the pieces for one worker.
    init(id: i32, config: Config, handler: IHandler, listeners: Vec<ListenerSocket>, stop: raw_ptr<i32>, tls: TlsAcceptor) {
      this.id = id;
      this.config = config;
      this.handler = handler;
      this.listeners = listeners;
      this.stop = stop;
      this.tls = tls;
    }
  }

  public class Worker {
    var args: WorkerArgs;
    var alloc: HeapAllocator;
    var epoll: Epoll;
    var conns: Vec<Connection>;
    var free: Vec<i64>;
    var live: i64;
    var log: Logger;
    var date: DateCache;
    var epoch: Instant;
    var stopping: bool;
    var drain_deadline: i64;
    var next_sweep: i64;
    var accept_paused_until: i64;

    // Set up the loop's resources. Listeners are registered in run().
    init(args: WorkerArgs) throws IError {
      var alloc = make_heap_allocator();
      this.alloc = alloc.copy();
      this.log = Logger(alloc, args.config.log_level, args.id, args.config.access_log);
      this.date = DateCache(alloc);
      this.epoch = now();
      var layout: EpollLayout = probe_epoll_layout(alloc);
      this.epoll = Epoll(alloc, layout, 256);
      this.conns = Vec<Connection>(alloc, 64);
      this.free = Vec<i64>(alloc, 64);
      this.live = 0;
      this.stopping = false;
      this.drain_deadline = 0;
      this.next_sweep = 0;
      this.accept_paused_until = 0;
      this.args = args;
    }

    // Milliseconds since the worker started.
    method now_ms() i64 {
      return this.epoch.elapsed().as_millis();
    }

    // Serve until the stop flag is raised and the connections have drained.
    // Returns the process exit status the worker would like.
    public method run() i32 {
      for (var i: i64 = 0; i < this.args.listeners.size(); i = i + 1) {
        var l: ref ListenerSocket = this.args.listeners.get_unchecked(i);
        try {
          this.epoll.add(l.get_fd(), EPOLLIN, LISTENER_TOKEN_BASE + _convert<u64>(i));
        } catch (e: IError) {
          this.log.error_caught("failed to watch listener", e);
          return 1;
        }
      }
      var tick: i32 = _convert<i32>(this.args.config.timeouts.tick_ms);
      while (true) {
        var n: i64 = 0;
        try {
          n = this.epoll.wait(tick);
        } catch (e: IError) {
          this.log.error_caught("epoll_wait failed", e);
          return 1;
        }
        this.date.refresh();
        var now_ms: i64 = this.now_ms();
        for (var i: i64 = 0; i < n; i = i + 1) {
          var token: u64 = this.epoll.event_token(i);
          var mask: u32 = this.epoll.event_mask(i);
          if (token >= LISTENER_TOKEN_BASE) {
            this.accept_ready(_convert<i64>(token - LISTENER_TOKEN_BASE), now_ms);
          } else {
            this.connection_ready(_convert<i64>(token), mask, now_ms);
          }
        }
        for (var slot: i64 = 0; slot < this.conns.size(); slot = slot + 1) {
          var pending: ref Connection = this.conns.get_unchecked(slot);
          if (pending.is_open() and pending.is_websocket()) {
            this.connection_ready(slot, 0, now_ms);
          }
        }
        this.check_stop(now_ms);
        if (now_ms >= this.next_sweep) {
          this.sweep(now_ms);
          this.next_sweep = now_ms + this.args.config.timeouts.tick_ms;
        }
        if (this.stopping and (this.live == 0 or now_ms >= this.drain_deadline)) {
          this.close_all();
          return 0;
        }
      }
      return 0;
    }

    // Accept a batch of pending connections on one listener.
    method accept_ready(index: i64, now_ms: i64) void {
      if (this.stopping or now_ms < this.accept_paused_until) {
        return;
      }
      for (var count: i32 = 0; count < ACCEPT_BATCH; count = count + 1) {
        var fd: i32 = 0;
        var tls: bool = false;
        if (true) {
          var listener: ref ListenerSocket = this.args.listeners.get_unchecked(index);
          fd = listener.accept();
          tls = listener.tls;
        }
        if (fd == 0) {
          return;
        }
        if (fd < 0) {
          var code: i32 = 0 - fd;
          if (code == EMFILE or code == ENFILE) {
            this.log.log(LogLevel.Warn, "out of file descriptors; pausing accept");
            this.accept_paused_until = now_ms + this.args.config.timeouts.tick_ms;
          } else {
            var detail = String(this.alloc, "errno ");
            detail.append(code);
            this.log.error("accept failed", detail);
          }
          return;
        }
        if (this.live >= this.args.config.limits.max_connections_per_worker) {
          close_fd(fd);
          continue;
        }
        set_tcp_nodelay(fd);
        var slot: i64 = this.take_slot();
        var opened: bool = this.open_slot(slot, fd, tls, now_ms);
        if (not opened) {
          this.free.push(slot);
          continue;
        }
        this.live = this.live + 1;
        // Data often arrives with the connection; try it right away.
        this.connection_ready(slot, EPOLLIN, now_ms);
      }
    }

    // Attach an accepted socket to a slot and register it with epoll.
    // Returns false (with the socket closed) when that fails.
    method open_slot(slot: i64, fd: i32, tls: bool, now_ms: i64) bool {
      var conn: ref Connection = this.conns.get_unchecked(slot);
      if (not conn.open(fd, tls, this.args.tls, now_ms, this.args.config.timeouts)) {
        this.log.log(LogLevel.Warn, "could not start TLS session");
        close_fd(fd);
        return false;
      }
      try {
        this.epoll.add(fd, conn.want(), _convert<u64>(slot));
      } catch (e: IError) {
        this.log.error_caught("failed to watch connection", e);
        conn.close();
        return false;
      }
      conn.set_registered(conn.want());
      return true;
    }

    // A free connection slot, growing the table when none is spare.
    method take_slot() i64 {
      var reused: Option<i64> = this.free.pop();
      return match reused {
        Option.Some(slot) => slot,
        Option.None => this.new_slot()
      };
    }

    // Append a fresh connection to the table.
    method new_slot() i64 {
      this.conns.push(Connection(this.alloc));
      return this.conns.size() - 1;
    }

    // Drive one connection for a readiness event and update its interest.
    method connection_ready(slot: i64, mask: u32, now_ms: i64) void {
      var conn: ref Connection = this.conns.get_unchecked(slot);
      if (not conn.is_open()) {
        return;
      }
      conn.on_event(mask, this.args.handler, this.date, this.log, this.args.config, now_ms, this.stopping);
      if (not conn.is_open()) {
        this.free.push(slot);
        this.live = this.live - 1;
        return;
      }
      if (conn.want() != conn.registered()) {
        try {
          this.epoll.modify(conn.get_fd(), conn.want(), _convert<u64>(slot));
          conn.set_registered(conn.want());
        } catch (e: IError) {
          this.log.error_caught("failed to update connection interest", e);
          conn.close();
          this.free.push(slot);
          this.live = this.live - 1;
        }
      }
    }

    // Close a live connection and free its slot.
    method drop_connection(slot: i64) void {
      var conn: ref Connection = this.conns.get_unchecked(slot);
      if (conn.is_open()) {
        this.epoll.remove(conn.get_fd());
        conn.close();
        this.free.push(slot);
        this.live = this.live - 1;
      }
    }

    // Report whether the slot holds an open connection past its deadline.
    method slot_expired(slot: i64, now_ms: i64) bool {
      var conn: ref Connection = this.conns.get_unchecked(slot);
      return conn.is_open() and conn.expired(now_ms);
    }

    // Report whether the slot holds an open connection idle between requests.
    method slot_idle(slot: i64) bool {
      var conn: ref Connection = this.conns.get_unchecked(slot);
      return conn.is_open() and conn.is_idle();
    }

    // Close connections whose current state has taken too long.
    method sweep(now_ms: i64) void {
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        if (this.slot_expired(i, now_ms)) {
          this.drop_connection(i);
        }
      }
    }

    // Notice a stop request: stop accepting, drop idle connections, and give
    // in-flight requests a grace period.
    method check_stop(now_ms: i64) void {
      if (this.stopping) {
        return;
      }
      var stop_flag: i32 = unsafe { _atomic_load_i32(this.args.stop); };
      if (stop_flag == 0 and not shutdown_requested()) {
        return;
      }
      this.stopping = true;
      this.drain_deadline = now_ms + this.args.config.timeouts.drain_ms;
      for (var i: i64 = 0; i < this.args.listeners.size(); i = i + 1) {
        var l: ref ListenerSocket = this.args.listeners.get_unchecked(i);
        this.epoll.remove(l.get_fd());
        l.close();
      }
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        var conn: ref Connection = this.conns.get_unchecked(i);
        if (conn.is_open()) {
          conn.begin_shutdown();
        }
      }
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        if (this.slot_idle(i)) {
          this.drop_connection(i);
        }
      }
    }

    // Close every connection at the end of the drain period.
    method close_all() void {
      for (var i: i64 = 0; i < this.conns.size(); i = i + 1) {
        this.drop_connection(i);
      }
    }
  }

  // The thread entry point: build a worker and run it, reporting any failure
  // on stderr instead of throwing across the thread boundary.
  public function run_worker(args: WorkerArgs) i32 {
    try {
      var w = Worker(args);
      return w.run();
    } catch (e: IError) {
      var msg: String = e.message();
      eprint("error: worker failed to start: ");
      eprintln(msg);
      return 1;
    }
  }
}
