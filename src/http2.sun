  // Decode one RFC HPACK Huffman string.
  function hpack_huffman_decode(alloc: const ref HeapAllocator, data: const ref ByteBuffer, off: i64, len: i64) Option<String> {
    var out = String(alloc, "");
    var bits: i32 = 0;
    var acc: u64 = 0;
    for (var i: i64 = 0; i < len; i = i + 1) {
      acc = (acc << 8) | _convert<u64>(data.byte_at(off + i));
      bits = bits + 8;
      while (true) {
        var found: i32 = -1;
        var used: i32 = 0;
        for (var symbol: i32 = 0; symbol <= 256; symbol = symbol + 1) {
          var width: i32 = hpack_huffman_width(symbol);
          if (width <= bits and (acc >> (bits - width)) == hpack_huffman_code(symbol)) {
            found = symbol;
            used = width;
            break;
          }
        }
        if (found < 0) {
          break;
        }
        if (found == 256) {
          return Option.None;
        }
        out.append_char(_convert<u8>(found));
        bits = bits - used;
        if (bits == 0) {
          acc = 0;
        } else {
          acc = acc & ((_convert<u64>(1) << bits) - 1);
        }
      }
    }
    if (bits > 7) {
      return Option.None;
    }
    if (bits > 0 and acc != ((_convert<u64>(1) << bits) - 1)) {
      return Option.None;
    }
    return Option.Some(out);
  }

  // Decode an HPACK string and advance pos.
  function hpack_string(alloc: const ref HeapAllocator, data: const ref ByteBuffer, len: i64, pos: ref i64) Option<String> {
    if (pos >= len) {
      return Option.None;
    }
    var huffman: bool = (data.byte_at(pos) & 0x80) != 0;
    var n: i64 = hpack_int(data, len, pos, 7);
    if (n < 0 or pos + n > len) {
      return Option.None;
    }
    if (huffman) {
      var decoded = hpack_huffman_decode(alloc, data, pos, n);
      pos = pos + n;
      return decoded;
    }
    var out: String = data.range_text(alloc, pos, n);
    pos = pos + n;
    return Option.Some(out);
  }

  // Decode one HPACK block. Dynamic references and Huffman strings are rejected.
  function hpack_decode(alloc: const ref HeapAllocator, data: const ref ByteBuffer, len: i64, decoder: ref HpackDecoder, out: ref Vec<H2Header>) bool {
    var pos: i64 = 0;
    while (pos < len) {
      var first: u8 = data.byte_at(pos);
      if ((first & 0xe0) == 0x20) {
        var size: i64 = hpack_int(data, len, pos, 5);
        if (not decoder.resize(size)) {
          return false;
        }
        continue;
      }
      var indexed: bool = (first & 0x80) != 0;
      var incremental: bool = (first & 0x40) != 0;
      var prefix: i32 = 4;
      if (indexed) {
        prefix = 7;
      } else if (incremental) {
        prefix = 6;
      }
      var index: i64 = hpack_int(data, len, pos, prefix);
      if (index < 0) {
        return false;
      }
      var name = String(alloc, "");
      if (index == 0) {
        var decoded_name: Option<String> = hpack_string(alloc, data, len, pos);
        match decoded_name {
          Option.Some(v) => {
            name.append(v);
          },
          Option.None => {
            return false;
          }
        };
      } else if (index <= HPACK_STATIC_ENTRIES) {
        name.append(hpack_static_name(index));
      }
      var value = String(alloc, "");
      if (index > HPACK_STATIC_ENTRIES and not decoder.lookup(index, name, value)) {
        return false;
      }
      if (indexed) {
        if (index <= HPACK_STATIC_ENTRIES) {
          value.append(hpack_static_value(index));
        }
      } else {
        var decoded_value: Option<String> = hpack_string(alloc, data, len, pos);
        match decoded_value {
          Option.Some(v) => {
            value.append(v);
          },
          Option.None => {
            return false;
          }
        };
      }
      if (incremental) {
        decoder.add(name, value);
      }
      out.push(H2Header(name, value));
    }
    return true;
  }

  // Encode an HPACK integer with the first-byte prefix already prepared.
  function hpack_append_int(out: ref ByteBuffer, value: i64, prefix: i32, first: u8) void {
    var mask: i64 = _convert<i64>((1 << prefix) - 1);
    if (value < mask) {
      out.append_byte(first | _convert<u8>(value));
      return;
    }
    out.append_byte(first | _convert<u8>(mask));
    var left: i64 = value - mask;
    while (left >= 128) {
      out.append_byte(_convert<u8>(left % 128) | 0x80);
      left = left / 128;
    }
    out.append_byte(_convert<u8>(left));
  }

  // Encode a literal HPACK string without Huffman coding.
  function hpack_append_string(out: ref ByteBuffer, value: const ref String) void {
    hpack_append_int(out, value.length(), 7, 0);
    out.append_string(value);
  }

  // Encode one literal response header without indexing.
  function hpack_header(out: ref ByteBuffer, name: const ref String, value: const ref String) void {
    hpack_append_int(out, 0, 4, 0);
    hpack_append_string(out, name);
    hpack_append_string(out, value);
  }

  // Encode one literal response header given as literals.
  function hpack_header_literal(out: ref ByteBuffer, name: static_ptr<u8>, value: static_ptr<u8>) void {
    hpack_header(out, String(name), String(value));
  }

  // Encode a response status using the static table when possible.
  function hpack_status(out: ref ByteBuffer, status: i32, alloc: const ref HeapAllocator) void {
    var index: i64 = match status {
      200 => 8,
      204 => 9,
      206 => 10,
      304 => 11,
      400 => 12,
      404 => 13,
      500 => 14,
      _ => 0
    };
    if (index > 0) {
      hpack_append_int(out, index, 7, 0x80);
      return;
    }
    hpack_append_int(out, 8, 4, 0);
    var text = String(alloc, "");
    text.append(status);
    hpack_append_string(out, text);
  }
}
