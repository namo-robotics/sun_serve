// http2.sun - HTTP/2 framing and the HPACK wire representation

/*
 * Implements HTTP/2 framing and header compression.
 */
public module sun_serve {
  using std;

  // The frame types of RFC 9113, stored as they appear on the wire.
  public enum H2FrameKind u8 { Data = 0, Headers = 1, Priority = 2, RstStream = 3, Settings = 4, PushPromise = 5, Ping = 6, Goaway = 7, WindowUpdate = 8, Continuation = 9 }

  // The stream error codes sun_serve sends in RST_STREAM frames.
  const H2_ERROR_PROTOCOL: u32 = 0x1;
  const H2_ERROR_STREAM_CLOSED: u32 = 0x5;
  const H2_ERROR_REFUSED_STREAM: u32 = 0x7;
  const H2_ERROR_ENHANCE_YOUR_CALM: u32 = 0xb;

  // The frame flags used by this implementation.
  const H2_END_STREAM: u8 = 0x1;
  const H2_ACK: u8 = 0x1;
  const H2_END_HEADERS: u8 = 0x4;
  const H2_PADDED: u8 = 0x8;
  const H2_PRIORITY_FLAG: u8 = 0x20;

  // The SETTINGS identifiers this implementation reads and writes.
  const H2_SETTINGS_ENABLE_PUSH: i32 = 0x2;
  const H2_SETTINGS_MAX_CONCURRENT_STREAMS: i32 = 0x3;
  const H2_SETTINGS_INITIAL_WINDOW_SIZE: i32 = 0x4;
  const H2_SETTINGS_MAX_FRAME_SIZE: i32 = 0x5;
  const H2_SETTINGS_ENABLE_CONNECT_PROTOCOL: i32 = 0x8;

  // The protocol's fixed sizes and limits.
  const H2_FRAME_HEADER_LEN: i64 = 9;
  const H2_DEFAULT_FRAME_SIZE: i64 = 16384;
  const H2_MAX_FRAME_SIZE: i64 = 0xff_ffff;
  const H2_DEFAULT_WINDOW: i64 = 65535;
  const H2_MAX_WINDOW: i64 = 0x7fff_ffff;
  const H2_STREAM_ID_MASK: u32 = 0x7fff_ffff;
  const H2_PREFACE: static_ptr<u8> = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";
  const HPACK_DEFAULT_TABLE_SIZE: i64 = 4096;
  // Bytes HPACK charges per dynamic-table entry on top of its name and value.
  const HPACK_ENTRY_OVERHEAD: i64 = 32;
  // The number of entries in the HPACK static table.
  const HPACK_STATIC_ENTRIES: i64 = 61;

  // One decoded HTTP/2 header field.
  public class H2Header {
    // The decoded header name.
    public var name: String;
    // The decoded header value.
    public var value: String;

    // Copy this header into another allocator.
    public const method clone(alloc: const ref HeapAllocator) H2Header {
      return H2Header(this.name.clone(alloc), this.value.clone(alloc));
    }

    // Own a decoded name and value.
    init(name: String, value: String) {
      this.name = name;
      this.value = value;
    }
  }

  // Buffered request state for one active HTTP/2 stream.
  class H2RequestStream {
    var active: bool = false;
    var id: u32 = 0;
    var headers: Vec<H2Header>;
    var body: ByteBuffer;
    var alloc: HeapAllocator;

    // Build an unused stream slot.
    init(allocator: const ref HeapAllocator) {
      this.alloc = allocator.copy();
      this.headers = Vec<H2Header>(allocator, 16);
      this.body = ByteBuffer(allocator, 256);
    }

    // Populate a slot from a decoded header block.
    method begin(id: u32, source: const ref Vec<H2Header>) void {
      this.active = true;
      this.id = id;
      this.headers.clear();
      this.body.clear();
      for (var i: i64 = 0; i < source.size(); i = i + 1) {
        this.headers.push(source[i].clone(this.alloc));
      }
    }

    // Release buffered state for reuse.
    method reset() void {
      this.active = false;
      this.id = 0;
      this.headers.clear();
      this.body.clear();
    }
  }

  // Flow-controlled response data for one HTTP/2 stream.
  class H2ResponseStream {
    var active: bool = false;
    var id: u32 = 0;
    var window: i64 = 0;
    var data: ByteBuffer;

    // Build an unused response slot.
    init(allocator: const ref HeapAllocator) {
      this.data = ByteBuffer(allocator, 256);
    }

    // Start buffering response data for a stream.
    method begin(id: u32, window: i64) void {
      this.active = true;
      this.id = id;
      this.window = window;
      this.data.clear();
    }

    // Release the response slot for reuse.
    method reset() void {
      this.active = false;
      this.id = 0;
      this.window = 0;
      this.data.clear();
    }
  }

  // The HPACK dynamic table for one connection.
  class HpackDecoder {
    var entries: Vec<H2Header>;
    var bytes: i64 = 0;
    var maximum: i64 = HPACK_DEFAULT_TABLE_SIZE;
    var alloc: HeapAllocator;

    // Start with the RFC default dynamic-table limit.
    init(alloc: const ref HeapAllocator) {
      this.alloc = alloc.copy();
      this.entries = Vec<H2Header>(alloc, 16);
    }

    // Empty the dynamic table for a new connection.
    method reset() void {
      this.entries.clear();
      this.bytes = 0;
      this.maximum = HPACK_DEFAULT_TABLE_SIZE;
    }

    // Apply a peer table-size update within the configured maximum.
    method resize(size: i64) bool {
      if (size < 0 or size > HPACK_DEFAULT_TABLE_SIZE) {
        return false;
      }
      this.maximum = size;
      this.evict();
      return true;
    }

    // Resolve a dynamic index into owned strings.
    method lookup(index: i64, name: ref String, value: ref String) bool {
      var at: i64 = this.entries.size() - 1 - (index - HPACK_STATIC_ENTRIES - 1);
      if (at < 0 or at >= this.entries.size()) {
        return false;
      }
      var field: ref H2Header = this.entries[at];
      name.append(field.name);
      value.append(field.value);
      return true;
    }

    // Add an entry after older entries; lookup indexes from the end.
    method add(name: const ref String, value: const ref String) void {
      var size: i64 = name.length() + value.length() + HPACK_ENTRY_OVERHEAD;
      if (size > this.maximum) {
        this.entries.clear();
        this.bytes = 0;
        return;
      }
      this.entries.push(H2Header(name.clone(this.alloc), value.clone(this.alloc)));
      this.bytes = this.bytes + size;
      this.evict();
    }

    // Remove oldest entries until the table fits.
    method evict() void {
      while (this.bytes > this.maximum and this.entries.size() > 0) {
        try {
          var oldest: H2Header = this.entries.remove(0);
          this.bytes = this.bytes - oldest.name.length() - oldest.value.length() - HPACK_ENTRY_OVERHEAD;
        } catch (e: ref IError) {
          // Unreachable: the table was just checked to be non-empty.
          return;
        }
      }
    }
  }

  /*
   * Connection-level HTTP/2 state: the peer's settings, HPACK decoding, the
   * header block being assembled, and the request and response stream tables.
   */
  class H2ConnectionState {
    // The decoded header fields of the request being dispatched.
    var headers: Vec<H2Header>;
    var hpack: HpackDecoder;
    var stream: u32 = 0;  // the stream whose request is being handled
    var preface: bool = false;
    var headers_ready: bool = false;
    var header_block: ByteBuffer;
    var continuation_stream: u32 = 0;
    var header_end_stream: bool = false;
    var streams: Vec<H2RequestStream>;
    var open_streams: i64 = 0;
    var buffered_bytes: i64 = 0;
    var last_client_stream: u32 = 0;
    var peer_frame_size: i64 = H2_DEFAULT_FRAME_SIZE;
    var peer_initial_window: i64 = H2_DEFAULT_WINDOW;
    var send_window: i64 = H2_DEFAULT_WINDOW;
    var responses: Vec<H2ResponseStream>;
    var enable_connect: bool = false;
    var upgrading: bool = false;  // an h2c upgrade response is being written

    // Allocate the tables; reset() prepares them for a connection.
    init(alloc: const ref HeapAllocator) {
      this.headers = Vec<H2Header>(alloc, 16);
      this.hpack = HpackDecoder(alloc);
      this.header_block = ByteBuffer(alloc, 512);
      this.streams = Vec<H2RequestStream>(alloc, 16);
      this.responses = Vec<H2ResponseStream>(alloc, 16);
    }

    // Return to the initial protocol state, keeping the allocations.
    method reset() void {
      this.headers.clear();
      this.hpack.reset();
      this.stream = 0;
      this.preface = false;
      this.headers_ready = false;
      this.header_block.clear();
      this.continuation_stream = 0;
      this.header_end_stream = false;
      for (var stream: ref H2RequestStream in this.streams) {
        stream.reset();
      }
      this.open_streams = 0;
      this.buffered_bytes = 0;
      this.last_client_stream = 0;
      this.peer_frame_size = H2_DEFAULT_FRAME_SIZE;
      this.peer_initial_window = H2_DEFAULT_WINDOW;
      this.send_window = H2_DEFAULT_WINDOW;
      for (var response: ref H2ResponseStream in this.responses) {
        response.reset();
      }
      this.enable_connect = false;
      this.upgrading = false;
    }
  }

  // A WebSocket session tunneled over one HTTP/2 stream with extended CONNECT.
  class H2WebSocketTunnel {
    var stream: u32 = 0;  // zero while no tunnel is open
    var inbound: ByteBuffer;  // WebSocket frames received as DATA
    var outbound: ByteBuffer;  // WebSocket frames waiting for send window
    var send_window: i64 = 0;
    var end_pending: bool = false;  // END_STREAM must follow the queued frames

    // Allocate the frame buffers.
    init(alloc: const ref HeapAllocator) {
      this.inbound = ByteBuffer(alloc, 256);
      this.outbound = ByteBuffer(alloc, 256);
    }

    // Forget any tunnel, keeping the allocations.
    method reset() void {
      this.stream = 0;
      this.inbound.clear();
      this.outbound.clear();
      this.send_window = 0;
      this.end_pending = false;
    }
  }

  // Read an unsigned big-endian HTTP/2 integer.
  function h2_u32(data: const ref ByteBuffer, off: i64) u32 {
    return (_convert<u32>(data.byte_at(off)) << 24) | (_convert<u32>(data.byte_at(off + 1)) << 16) | (_convert<u32>(data.byte_at(off + 2)) << 8) | _convert<u32>(data.byte_at(off + 3));
  }

  // Append an unsigned big-endian HTTP/2 integer.
  function h2_append_u32(out: ref ByteBuffer, value: u32) void {
    out.append_byte(_convert<u8>((value >> 24) & 0xff));
    out.append_byte(_convert<u8>((value >> 16) & 0xff));
    out.append_byte(_convert<u8>((value >> 8) & 0xff));
    out.append_byte(_convert<u8>(value & 0xff));
  }

  // Validate HTTP/2 request-header syntax and decoded limits.
  function h2_valid_request_headers(headers: const ref Vec<H2Header>, limits: const ref Limits) bool {
    if (headers.size() > limits.max_headers) {
      return false;
    }
    var regular_seen: bool = false;
    var method_seen: bool = false;
    var path_seen: bool = false;
    var scheme_seen: bool = false;
    var authority_seen: bool = false;
    var protocol_seen: bool = false;
    var decoded_bytes: i64 = 0;
    for (var i: i64 = 0; i < headers.size(); i = i + 1) {
      var field: const ref H2Header = headers[i];
      if (field.name.is_empty()) {
        return false;
      }
      decoded_bytes = decoded_bytes + field.name.length() + field.value.length() + HPACK_ENTRY_OVERHEAD;
      if (decoded_bytes > limits.max_header_bytes) {
        return false;
      }
      for (var j: i64 = 0; j < field.name.length(); j = j + 1) {
        var c: u8 = string_byte(field.name, j);
        if (c >= b'A' and c <= b'Z') {
          return false;
        }
      }
      if (field.name.starts_with(":")) {
        if (regular_seen) {
          return false;
        }
        if (field.name.equals_literal(":method") and not method_seen) {
          method_seen = true;
        } else if (field.name.equals_literal(":path") and not path_seen) {
          path_seen = true;
        } else if (field.name.equals_literal(":scheme") and not scheme_seen) {
          scheme_seen = true;
        } else if (field.name.equals_literal(":authority") and not authority_seen) {
          authority_seen = true;
        } else if (field.name.equals_literal(":protocol") and not protocol_seen) {
          protocol_seen = true;
        } else {
          return false;
        }
      } else {
        regular_seen = true;
        if (field.name.equals_literal("connection") or field.name.equals_literal("proxy-connection") or field.name.equals_literal("keep-alive") or field.name.equals_literal("transfer-encoding") or field.name.equals_literal("upgrade")) {
          return false;
        }
        if (field.name.equals_literal("te") and not field.value.equals_literal("trailers")) {
          return false;
        }
      }
    }
    if (not method_seen or not path_seen) {
      return false;
    }
    if (protocol_seen and (not scheme_seen or not authority_seen)) {
      return false;
    }
    return true;
  }

  // Decode an unpadded base64url HTTP2-Settings header value.
  function h2_decode_settings_header(value: const ref String, out: ref ByteBuffer) bool {
    var bits: u32 = 0;
    var bit_count: i32 = 0;
    for (var i: i64 = 0; i < value.length(); i = i + 1) {
      var c: u8 = string_byte(value, i);
      var digit: i32 = -1;
      if (c >= b'A' and c <= b'Z') {
        digit = _convert<i32>(c - b'A');
      } else if (c >= b'a' and c <= b'z') {
        digit = _convert<i32>(c - b'a') + 26;
      } else if (c >= b'0' and c <= b'9') {
        digit = _convert<i32>(c - b'0') + 52;
      } else if (c == b'-') {
        digit = 62;
      } else if (c == b'_') {
        digit = 63;
      } else {
        return false;
      }
      bits = (bits << 6) | _convert<u32>(digit);
      bit_count = bit_count + 6;
      if (bit_count >= 8) {
        bit_count = bit_count - 8;
        out.append_byte(_convert<u8>((bits >> bit_count) & 255));
      }
    }
    if (bit_count >= 6 or (bit_count > 0 and (bits & ((1 << bit_count) - 1)) != 0)) {
      return false;
    }
    return true;
  }

  // Append an HTTP/2 frame header.
  function h2_frame(out: ref ByteBuffer, len: i64, kind: H2FrameKind, flags: u8, stream: u32) void {
    out.append_byte(_convert<u8>((len >> 16) & 0xff));
    out.append_byte(_convert<u8>((len >> 8) & 0xff));
    out.append_byte(_convert<u8>(len & 0xff));
    out.append_byte(_convert<u8>(kind));
    out.append_byte(flags);
    h2_append_u32(out, stream & H2_STREAM_ID_MASK);
  }

  // The payload length declared by a frame header at off.
  function h2_frame_len(data: const ref ByteBuffer, off: i64) i64 {
    return (_convert<i64>(data.byte_at(off)) << 16) | (_convert<i64>(data.byte_at(off + 1)) << 8) | _convert<i64>(data.byte_at(off + 2));
  }

  // The frame type declared by a frame header at off; unknown types are None.
  function h2_frame_kind(data: const ref ByteBuffer, off: i64) Option<H2FrameKind> {
    return _enum_from_int<H2FrameKind>(data.byte_at(off + 3));
  }

  // Append a settings frame advertising the server limits.
  function h2_append_settings(out: ref ByteBuffer, max_concurrent_streams: i64) void {
    h2_frame(out, 12, H2FrameKind.Settings, 0, 0);
    h2_append_setting(out, H2_SETTINGS_MAX_CONCURRENT_STREAMS, _convert<u32>(max_concurrent_streams));
    h2_append_setting(out, H2_SETTINGS_ENABLE_CONNECT_PROTOCOL, 1);
  }

  // Append one identifier and value pair of a SETTINGS payload.
  function h2_append_setting(out: ref ByteBuffer, identifier: i32, value: u32) void {
    out.append_byte(_convert<u8>((identifier >> 8) & 0xff));
    out.append_byte(_convert<u8>(identifier & 0xff));
    h2_append_u32(out, value);
  }

  // Read the identifier of a SETTINGS pair at off.
  function h2_setting_id(data: const ref ByteBuffer, off: i64) i32 {
    return _convert<i32>(data.byte_at(off)) * 256 + _convert<i32>(data.byte_at(off + 1));
  }

  // Decode an HPACK variable-length integer and advance pos.
  function hpack_int(data: const ref ByteBuffer, len: i64, pos: ref i64, prefix: i32) i64 {
    if (pos >= len) {
      return -1;
    }
    var mask: i32 = (1 << prefix) - 1;
    var first: i32 = _convert<i32>(data.byte_at(pos));
    pos = pos + 1;
    var value: i64 = _convert<i64>(first & mask);
    if (value < _convert<i64>(mask)) {
      return value;
    }
    var shift: i32 = 0;
    while (pos < len and shift <= 56) {
      var b: i32 = _convert<i32>(data.byte_at(pos));
      pos = pos + 1;
      value = value + (_convert<i64>(b & 127) << shift);
      if ((b & 128) == 0) {
        return value;
      }
      shift = shift + 7;
    }
    return -1;
  }

  // Return the HPACK static-table name for an index.
  function hpack_static_name(index: i64) static_ptr<u8> {
    return match index {
      1 => ":authority",
      2 => ":method",
      3 => ":method",
      4 => ":path",
      5 => ":path",
      6 => ":scheme",
      7 => ":scheme",
      8 => ":status",
      9 => ":status",
      10 => ":status",
      11 => ":status",
      12 => ":status",
      13 => ":status",
      14 => ":status",
      15 => "accept-charset",
      16 => "accept-encoding",
      17 => "accept-language",
      18 => "accept-ranges",
      19 => "accept",
      20 => "access-control-allow-origin",
      21 => "age",
      22 => "allow",
      23 => "authorization",
      24 => "cache-control",
      25 => "content-disposition",
      26 => "content-encoding",
      27 => "content-language",
      28 => "content-length",
      29 => "content-location",
      30 => "content-range",
      31 => "content-type",
      32 => "cookie",
      33 => "date",
      34 => "etag",
      35 => "expect",
      36 => "expires",
      37 => "from",
      38 => "host",
      39 => "if-match",
      40 => "if-modified-since",
      41 => "if-none-match",
      42 => "if-range",
      43 => "if-unmodified-since",
      44 => "last-modified",
      45 => "link",
      46 => "location",
      47 => "max-forwards",
      48 => "proxy-authenticate",
      49 => "proxy-authorization",
      50 => "range",
      51 => "referer",
      52 => "refresh",
      53 => "retry-after",
      54 => "server",
      55 => "set-cookie",
      56 => "strict-transport-security",
      57 => "transfer-encoding",
      58 => "user-agent",
      59 => "vary",
      60 => "via",
      61 => "www-authenticate",
      _ => ""
    };
  }

  // Return the non-empty HPACK static-table value for an index.
  function hpack_static_value(index: i64) static_ptr<u8> {
    return match index {
      2 => "GET",
      3 => "POST",
      4 => "/",
      5 => "/index.html",
      6 => "http",
      7 => "https",
      8 => "200",
      9 => "204",
      10 => "206",
      11 => "304",
      12 => "400",
      13 => "404",
      14 => "500",
      16 => "gzip, deflate",
      _ => ""
    };
  }

