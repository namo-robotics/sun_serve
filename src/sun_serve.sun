/*
 * sun_serve.sun - Library entrypoint and manifest for sun_serve.moon
 *
 * sun_serve is an HTTP/1.1 and HTTP/2 server: one event loop per worker thread,
 * nonblocking sockets, optional TLS through bundled OpenSSL, and a
 * handler interface for application code. See README.md for the tour.
 *
 * The manifest carries zlib for WebSocket compression and OpenSSL for TLS.
 * Consumers link these archives through sun_serve.moon. The native-dependencies
 * step prepares verified musl archives beneath the selected build directory.
 */

/*
 * Defines the public server library module.
 */
public module sun_serve {

  using std;

  /*
   * Reports server setup, operating-system, and checked-access failures.
   */
  public enum ServerResult<T> {
    Ok(T),
    Error(Error),
    OutOfBounds(IndexOutOfBoundsError),
    Tls(TlsError), Allocation(std.AllocationError), InvalidArgument(std.InvalidArgumentError), Overflow(std.OverflowError), NotFound(std.NotFoundError), Empty(std.EmptyError), Io(std.IOError), Conversion(std.ConversionError), DivisionByZero(std.DivisionByZeroError), Arithmetic(std.ArithmeticError), Json(std.json.JsonError), Xml(std.xml.XmlError), Decode(std.ProtoDecodeError) }
}

manifest {
  id: "namo-robotics/sun_serve"
  source_files: [
    "version.sun",
    "sys_ffi.sun",
    "abi_linux.sun",
    "buffer.sun",
    "net.sun",
    "epoll.sun",
    "log.sun",
    "config.sun",
    "http/status.sun",
    "http/date.sun",
    "http/mime.sun",
    "http/request.sun",
    "http2.sun",
    "http/response.sun",
    "websocket.sun",
    "handler.sun",
    "tls/openssl_server.sun",
    "tls/tls_context.sun",
    "tls/tls_session.sun",
    "transport.sun",
    "signals.sun",
    "connection.sun",
    "worker.sun",
    "server.sun",
    "static_files.sun"
  ]
  test_files: [
    "../tests/error_tests.sun",
    "../tests/buffer_tests.sun",
    "../tests/epoll_tests.sun",
    "../tests/http_tests.sun",
    "../tests/protocol_tests.sun",
    "../tests/test_client.sun",
    "../tests/server_http_tests.sun",
    "../tests/static_tests.sun",
    "../tests/server_tls_tests.sun"
  ]
  libraries: [
    "stdlib.moon"
  ]
  archives: [
    "${SUN_BUILD}/native/libz.a",
    "${SUN_BUILD}/native/libssl.a",
    "${SUN_BUILD}/native/libcrypto.a"
  ]
}
