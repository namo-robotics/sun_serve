/*
 * sun_serve.sun - Library entrypoint and manifest for sun_serve.moon
 *
 * sun_serve is an HTTP/1.1 and HTTP/2 server: one event loop per worker thread,
 * nonblocking sockets, optional TLS through the tls bundle's OpenSSL, and a
 * handler interface for application code. See README.md for the tour.
 *
 * The manifest lists libssl.a and libcrypto.a even though tls.moon carries the
 * same archives: the Sun linker drops a dependency's archives when module
 * hashes sort in an unlucky order (SUN_FEEDBACK.md, issue 218), so consumers
 * of sun_serve.moon get them from here instead. $MUSL_LIB comes from
 * sun-config.json and points at the musl toolchain's static libraries.
 */

/*
 * Defines the public server library module.
 */
public module sun_serve {
  using std;
}

manifest {
  source_files: [
    "version.sun",
    "sys_ffi.sun",
    "abi_linux.sun",
    "buffer.sun",
    "net.sun",
    "epoll.sun",
    "log.sun",
    "config.sun",
    "http/status.sun",
    "http/date.sun",
    "http/mime.sun",
    "http/request.sun",
    "http2.sun",
    "http/response.sun",
    "websocket.sun",
    "handler.sun",
    "tls/openssl_server.sun",
    "tls/tls_context.sun",
    "tls/tls_session.sun",
    "transport.sun",
    "signals.sun",
    "connection.sun",
    "worker.sun",
    "server.sun",
    "static_files.sun"
  ]
  test_files: [
    "../tests/buffer_tests.sun",
    "../tests/epoll_tests.sun",
    "../tests/http_tests.sun",
    "../tests/protocol_tests.sun",
    "../tests/test_client.sun",
    "../tests/server_http_tests.sun",
    "../tests/static_tests.sun",
    "../tests/server_tls_tests.sun"
  ]
  libraries: ["stdlib.moon", "tls.moon"]
  archives: ["$MUSL_LIB/libz.a", "$MUSL_LIB/libssl.a", "$MUSL_LIB/libcrypto.a"]
}
