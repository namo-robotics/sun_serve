/*
 * static_files.sun - Serving a directory tree over HTTP
 *
 * Paths are normalized before touching the filesystem so a request can never
 * escape the root. Files are opened first and inspected through the open
 * descriptor, so there is no window between a check and the read. Small files
 * are copied into the response; large ones are streamed by the connection.
 */

/*
 * Serves files from a normalized directory tree.
 */
public module sun_serve {

  using std;
  using std.io;

  // Files up to this size are read into memory rather than streamed.
  const SMALL_FILE_MAX: i64 = 65536;

  // Tunable behaviour of a StaticFiles handler.
  public class StaticOptions {
    // The file served for a directory request.
    public var index_name: String;
    // The Cache-Control value, or an empty string when omitted.
    public var cache_control: String;
    // Whether text media types receive a UTF-8 charset.
    public var add_charset: bool = true;

    // Defaults: index.html, no Cache-Control, charset on text.
    init(alloc: const ref HeapAllocator) std.AllocationResult<void> {
      this.index_name = try String(alloc, "index.html");
      this.cache_control = try String(alloc, "");
    }

    // An independent copy.
    public const method clone(alloc: const ref HeapAllocator) std.AllocationResult<StaticOptions> {
      var copy = try StaticOptions(alloc);
      copy.index_name.clear();
      try copy.index_name.append(this.index_name);
      copy.cache_control.clear();
      try copy.cache_control.append(this.cache_control);
      copy.add_charset = this.add_charset;
      return std.AllocationResult.Ok(copy);
    }
  }

  /*
   * Reduce a decoded request path to a safe path relative to the root:
   * empty and "." segments vanish, ".." pops a segment, and a ".." with
   * nothing left to pop means the client tried to escape, which yields None.
   * The result starts with a slash and never ends with one (root is "/").
   */
  public function normalize_path(
    alloc: const ref HeapAllocator,
    path: const ref String
  ) std.AllocationResult<Option<String>> {
    var kept = try Vec<String>(alloc, 8);
    var segments: Vec<String> = try path.split(alloc, b'/');
    for (var segment: ref String in segments) {
      if (segment.is_empty() or segment.equals_literal(".")) {
        continue;
      }
      if (segment.equals_literal("..")) {
        if (kept.size() == 0) {
          return std.AllocationResult.Ok(Option.None);
        }
        kept.pop();
        continue;
      }
      for (var k: i64 = 0; k < segment.length(); k = k + 1) {
        var c: u8 = string_byte(segment, k);
        if (c < 32 or c == 127) {
          return std.AllocationResult.Ok(Option.None);
        }
      }
      try kept.push(try segment.clone(alloc));
    }
    var out = try String(alloc, "");
    for (var segment: ref String in kept) {
      try out.append_char(b'/');
      try out.append(segment);
    }
    if (out.is_empty()) {
      try out.append_char(b'/');
    }
    return std.AllocationResult.Ok(Option.Some(out));
  }

  // Serves normalized paths from a configured directory tree.
  public class StaticFiles implements IHandler {
    var root: String;  // absolute or relative directory, no trailing slash
    var opts: StaticOptions;
    var alloc: HeapAllocator;
    var mode_offset: i64;
    var full_path: String;
    var etag: String;
    var last_modified: String;

    // Serve files under root. Returns an error if root is not a directory.
    init(
      allocator: const ref HeapAllocator,
      root: const ref String,
      opts: StaticOptions
    ) ServerResult<void> {
      this.alloc = allocator.copy();
      this.root = try root.clone(allocator);
      while (this.root.length() > 1 and this.root.ends_with("/")) {
        this.root.truncate(this.root.length() - 1);
      }
      if (not try is_dir(this.root)) {
        var msg = try String(allocator, "not a directory: ");
        try msg.append(this.root);
        return ServerResult.Error(try Error(-1, msg));
      }
      this.opts = opts;
      this.mode_offset = try stat_mode_offset(allocator);
      this.full_path = try String(allocator, "");
      this.etag = try String(allocator, "");
      this.last_modified = try String(allocator, "");
      return ServerResult.Ok;
    }

    // Answer GET and HEAD from the tree and reject other methods.
    public method handle_result(req: const ref Request, resp: ref Response) std.AllocationResult<void> {
      if (not req.method_is("GET") and not req.method_is("HEAD")) {
        resp.set_status(405);
        try resp.add_header("Allow", "GET, HEAD");
        try resp.set_content_type("text/plain");
        try resp.set_body("Method Not Allowed\n");
        return std.AllocationResult.Ok;
      }
      var rel: String = match try normalize_path(this.alloc, req.path()) {
        Option.Some(p) => p,
        Option.None => try String(this.alloc, "")
      };
      if (rel.is_empty()) {
        try this.not_found(resp);
        return std.AllocationResult.Ok;
      }
      this.full_path.clear();
      try this.full_path.append(this.root);
      if (not rel.equals_literal("/")) {
        try this.full_path.append(rel);
      }
      var f = File();
      match f.open(this.full_path, FileMode.Read) {
        SystemResult.Ok => {},
        (e: const ref IError) => {
          try this.not_found(resp);
          return std.AllocationResult.Ok;
        }
      };
      var metadata = try read_file_metadata(this.alloc, f.get_fd(), this.mode_offset);
      if (not metadata.valid) {
        f.close();
        try this.not_found(resp);
        return std.AllocationResult.Ok;
      }
      var mode: u32 = metadata.mode;
      if ((mode & S_IFMT) == S_IFDIR) {
        f.close();
        var path: const ref String = req.path();
        if (not path.ends_with("/")) {
          // Redirect so relative links inside the index resolve correctly.
          var location: String = try path.clone(this.alloc);
          try location.append_char(b'/');
          if (req.has_query()) {
            try location.append_char(b'?');
            var q: String = try req.query(this.alloc);
            try location.append(q);
          }
          try resp.redirect_string(location, 301);
          return std.AllocationResult.Ok;
        }
        try this.full_path.append_char(b'/');
        try this.full_path.append(this.opts.index_name);
        var index = File();
        match index.open(this.full_path, FileMode.Read) {
          SystemResult.Ok => {},
          (e: const ref IError) => {
            resp.set_status(403);
            try resp.set_content_type("text/plain");
            try resp.set_body("Forbidden\n");
            return std.AllocationResult.Ok;
          }
        };
        metadata = try read_file_metadata(this.alloc, index.get_fd(), this.mode_offset);
        if (not metadata.valid) {
          index.close();
          try this.not_found(resp);
          return std.AllocationResult.Ok;
        }
        var index_mode: u32 = metadata.mode;
        if ((index_mode & S_IFMT) != S_IFREG) {
          index.close();
          try this.not_found(resp);
          return std.AllocationResult.Ok;
        }
        try this.serve_file(req, resp, index, metadata.size, metadata.mtime);
        return std.AllocationResult.Ok;
      }
      if ((mode & S_IFMT) != S_IFREG) {
        f.close();
        try this.not_found(resp);
        return std.AllocationResult.Ok;
      }
      try this.serve_file(req, resp, f, metadata.size, metadata.mtime);

      return std.AllocationResult.Ok;
    }

    /** Runs the callback and terminates if its response storage cannot be allocated. */
    public method handle(req: const ref Request, resp: ref Response) void {
      match this.handle_result(req, resp) {
        std.AllocationResult.Ok => {},
        _ => { _panic("allocation failed in server callback"); }
      };
    }

    // A plain-text not-found response.
    method not_found(resp: ref Response) std.AllocationResult<void> {
      resp.set_status(404);
      try resp.set_content_type("text/plain");
      try resp.set_body("Not Found\n");

      return std.AllocationResult.Ok;
    }

    // Send an open regular file with its previously-read metadata.
    method serve_file(
      req: const ref Request,
      resp: ref Response,
      f: File,
      size: i64,
      mtime: i64
    ) std.AllocationResult<void> {
      this.etag.clear();
      try this.etag.append_char(b'"');
      try this.etag.append_hex(mtime);
      try this.etag.append_char(b'-');
      try this.etag.append_hex(size);
      try this.etag.append_char(b'"');
      this.last_modified.clear();
      try append_http_date(this.last_modified, mtime);

      var fresh: bool = match try req.header("if-none-match", this.alloc) {
        Option.Some(inm) => inm.equals_literal("*") or inm.contains(this.etag),
        Option.None => match try req.header("if-modified-since", this.alloc) {
          Option.Some(ims) => ims.equals(this.last_modified),
          Option.None => false
        }
      };
      try resp.add_header_string("ETag", this.etag);
      try resp.add_header_string("Last-Modified", this.last_modified);
      if (this.opts.cache_control.length() > 0) {
        try resp.add_header_string("Cache-Control", this.opts.cache_control);
      }
      if (fresh) {
        resp.set_status(304);
        return std.AllocationResult.Ok;
      }
      var mime: static_ptr<u8> = try mime_for_path(this.full_path);
      if (this.opts.add_charset and mime_is_text(mime)) {
        var ct = try String(this.alloc, mime);
        try ct.append("; charset=utf-8");
        try resp.set_content_type_string(ct);
      } else {
        try resp.set_content_type(mime);
      }
      try resp.add_header("Accept-Ranges", "bytes");
      if (size <= SMALL_FILE_MAX) {
        var body: ref ByteBuffer = resp.body_buffer();
        body.clear();
        try body.read_file(f, size);
        return std.AllocationResult.Ok;
      }
      resp.send_file(f, size);

      return std.AllocationResult.Ok;
    }

    // Reject upgrades because this handler only serves files.
    public method handle_websocket(req: const ref Request, handshake: ref WebSocketHandshake) void {}

    // Ignore open events because files never upgrade.
    public method websocket_open(socket: const ref WebSocketHandle) void {}

    // Ignore message events because files never upgrade.
    public method websocket_message(
      socket: const ref WebSocketHandle,
      message: const ref WebSocketMessage
    ) void {}

    // Ignore close events because files never upgrade.
    public method websocket_close(socket: const ref WebSocketHandle, code: i32) void {}

    // Ignore protocol errors because files never upgrade.
    public method websocket_error(socket: const ref WebSocketHandle, code: i32) void {}
  }

  /*
   * Builds one StaticFiles handler per worker for the server to own.
   */
  public function static_handlers(
    alloc: const ref HeapAllocator,
    root: const ref String,
    opts: const ref StaticOptions,
    count: i32
  ) ServerResult<Vec<StaticFiles>> {
    var out = try Vec<StaticFiles>(alloc, _convert<i64>(count));
    for (var i: i32 = 0; i < count; i = i + 1) {
      try out.push(try StaticFiles(alloc, root, try opts.clone(alloc)));
    }
    return ServerResult.Ok(out);
  }
}
