// mime.sun - Media types by file extension

/*
 * Maps file extensions to HTTP media types.
 */
public module sun_serve {

  using std;

  /*
   * The lowercased extension of a file path, or an empty string when the
   * last path segment has no dot.
   */
  function path_extension(path: const ref String) std.AllocationResult<String> {
    var ext = try String("");
    var dot: i64 = match path.rfind_char(b'.') {
      Option.Some(i) => i,
      Option.None => -1
    };
    var slash: i64 = match path.rfind_char(b'/') {
      Option.Some(i) => i,
      Option.None => -1
    };
    if (dot < 0 or dot < slash) {
      return std.AllocationResult.Ok(ext);
    }
    for (var i: i64 = dot + 1; i < path.length(); i = i + 1) {
      try ext.append_char(lower_ascii(string_byte(path, i)));
    }
    return std.AllocationResult.Ok(ext);
  }

  /*
   * The media type for a file path, judged by its extension. Unknown
   * extensions and files without one are served as generic bytes.
   */
  public function mime_for_path(path: const ref String) std.AllocationResult<static_ptr<u8>> {
    var ext: String = try path_extension(path);
    if (ext.equals_literal("html") or ext.equals_literal("htm")) {
      return std.AllocationResult.Ok("text/html");
    }
    if (ext.equals_literal("css")) {
      return std.AllocationResult.Ok("text/css");
    }
    if (ext.equals_literal("js") or ext.equals_literal("mjs")) {
      return std.AllocationResult.Ok("text/javascript");
    }
    if (ext.equals_literal("json") or ext.equals_literal("map")) {
      return std.AllocationResult.Ok("application/json");
    }
    if (ext.equals_literal("txt") or ext.equals_literal("md")) {
      return std.AllocationResult.Ok("text/plain");
    }
    if (ext.equals_literal("xml")) {
      return std.AllocationResult.Ok("application/xml");
    }
    if (ext.equals_literal("svg")) {
      return std.AllocationResult.Ok("image/svg+xml");
    }
    if (ext.equals_literal("png")) {
      return std.AllocationResult.Ok("image/png");
    }
    if (ext.equals_literal("jpg") or ext.equals_literal("jpeg")) {
      return std.AllocationResult.Ok("image/jpeg");
    }
    if (ext.equals_literal("gif")) {
      return std.AllocationResult.Ok("image/gif");
    }
    if (ext.equals_literal("webp")) {
      return std.AllocationResult.Ok("image/webp");
    }
    if (ext.equals_literal("avif")) {
      return std.AllocationResult.Ok("image/avif");
    }
    if (ext.equals_literal("ico")) {
      return std.AllocationResult.Ok("image/x-icon");
    }
    if (ext.equals_literal("woff")) {
      return std.AllocationResult.Ok("font/woff");
    }
    if (ext.equals_literal("woff2")) {
      return std.AllocationResult.Ok("font/woff2");
    }
    if (ext.equals_literal("ttf")) {
      return std.AllocationResult.Ok("font/ttf");
    }
    if (ext.equals_literal("otf")) {
      return std.AllocationResult.Ok("font/otf");
    }
    if (ext.equals_literal("pdf")) {
      return std.AllocationResult.Ok("application/pdf");
    }
    if (ext.equals_literal("wasm")) {
      return std.AllocationResult.Ok("application/wasm");
    }
    if (ext.equals_literal("mp4")) {
      return std.AllocationResult.Ok("video/mp4");
    }
    if (ext.equals_literal("webm")) {
      return std.AllocationResult.Ok("video/webm");
    }
    if (ext.equals_literal("mp3")) {
      return std.AllocationResult.Ok("audio/mpeg");
    }
    if (ext.equals_literal("ogg")) {
      return std.AllocationResult.Ok("audio/ogg");
    }
    if (ext.equals_literal("zip")) {
      return std.AllocationResult.Ok("application/zip");
    }
    if (ext.equals_literal("gz")) {
      return std.AllocationResult.Ok("application/gzip");
    }
    if (ext.equals_literal("tar")) {
      return std.AllocationResult.Ok("application/x-tar");
    }
    return std.AllocationResult.Ok("application/octet-stream");
  }

  // Report whether a media type is text, which gets a charset parameter.
  public function mime_is_text(mime: static_ptr<u8>) bool {
    var prefix: static_ptr<u8> = "text/";
    if (mime.length() < prefix.length()) {
      return false;
    }
    for (var i: i64 = 0; i < prefix.length(); i = i + 1) {
      if (literal_byte(mime, i) != literal_byte(prefix, i)) {
        return false;
      }
    }
    return true;
  }
}
