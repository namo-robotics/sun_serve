// status.sun - HTTP status codes and their reason phrases

public module sun_serve {
  using std;

  // The standard reason phrase for a status code. Unknown codes get a
  // generic phrase for their class, which clients treat the same way.
  public function reason_phrase(code: i32) static_ptr<u8> {
    return match code {
      100 => "Continue",
      101 => "Switching Protocols",
      200 => "OK",
      201 => "Created",
      202 => "Accepted",
      204 => "No Content",
      206 => "Partial Content",
      301 => "Moved Permanently",
      302 => "Found",
      303 => "See Other",
      304 => "Not Modified",
      307 => "Temporary Redirect",
      308 => "Permanent Redirect",
      400 => "Bad Request",
      401 => "Unauthorized",
      403 => "Forbidden",
      404 => "Not Found",
      405 => "Method Not Allowed",
      406 => "Not Acceptable",
      408 => "Request Timeout",
      409 => "Conflict",
      410 => "Gone",
      411 => "Length Required",
      412 => "Precondition Failed",
      413 => "Content Too Large",
      414 => "URI Too Long",
      415 => "Unsupported Media Type",
      416 => "Range Not Satisfiable",
      417 => "Expectation Failed",
      426 => "Upgrade Required",
      429 => "Too Many Requests",
      431 => "Request Header Fields Too Large",
      500 => "Internal Server Error",
      501 => "Not Implemented",
      502 => "Bad Gateway",
      503 => "Service Unavailable",
      504 => "Gateway Timeout",
      505 => "HTTP Version Not Supported",
      _ => generic_reason(code)
    };
  }

  // A phrase for a status class.
  function generic_reason(code: i32) static_ptr<u8> {
    var class_: i32 = code / 100;
    return match class_ {
      1 => "Informational",
      2 => "Success",
      3 => "Redirection",
      4 => "Client Error",
      5 => "Server Error",
      _ => "Status"
    };
  }

  // Append "HTTP/1.1 <code> <reason>\r\n" to a buffer.
  public function append_status_line(out: ref ByteBuffer, code: i32) void {
    out.append_literal("HTTP/1.1 ");
    out.append_i64(_convert<i64>(code));
    out.append_byte(b' ');
    out.append_literal(reason_phrase(code));
    out.append_literal("\r\n");
  }

  // Report whether responses with this status never carry a body.
  public function status_has_no_body(code: i32) bool {
    return code < 200 or code == 204 or code == 304;
  }
}
