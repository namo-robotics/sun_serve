    // Accept or reject an RFC 8441 extended CONNECT stream.
    method begin_h2_websocket(handler: ref IHandler, date: ref DateCache, cfg: const ref Config) void {
      var handshake = WebSocketHandshake(this.alloc, false);
      if (this.h2_enable_connect and this.request.method_is("CONNECT")) {
        handler.handle_websocket(this.request, handshake);
      }
      if (not handshake.accepted) {
        this.response.reset();
        this.response.set_status(handshake.reject_status);
        this.response.set_body("WebSocket connect rejected\n");
        this.response.serialize_h2(this.wbuf, date.value(), this.h2_stream, cfg.server_header, true);
        return;
      }
      var block = ByteBuffer(this.alloc, 64);
      hpack_status(block, 200, this.alloc);
      if (handshake.subprotocol.length() > 0) {
