    // Upgrade an HTTP/1.1 request to cleartext HTTP/2 stream 1.
    method try_h2c_upgrade(handler: ref IHandler, date: ref DateCache, cfg: const ref Config) bool {
      if (not cfg.http2 or not this.request.header_equals("upgrade", "h2c")) {
        return false;
      }
      if (not this.request.header_contains_token("connection", "upgrade") or not this.request.header_contains_token("connection", "http2-settings") or not this.request.has_header("http2-settings")) {
        return false;
      }
      this.response.reset();
      handler.handle(this.request, this.response);
      this.wbuf.append_literal("HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: h2c\r\n\r\n");
      this.proto = Protocol.Http2;
      this.h2_preface = true;
      this.h2_headers_ready = false;
      this.hpack_decoder.reset();
      h2_frame(this.wbuf, 12, H2_SETTINGS, _convert<u8>(0), 0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(3);
      h2_append_u32(this.wbuf, _convert<u32>(cfg.limits.max_h2_concurrent_streams));
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(8);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(1);
      this.response.serialize_h2(this.wbuf, date.value(), 1, cfg.server_header, not this.request.is_head());
      this.h2_upgrading = true;
      this.keep_alive = true;
      this.send_body = false;
      return true;
    }

    // Finish the h2c transition after the HTTP/1.1 101 response.
    method finish_h2c_upgrade(cfg: const ref Config) void {
      var used: i64 = this.request.head_len() + this.raw_body_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      this.request.reset();
      this.response.reset();
      this.body_buf.clear();
      this.wbuf.clear();
      this.h2_upgrading = false;
      this.state = ConnState.Http2;
      this.want_ = EPOLLIN | EPOLLRDHUP;
      this.deadline_ms = this.deadline_ms + cfg.timeouts.keep_alive_ms;
    }

    // Validate and dispatch an HTTP/1.1 WebSocket opening handshake.
    method try_websocket_upgrade(handler: ref IHandler, date: ref DateCache, cfg: const ref Config) bool {
      if (not this.request.method_is("GET") or this.request.version_minor() != 1) {
        return false;
      }
      if (not this.request.header_contains_token("connection", "upgrade") or not this.request.header_equals("upgrade", "websocket")) {
        return false;
      }
      if (not this.request.header_equals("sec-websocket-version", "13")) {
        this.response.reset();
        this.response.set_status(426);
        this.response.add_header("Sec-WebSocket-Version", "13");
        this.response.set_body("WebSocket version 13 required\n");
        this.keep_alive = false;
        this.send_body = true;
        this.response.serialize_head(this.wbuf, date.value(), false, cfg.server_header);
        this.wbuf.append_bytes(this.response.body_buffer().readable_ptr(), this.response.body_buffer().readable_len());
        return true;
      }
      var missing = String(this.alloc, "");
      var key: String = match this.request.header("sec-websocket-key", this.alloc) {
        Option.Some(v) => v,
        Option.None => missing
      };
      if (not websocket_valid_key(key)) {
        return false;
      }
      var handshake = WebSocketHandshake(this.alloc, false);
      handler.handle_websocket(this.request, handshake);
      if (handshake.subprotocol.length() > 0 and not this.request.header_contains_token_string("sec-websocket-protocol", handshake.subprotocol)) {
        handshake.reject(400);
      }
      if (not handshake.accepted) {
        this.response.reset();
        this.response.set_status(handshake.reject_status);
        this.response.set_body("WebSocket upgrade rejected\n");
        this.keep_alive = false;
        this.send_body = true;
        this.response.serialize_head(this.wbuf, date.value(), false, cfg.server_header);
        this.wbuf.append_bytes(this.response.body_buffer().readable_ptr(), this.response.body_buffer().readable_len());
        return true;
      }
      var accept = websocket_accept(this.alloc, key);
      this.response.reset();
      this.response.set_status(101);
      this.wbuf.append_literal("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ");
      this.wbuf.append_string(accept);
      this.wbuf.append_literal("\r\n");
      if (handshake.subprotocol.length() > 0) {
        this.wbuf.append_literal("Sec-WebSocket-Protocol: ");
        this.wbuf.append_string(handshake.subprotocol);
        this.wbuf.append_literal("\r\n");
      }
      this.wbuf.append_literal("\r\n");
      this.ws_generation = this.activate_websocket(cfg.limits.max_body_bytes);
      this.ws_upgrading = true;
      this.keep_alive = true;
      this.send_body = false;
      return true;
    }

    // Finish switching protocols after the 101 response reaches the client.
    method finish_websocket_upgrade(handler: ref IHandler, cfg: const ref Config) void {
      var used: i64 = this.request.head_len() + this.raw_body_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      this.request.reset();
      this.response.reset();
      this.body_buf.clear();
      this.wbuf.clear();
      this.ws_upgrading = false;
      this.h2_upgrading = false;
      this.ws_fragmenting = false;
      this.ws_closing = false;
      this.state = ConnState.WebSocket;
      this.want_ = EPOLLIN | EPOLLRDHUP;
      this.deadline_ms = this.deadline_ms + cfg.timeouts.keep_alive_ms;
      var socket = WebSocketHandle(this.ws_mailbox.clone(), this.ws_generation);
      handler.websocket_open(socket);
    }

    // Run the WebSocket frame state machine until the socket would block.
