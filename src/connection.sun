        var mask: raw_ptr<u8> = unsafe { _ptr_offset(base, pos); };
        pos = pos + 4;
        var decoded = ByteBuffer(this.alloc, length);
        for (var n: i64 = 0; n < length; n = n + 1) {
          decoded.append_byte(unsafe { _load<u8>(base, pos + n); } ^ unsafe { _load<u8>(mask, n % 4); });
        }
        if (opcode == 9) {
          websocket_append_frame(replies, _convert<u8>(10), decoded.readable_ptr(), decoded.readable_len());
        } else if (opcode == 8) {
          websocket_append_frame(replies, _convert<u8>(8), decoded.readable_ptr(), decoded.readable_len());
          this.deactivate_websocket();
        } else if (opcode == 1 or opcode == 2) {
          this.body_buf.clear();
          this.body_buf.append_bytes(decoded.readable_ptr(), decoded.readable_len());
          this.ws_fragment_opcode = opcode;
          this.ws_fragmenting = not final_frame;
          if (final_frame) {
            this.deliver_websocket_message(handler);
          }
        } else if (opcode == 0 and this.ws_fragmenting) {
          this.body_buf.append_bytes(decoded.readable_ptr(), decoded.readable_len());
          if (final_frame) {
            this.ws_fragmenting = false;
            this.deliver_websocket_message(handler);
          }
        }
        this.h2_ws_buf.consume(pos + length);
        this.h2_ws_buf.compact();
      }
      if (replies.readable_len() > 0) {
        h2_frame(this.wbuf, replies.readable_len(), H2_DATA, _convert<u8>(0), this.h2_ws_stream);
        this.wbuf.append_bytes(replies.readable_ptr(), replies.readable_len());
      }
    }

    // Deliver one assembled data message to the application.
    method deliver_websocket_message(handler: ref IHandler) void {
      if (this.ws_fragment_opcode == 1 and not websocket_valid_utf8(this.body_buf.readable_ptr(), this.body_buf.readable_len())) {
        this.websocket_protocol_error(handler, 1007);
        this.body_buf.clear();
        return;
      }
      var kind: WebSocketMessageKind = WebSocketMessageKind.Binary;
      if (this.ws_fragment_opcode == 1) {
        kind = WebSocketMessageKind.Text;
      }
      var message = WebSocketMessage(kind, this.body_buf.readable_ptr(), this.body_buf.readable_len());
      var socket = WebSocketHandle(this.ws_mailbox.clone(), this.ws_generation);
      handler.websocket_message(socket, message);
      this.body_buf.clear();
    }

    // Notify the application and start a protocol-error close.
    method websocket_protocol_error(handler: ref IHandler, code: i32) void {
      var socket = WebSocketHandle(this.ws_mailbox.clone(), this.ws_generation);
      handler.websocket_error(socket, code);
      var bytes = ContiguousBuffer<u8>(this.alloc, 2);
      bytes.set_unchecked(0, _convert<u8>((code >> 8) & 255));
      bytes.set_unchecked(1, _convert<u8>(code & 255));
      websocket_append_frame(this.wbuf, _convert<u8>(8), bytes.raw_data(), 2);
      this.ws_closing = true;
      this.rbuf.clear();
    }

    // Run the handler and serialize its response into wbuf.
    method handle_request(handler: ref IHandler, date: ref DateCache, cfg: const ref Config, draining: bool) void {
      this.response.reset();
      this.keep_alive = this.request.keep_alive() and not draining;
      if (this.try_h2c_upgrade(handler, date, cfg)) {
        return;
      }
      if (this.try_websocket_upgrade(handler, date, cfg)) {
        return;
      }
      this.send_body = not this.request.is_head();
      handler.handle(this.request, this.response);
      if (this.response.wants_close()) {
        this.keep_alive = false;
      }
      if (status_has_no_body(this.response.status)) {
        this.send_body = false;
      }
      this.bytes_sent = 0;
      this.response.serialize_head(this.wbuf, date.value(), this.keep_alive, cfg.server_header);
      if (this.send_body) {
        var body: ref ByteBuffer = this.response.body_buffer();
        this.wbuf.append_bytes(body.readable_ptr(), body.readable_len());
      }
    }

    // Answer a malformed or oversized request and close afterwards.
    method send_error(status: i32, date: ref DateCache, cfg: const ref Config) void {
      this.response.reset();
      this.response.set_status(status);
      this.response.set_content_type("text/plain");
      this.response.set_body(reason_phrase(status));
      this.response.append_body("\n");
      this.keep_alive = false;
      this.send_body = true;
      this.bytes_sent = 0;
      this.response.serialize_head(this.wbuf, date.value(), false, cfg.server_header);
      var body: ref ByteBuffer = this.response.body_buffer();
      this.wbuf.append_bytes(body.readable_ptr(), body.readable_len());
      this.state = ConnState.Writing;
    }

    // Write wbuf out. Returns zero when empty, else an IO_* value.
    method flush_wbuf() i64 {
      while (this.wbuf.readable_len() > 0) {
        var n: i64 = this.transport.write(this.wbuf.readable_ptr(), this.wbuf.readable_len());
        if (n > 0) {
          this.wbuf.consume(n);
          this.bytes_sent = this.bytes_sent + n;
          continue;
        }
        if (n == IO_CLOSED) {
          return IO_ERROR;
        }
        return n;
      }
      return 0;
    }

    // Write the response head, body, and any streamed file. Returns zero when
    // everything was sent, else an IO_* value.
    method write_response() i64 {
      while (true) {
        var r: i64 = this.flush_wbuf();
        if (r != 0) {
          return r;
        }
        if (this.send_body and this.response.has_file_body()) {
          var before: i64 = this.response.file_bytes_remaining();
          var n: i64 = this.response.read_file_chunk(this.wbuf, FILE_CHUNK);
          if (n == 0 and before > 0) {
            // The file shrank or failed mid-stream; the response is short,
            // so the connection must not be reused.
            this.keep_alive = false;
            return 0;
          }
          continue;
        }
        return 0;
      }
      return 0;
    }

    // Discard the finished request's bytes and get ready for the next one.
    method finish_request() void {
      var used: i64 = this.request.head_len() + this.raw_body_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      this.rbuf.shrink_to(IDLE_BUFFER_CAP);
      this.wbuf.clear();
      this.wbuf.shrink_to(IDLE_BUFFER_CAP);
      this.body_buf.clear();
      this.body_buf.shrink_to(16);
      this.response.reset();
      this.request.reset();
      this.continue_sent = false;
      this.state = ConnState.ReadingHead;
      this.want_ = EPOLLIN | EPOLLRDHUP;
    }

    // Write one access log line for the response just sent.
    method log_access(log: ref Logger, now_ms: i64) void {
      if (not log.access_enabled()) {
        return;
      }
      var entry = ByteBuffer(this.alloc, 256);
      if (this.transport.is_tls()) {
        entry.append_literal("https ");
      } else {
        entry.append_literal("http ");
      }
      entry.append_byte(b'"');
      var method: String = this.request.method_text(this.alloc);
      if (method.length() == 0) {
        entry.append_literal("-");
      } else {
        entry.append_string(method);
        entry.append_byte(b' ');
        var target: String = this.request.raw_target(this.alloc);
        entry.append_string(target);
      }
      entry.append_literal("\" ");
      entry.append_i64(_convert<i64>(this.response.status));
      entry.append_byte(b' ');
      entry.append_i64(this.bytes_sent);
      entry.append_byte(b' ');
      entry.append_i64(now_ms - this.started_ms);
      entry.append_literal("ms");
      log.access(entry);
    }
  }
}
