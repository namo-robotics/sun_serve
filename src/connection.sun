/*
 * connection.sun - One client connection's state machine
 *
 * A Connection owns a transport and the buffers for the request being read
 * and the response being written. The worker calls on_event() whenever epoll
 * reports the socket ready; the connection then runs as far as it can without
 * blocking and records which readiness it needs next in want(). Every request
 * on a keep-alive connection passes through the same states in turn.
 */

/*
 * Drives client connections through the supported protocols.
 */
public module sun_serve {
  using std;

  enum ConnState { Vacant, Handshaking, ReadingHead, ReadingBody, Writing, WebSocket, Http2, Closed }

  // The application protocol selected for a connection.
  public enum Protocol { Http1, Http2 }

  // How the request body is framed.
  const BODY_NONE: i32 = 0;
  const BODY_LENGTH: i32 = 1;
  const BODY_CHUNKED: i32 = 2;

  // Chunked decoder states.
  const CHUNK_SIZE: i32 = 0;
  const CHUNK_DATA: i32 = 1;
  const CHUNK_DATA_END: i32 = 2;
  const CHUNK_TRAILERS: i32 = 3;
  const CHUNK_DONE: i32 = 4;

  const READ_CHUNK: i64 = 16384;
  const FILE_CHUNK: i64 = 65536;
  const IDLE_BUFFER_CAP: i64 = 65536;
  const MAX_CHUNK_SIZE_LINE: i64 = 64;

  // How the HTTP/1 request body is framed and how much of it has arrived.
  class BodyFraming {
    var kind: i32 = BODY_NONE;
    var raw_len: i64 = 0;  // bytes after the head belonging to this request
    var chunk_state: i32 = CHUNK_SIZE;
    var chunk_remaining: i64 = 0;
    var continue_sent: bool = false;

    // Forget the previous request's body.
    method reset() void {
      this.kind = BODY_NONE;
      this.raw_len = 0;
      this.chunk_state = CHUNK_SIZE;
      this.chunk_remaining = 0;
      this.continue_sent = false;
    }
  }

  // Drives one client through parsing, dispatch, and response delivery.
  public class Connection {
    var transport: Transport = Transport();
    var state: ConnState = ConnState.Vacant;
    var proto: Protocol = Protocol.Http1;
    var interest: u32 = 0;  // the mask the worker registered last
    var want_: u32 = 0;  // the mask the connection needs now
    var rbuf: ByteBuffer;  // inbound bytes; the current request stays put
    var body_buf: ByteBuffer;  // decoded chunked body or reassembled WebSocket message
    var wbuf: ByteBuffer;  // serialized response
    var request: Request;
    var response: Response;
    var framing: BodyFraming = BodyFraming();
    var h2: H2ConnectionState;
    var h2_ws: H2WebSocketTunnel;
    var ws: WebSocketState;
    var keep_alive: bool = false;
    var send_body: bool = true;
    var peer_closed: bool = false;
    var served: i64 = 0;
    var deadline_ms: i64 = 0;
    var started_ms: i64 = 0;
    var bytes_sent: i64 = 0;
    var alloc: HeapAllocator;

    // Build a vacant connection with its buffers ready.
    init(allocator: const ref HeapAllocator) {
      this.alloc = allocator.copy();
      this.rbuf = ByteBuffer(allocator, 8192);
      this.body_buf = ByteBuffer(allocator, 16);
      this.wbuf = ByteBuffer(allocator, 16384);
      this.request = Request(allocator);
      this.response = Response(allocator);
      this.h2 = H2ConnectionState(allocator);
      this.h2_ws = H2WebSocketTunnel(allocator);
      this.ws = WebSocketState(allocator);
    }

    /*
     * Take over an accepted socket. For TLS the handshake starts on the first
     * event. Returns false if a TLS session could not be created.
     */
    public method open(fd: i32, tls: bool, acceptor: ref TlsAcceptor, now_ms: i64, timeouts: const ref Timeouts, wake_fd: i32) bool {
      if (not this.transport.open(fd, tls, acceptor)) {
        return false;
      }
      this.interest = 0;
      this.want_ = EPOLLIN;
      this.served = 0;
      this.peer_closed = false;
      this.proto = Protocol.Http1;
      this.rbuf.clear();
      this.wbuf.clear();
      this.body_buf.clear();
      this.h2.reset();
      this.h2_ws.reset();
      this.ws.reset(wake_fd);
      if (tls) {
        this.state = ConnState.Handshaking;
        this.deadline_ms = now_ms + timeouts.handshake_ms;
      } else {
        this.state = ConnState.ReadingHead;
        this.deadline_ms = now_ms + timeouts.header_ms;
      }
      this.started_ms = now_ms;
      return true;
    }

    // Report whether the socket is still open.
    public const method is_open() bool {
      return this.transport.is_open();
    }

    // The socket descriptor.
    public const method get_fd() i32 {
      return this.transport.get_fd();
    }

    // The readiness mask the connection needs next.
    public const method want() u32 {
      return this.want_;
    }

    // The readiness mask registered with epoll.
    public const method registered() u32 {
      return this.interest;
    }

    // Record the mask the worker registered.
    public method set_registered(mask: u32) void {
      this.interest = mask;
    }

    /*
     * Report whether the connection is between requests with nothing
     * buffered, so it can be dropped at shutdown without losing anything.
     */
    public const method is_idle() bool {
      return this.state == ConnState.ReadingHead and this.rbuf.is_empty() and this.served > 0;
    }

    // Report whether this connection needs asynchronous WebSocket polling.
    public const method is_websocket() bool {
      return this.state == ConnState.WebSocket or (this.state == ConnState.Http2 and this.h2_ws.stream != 0);
    }

    // Report whether the connection is sending a response.
    public const method is_writing() bool {
      return this.state == ConnState.Writing;
    }

    // Report whether the current state's deadline has passed.
    public const method expired(now_ms: i64) bool {
      return this.state != ConnState.Vacant and now_ms >= this.deadline_ms;
    }

    /*
     * Close the socket and return to the vacant state, releasing memory a
     * large request may have grown.
     */
    public method close() void {
      this.transport.close();
      this.state = ConnState.Vacant;
      this.want_ = 0;
      this.interest = 0;
      this.response.reset();
      this.request.reset();
      this.rbuf.clear();
      this.wbuf.clear();
      this.body_buf.clear();
      this.ws.deactivate();
      this.h2.headers.clear();
      this.h2.headers_ready = false;
      this.rbuf.shrink_to(IDLE_BUFFER_CAP);
      this.wbuf.shrink_to(IDLE_BUFFER_CAP);
      this.body_buf.shrink_to(16);
    }

    // Queue protocol-specific graceful shutdown notifications.
    public method begin_shutdown() void {
      if (this.state == ConnState.WebSocket) {
        var code = ByteBuffer(HeapAllocator(), 2);
        code.append_byte(3);
        code.append_byte(233);
        websocket_append_frame(this.wbuf, _convert<u8>(8), code, 0, 2);
        this.ws.closing = true;
        this.ws.deactivate();
        this.want_ = EPOLLOUT;
      } else if (this.state == ConnState.Http2) {
        if (this.h2_ws.stream != 0) {
          var websocket = ByteBuffer(this.alloc, 4);
          var ws_code = ByteBuffer(HeapAllocator(), 2);
          ws_code.append_byte(3);
          ws_code.append_byte(233);
          websocket_append_frame(websocket, _convert<u8>(8), ws_code, 0, 2);
          this.h2_ws.outbound.append_buffer(websocket, 0, websocket.readable_len());
          this.h2_ws.end_pending = true;
          this.ws.deactivate();
        }
        h2_frame(this.wbuf, 8, H2_GOAWAY, _convert<u8>(0), 0);
        h2_append_u32(this.wbuf, this.h2.last_client_stream);
        h2_append_u32(this.wbuf, 0);
        this.want_ = EPOLLIN | EPOLLOUT | EPOLLRDHUP;
      }
    }

    /*
     * Run the state machine for a readiness event. peer_hup says the peer
     * closed its side; draining says the server is shutting down and no
     * further requests should be accepted on this connection.
     */
    public method on_event(mask: u32, handler: ref IHandler, date: ref DateCache, log: ref Logger, cfg: const ref Config, now_ms: i64, draining: bool) void {
      if ((mask & EPOLLERR) != 0) {
        this.close();
        return;
      }
      if ((mask & (EPOLLHUP | EPOLLRDHUP)) != 0) {
        this.peer_closed = true;
      }
      this.drive(handler, date, log, cfg, now_ms, draining);
    }

    // Advance through as many states as the socket allows.
    method drive(handler: ref IHandler, date: ref DateCache, log: ref Logger, cfg: const ref Config, now_ms: i64, draining: bool) void {
      while (true) {
        if (this.state == ConnState.Handshaking) {
          var r: i64 = this.transport.handshake();
          if (r == 0) {
            if (not this.select_protocol()) {
              log.log(LogLevel.Debug, "closing connection: negotiated protocol not supported");
              this.close();
              return;
            }
            if (this.proto == Protocol.Http2) {
              this.start_http2(now_ms, cfg);
            } else {
              this.state = ConnState.ReadingHead;
              this.deadline_ms = now_ms + cfg.timeouts.header_ms;
            }
            continue;
          }
          if (not this.wait_for(r)) {
            this.close();
          }
          return;
        }
        if (this.state == ConnState.WebSocket) {
          this.drive_websocket(handler, cfg);
          return;
        }
        if (this.state == ConnState.Http2) {
          this.drive_http2(handler, date, log, cfg, now_ms, draining);
          return;
        }
        if (this.state == ConnState.ReadingHead) {
          if (cfg.http2 and not this.transport.is_tls() and this.rbuf.readable_len() > 0) {
            var preface: i32 = this.h2_preface_status();
            if (preface > 0) {
              this.start_http2(now_ms, cfg);
              continue;
            }
            if (preface == 0) {
              if (not this.fill_rbuf()) {
                return;
              }
              continue;
            }
          }
          if (this.rbuf.readable_len() > 0) {
            var st: ParseStatus = this.request.parse_head(this.rbuf, this.rbuf.readable_len(), cfg.limits);
            if (st == ParseStatus.Complete) {
              this.started_ms = now_ms;
              this.begin_body();
              this.state = ConnState.ReadingBody;
              this.deadline_ms = now_ms + cfg.timeouts.body_ms;
              continue;
            }
            if (st == ParseStatus.Failed) {
              this.started_ms = now_ms;
              this.send_error(this.request.error_status(), date, cfg);
              this.deadline_ms = now_ms + cfg.timeouts.write_ms;
              continue;
            }
          }
          if (not this.fill_rbuf()) {
            return;
          }
          continue;
        }
        if (this.state == ConnState.ReadingBody) {
          var body_status: i32 = this.advance_body(cfg);
          if (body_status == 0) {
            this.handle_request(handler, date, cfg, draining);
            this.state = ConnState.Writing;
            this.deadline_ms = now_ms + cfg.timeouts.write_ms;
            continue;
          }
          if (body_status > 0) {
            this.send_error(body_status, date, cfg);
            this.deadline_ms = now_ms + cfg.timeouts.write_ms;
            continue;
          }
          if (this.request.expects_continue() and not this.framing.continue_sent) {
            this.framing.continue_sent = true;
            this.wbuf.append_literal("HTTP/1.1 100 Continue\r\n\r\n");
            var fr: i64 = this.flush_wbuf();
            if (fr == IO_ERROR) {
              this.close();
              return;
            }
          }
          if (not this.fill_rbuf()) {
            return;
          }
          continue;
        }
        if (this.state == ConnState.Writing) {
          var w: i64 = this.write_response();
          if (w == 0) {
            this.served = this.served + 1;
            this.log_access(log, now_ms);
            if (this.ws.upgrading) {
              this.finish_websocket_upgrade(handler, cfg);
              continue;
            }
            if (this.h2.upgrading) {
              this.finish_h2c_upgrade(cfg);
              continue;
            }
            if (not this.keep_alive or this.peer_closed) {
              this.close();
              return;
            }
            this.finish_request();
            this.deadline_ms = now_ms + cfg.timeouts.keep_alive_ms;
            continue;
          }
          if (not this.wait_for(w)) {
            this.close();
          }
          return;
        }
        return;
      }
    }

    /*
     * Translate an IO_* wait value into the next interest mask. Returns false
     * when the value means the connection is finished.
     */
    method wait_for(r: i64) bool {
      if (r == IO_WANT_READ) {
        this.want_ = EPOLLIN | EPOLLRDHUP;
        return true;
      }
      if (r == IO_WANT_WRITE) {
        this.want_ = EPOLLOUT;
        return true;
      }
      return false;
    }

    // After a TLS handshake, adopt the negotiated application protocol.
    method select_protocol() bool {
      var name = String(this.alloc, "");
      if (this.transport.alpn(name)) {
        if (name.equals_literal("h2")) {
          this.proto = Protocol.Http2;
          return true;
        }
      }
      this.proto = Protocol.Http1;
      return true;
    }

    /*
     * Read more bytes into rbuf. Returns true when bytes arrived, false when
     * the caller must return to the event loop (want() is set) or the
     * connection was closed.
     */
    method fill_rbuf() bool {
      this.rbuf.reserve(READ_CHUNK);
      var n: i64 = this.transport.read(this.rbuf.writable_ptr(), this.rbuf.writable_len());
      if (n > 0) {
        this.rbuf.commit(n);
        // TLS may hold decrypted bytes that epoll will never announce.
        while (this.transport.pending() > 0) {
          this.rbuf.reserve(READ_CHUNK);
          var more: i64 = this.transport.read(this.rbuf.writable_ptr(), this.rbuf.writable_len());
          if (more <= 0) {
            break;
          }
          this.rbuf.commit(more);
        }
        return true;
      }
      if (n == IO_CLOSED) {
        this.close();
        return false;
      }
      if (not this.wait_for(n)) {
        this.close();
      }
      return false;
    }

    // Compare buffered cleartext bytes with the HTTP/2 client preface.
    method h2_preface_status() i32 {
      var preface: static_ptr<u8> = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";
      var have: i64 = this.rbuf.readable_len();
      var check: i64 = have;
      if (check > preface.length()) {
        check = preface.length();
      }
      for (var i: i64 = 0; i < check; i = i + 1) {
        if (this.rbuf.byte_at(i) != literal_byte(preface, i)) {
          return -1;
        }
      }
      if (have < preface.length()) {
        return 0;
      }
      return 1;
    }

    // Enter HTTP/2 and queue the server settings.
    method start_http2(now_ms: i64, cfg: const ref Config) void {
      this.proto = Protocol.Http2;
      this.state = ConnState.Http2;
      this.h2.preface = true;
      this.h2.headers_ready = false;
      this.h2.headers.clear();
      this.body_buf.clear();
      this.deadline_ms = now_ms + cfg.timeouts.keep_alive_ms;
      h2_frame(this.wbuf, 12, H2_SETTINGS, _convert<u8>(0), 0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(3);
      h2_append_u32(this.wbuf, _convert<u32>(cfg.limits.max_h2_concurrent_streams));
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(8);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(1);
      this.want_ = EPOLLIN | EPOLLOUT | EPOLLRDHUP;
    }

    // Process HTTP/2 frames until the transport would block.
    method drive_http2(handler: ref IHandler, date: ref DateCache, log: ref Logger, cfg: const ref Config, now_ms: i64, draining: bool) void {
      while (true) {
        if (this.h2_ws.stream != 0) {
          var websocket_frames = ByteBuffer(this.alloc, 256);
          var websocket_active: bool = this.ws.drain_to(websocket_frames);
          this.h2_ws.outbound.append_bytes(websocket_frames.readable_ptr(), websocket_frames.readable_len());
          if (not websocket_active) {
            this.h2_ws.end_pending = true;
          }
          this.flush_h2_websocket_data();
        }
        this.flush_h2_response_data();
        if (this.wbuf.readable_len() > 0) {
          var wr: i64 = this.flush_wbuf();
          if (wr != 0) {
            if (not this.wait_for(wr)) {
              this.close();
            }
            return;
          }
          this.want_ = EPOLLIN | EPOLLRDHUP;
        }
        if (this.h2.preface) {
          if (this.rbuf.readable_len() < 24) {
            if (not this.fill_rbuf()) {
              return;
            }
            continue;
          }
          if (this.h2_preface_status() <= 0) {
            this.close();
            return;
          }
          this.rbuf.consume(24);
          this.h2.preface = false;
        }
        if (this.rbuf.readable_len() < 9) {
          if (not this.fill_rbuf()) {
            return;
          }
          continue;
        }
        var frame_len: i64 = (_convert<i64>(this.rbuf.byte_at(0)) << 16) | (_convert<i64>(this.rbuf.byte_at(1)) << 8) | _convert<i64>(this.rbuf.byte_at(2));
        if (frame_len > H2_DEFAULT_FRAME_SIZE) {
          this.close();
          return;
        }
        if (this.rbuf.readable_len() < 9 + frame_len) {
          if (not this.fill_rbuf()) {
            return;
          }
          continue;
        }
        var kind: u8 = this.rbuf.byte_at(3);
        var flags: u8 = this.rbuf.byte_at(4);
        var stream: u32 = h2_u32(this.rbuf, 5) & 2147483647;
        if (this.h2.continuation_stream != 0 and kind != H2_CONTINUATION) {
          this.close();
          return;
        }
        if (kind == H2_SETTINGS) {
          if (stream != 0 or ((flags & H2_ACK) != 0 and frame_len != 0) or ((flags & H2_ACK) == 0 and frame_len % 6 != 0)) {
            this.close();
            return;
          }
          if ((flags & H2_ACK) == 0) {
            for (var setting: i64 = 0; setting < frame_len; setting = setting + 6) {
              var identifier: i32 = _convert<i32>(this.rbuf.byte_at(9 + setting)) * 256 + _convert<i32>(this.rbuf.byte_at(9 + setting + 1));
              var setting_value: u32 = h2_u32(this.rbuf, 9 + setting + 2);
              if (identifier == 2 and setting_value > 1) {
                this.close();
                return;
              } else if (identifier == 4) {
                if (setting_value > 2147483647) {
                  this.close();
                  return;
                }
                var window_delta: i64 = _convert<i64>(setting_value) - this.h2.peer_initial_window;
                this.h2.peer_initial_window = _convert<i64>(setting_value);
                if (this.h2_ws.stream != 0) {
                  this.h2_ws.send_window = this.h2_ws.send_window + window_delta;
                }
                for (var response_index: i64 = 0; response_index < this.h2.responses.size(); response_index = response_index + 1) {
                  var pending_response: ref H2ResponseStream = this.h2.responses.get_unchecked(response_index);
                  if (pending_response.active) {
                    pending_response.window = pending_response.window + window_delta;
                  }
                }
              } else if (identifier == 5) {
                if (setting_value < 16384 or setting_value > 16777215) {
                  this.close();
                  return;
                }
                this.h2.peer_frame_size = _convert<i64>(setting_value);
              } else if (identifier == 8) {
                if (setting_value > 1) {
                  this.close();
                  return;
                }
                this.h2.enable_connect = setting_value == 1;
              }
            }
            h2_frame(this.wbuf, 0, H2_SETTINGS, H2_ACK, 0);
          }
        } else if (kind == H2_PING) {
          if (stream != 0 or frame_len != 8) {
            this.close();
            return;
          }
          if ((flags & H2_ACK) == 0) {
            h2_frame(this.wbuf, 8, H2_PING, H2_ACK, 0);
            this.wbuf.append_buffer(this.rbuf, 9, 8);
          }
        } else if (kind == H2_HEADERS) {
          if (stream == 0 or (stream & 1) == 0) {
            this.close();
            return;
          }
          var fragment_pos: i64 = 0;
          var fragment_len: i64 = frame_len;
          if ((flags & 8) != 0) {
            if (fragment_len < 1) {
              this.close();
              return;
            }
            var padding: i64 = _convert<i64>(this.rbuf.byte_at(9 + 0));
            fragment_pos = 1;
            fragment_len = fragment_len - 1 - padding;
            if (fragment_len < 0) {
              this.close();
              return;
            }
          }
          if ((flags & 32) != 0) {
            if (fragment_len < 5) {
              this.close();
              return;
            }
            fragment_pos = fragment_pos + 5;
            fragment_len = fragment_len - 5;
          }
          this.h2.headers.clear();
          this.body_buf.clear();
          this.h2.header_block.clear();
          this.h2.header_block.append_buffer(this.rbuf, 9 + fragment_pos, fragment_len);
          this.h2.header_end_stream = (flags & H2_END_STREAM) != 0;
          if ((flags & H2_END_HEADERS) == 0) {
            this.h2.continuation_stream = stream;
          } else {
            if (not hpack_decode(this.alloc, this.h2.header_block, this.h2.header_block.readable_len(), this.h2.hpack, this.h2.headers)) {
              this.close();
              return;
            }
            this.accept_h2_headers(stream, this.h2.header_end_stream, handler, date, log, cfg, now_ms, draining);
          }
        } else if (kind == H2_CONTINUATION) {
          if (stream == 0 or stream != this.h2.continuation_stream) {
            this.close();
            return;
          }
          this.h2.header_block.append_buffer(this.rbuf, 9, frame_len);
          if ((flags & H2_END_HEADERS) != 0) {
            this.h2.continuation_stream = 0;
            if (not hpack_decode(this.alloc, this.h2.header_block, this.h2.header_block.readable_len(), this.h2.hpack, this.h2.headers)) {
              this.close();
              return;
            }
            this.accept_h2_headers(stream, this.h2.header_end_stream, handler, date, log, cfg, now_ms, draining);
          }
        } else if (kind == H2_DATA) {
          if (stream == 0) {
            this.close();
            return;
          }
          var data_pos: i64 = 0;
          var data_len: i64 = frame_len;
          if ((flags & 8) != 0) {
            if (data_len < 1) {
              this.close();
              return;
            }
            var data_padding: i64 = _convert<i64>(this.rbuf.byte_at(9 + 0));
            data_pos = 1;
            data_len = data_len - 1 - data_padding;
            if (data_len < 0) {
              this.close();
              return;
            }
          }
          if (stream == this.h2_ws.stream and stream != 0) {
            this.h2_ws.inbound.append_buffer(this.rbuf, 9 + data_pos, data_len);
            this.process_h2_websocket(handler, cfg);
            if ((flags & H2_END_STREAM) != 0) {
              var socket = this.ws.handle();
              handler.websocket_close(socket, 1000);
              this.ws.deactivate();
              this.h2_ws.stream = 0;
            }
          } else {
            var stream_index: i64 = this.find_h2_request_stream(stream);
            if (stream_index < 0) {
              this.h2_send_rst(stream, 5);
            } else {
              var stream_body_len: i64 = this.h2.streams.get_unchecked(stream_index).body.readable_len();
              if (stream_body_len + data_len > cfg.limits.max_body_bytes or this.h2.buffered_bytes + data_len > cfg.limits.max_h2_buffered_bytes) {
                this.h2_send_rst(stream, 11);
                this.reset_h2_request_stream(stream_index);
              } else {
                this.h2.streams.get_unchecked(stream_index).body.append_buffer(this.rbuf, 9 + data_pos, data_len);
                this.h2.buffered_bytes = this.h2.buffered_bytes + data_len;
                if ((flags & H2_END_STREAM) != 0) {
                  this.dispatch_h2_request_stream(stream_index, handler, date, log, cfg, now_ms);
                }
              }
            }
          }
          if (frame_len > 0) {
            h2_frame(this.wbuf, 4, H2_WINDOW_UPDATE, _convert<u8>(0), 0);
            h2_append_u32(this.wbuf, _convert<u32>(frame_len));
            h2_frame(this.wbuf, 4, H2_WINDOW_UPDATE, _convert<u8>(0), stream);
            h2_append_u32(this.wbuf, _convert<u32>(frame_len));
          }
        } else if (kind == H2_PRIORITY) {
          if (stream == 0 or frame_len != 5) {
            this.close();
            return;
          }
        } else if (kind == H2_WINDOW_UPDATE) {
          var increment: i64 = 0;
          if (frame_len == 4) {
            increment = _convert<i64>(h2_u32(this.rbuf, 9) & 2147483647);
          }
          if (increment == 0) {
            this.close();
            return;
          }
          if (stream == 0) {
            if (this.h2.send_window + increment > 2147483647) {
              this.close();
              return;
            }
            this.h2.send_window = this.h2.send_window + increment;
          } else if (stream == this.h2_ws.stream) {
            if (this.h2_ws.send_window + increment > 2147483647) {
              this.close();
              return;
            }
            this.h2_ws.send_window = this.h2_ws.send_window + increment;
          } else {
            var response_index: i64 = this.find_h2_response_stream(stream);
            if (response_index >= 0) {
              var next_window: i64 = this.h2.responses.get_unchecked(response_index).window + increment;
              if (next_window > 2147483647) {
                this.close();
                return;
              }
              this.h2.responses.get_unchecked(response_index).window = next_window;
            }
          }
        } else if (kind == H2_RST_STREAM) {
          if (stream == 0 or frame_len != 4) {
            this.close();
            return;
          }
          var reset_index: i64 = this.find_h2_request_stream(stream);
          if (reset_index >= 0) {
            this.reset_h2_request_stream(reset_index);
          }
          var reset_response: i64 = this.find_h2_response_stream(stream);
          if (reset_response >= 0) {
            this.h2.responses.get_unchecked(reset_response).reset();
          }
          if (stream == this.h2_ws.stream) {
            this.ws.deactivate();
            this.h2_ws.stream = 0;
            this.h2_ws.outbound.clear();
            this.h2_ws.end_pending = false;
          }
        } else if (kind == H2_GOAWAY) {
          if (stream != 0 or frame_len < 8) {
            this.close();
            return;
          }
          this.close();
          return;
        } else if (kind == H2_PUSH_PROMISE) {
          this.close();
          return;
        }
        this.rbuf.consume(9 + frame_len);
        this.rbuf.compact();
        this.deadline_ms = now_ms + cfg.timeouts.keep_alive_ms;
      }
    }

    // Find queued response data for a stream.
    method find_h2_response_stream(id: u32) i64 {
      for (var i: i64 = 0; i < this.h2.responses.size(); i = i + 1) {
        var pending: ref H2ResponseStream = this.h2.responses.get_unchecked(i);
        if (pending.active and pending.id == id) {
          return i;
        }
      }
      return -1;
    }

    // Allocate a response-data slot with the peer's current stream window.
    method open_h2_response_stream(id: u32) i64 {
      for (var i: i64 = 0; i < this.h2.responses.size(); i = i + 1) {
        if (not this.h2.responses.get_unchecked(i).active) {
          this.h2.responses.get_unchecked(i).begin(id, this.h2.peer_initial_window);
          return i;
        }
      }
      this.h2.responses.push(H2ResponseStream(this.alloc));
      var added: i64 = this.h2.responses.size() - 1;
      this.h2.responses.get_unchecked(added).begin(id, this.h2.peer_initial_window);
      return added;
    }

    // Split a serialized response into immediate HEADERS and queued DATA.
    method queue_h2_response(date: ref DateCache, stream: u32, server_header: bool, send_body: bool) void {
      var encoded = ByteBuffer(this.alloc, 1024);
      this.response.serialize_h2(encoded, date.value(), stream, server_header, send_body);
      var response_index: i64 = -1;
      while (encoded.readable_len() >= 9) {
        var length: i64 = (_convert<i64>(encoded.byte_at(0)) << 16) | (_convert<i64>(encoded.byte_at(1)) << 8) | _convert<i64>(encoded.byte_at(2));
        var kind: u8 = encoded.byte_at(3);
        if (encoded.readable_len() < 9 + length) {
          return;
        }
        if (kind == H2_DATA) {
          if (response_index < 0) {
            response_index = this.open_h2_response_stream(stream);
          }
          this.h2.responses.get_unchecked(response_index).data.append_buffer(encoded, 9, length);
        } else if (kind == H2_HEADERS and length > this.h2.peer_frame_size) {
          var original_flags: u8 = encoded.byte_at(4);
          var header_pos: i64 = 0;
          var first_fragment: bool = true;
          while (header_pos < length) {
            var take: i64 = length - header_pos;
            if (take > this.h2.peer_frame_size) {
              take = this.h2.peer_frame_size;
            }
            var fragment_kind: u8 = H2_CONTINUATION;
            var fragment_flags: u8 = 0;
            if (first_fragment) {
              fragment_kind = H2_HEADERS;
              fragment_flags = original_flags & H2_END_STREAM;
            }
            if (header_pos + take == length) {
              fragment_flags = fragment_flags | H2_END_HEADERS;
            }
            h2_frame(this.wbuf, take, fragment_kind, fragment_flags, stream);
            this.wbuf.append_buffer(encoded, 9 + header_pos, take);
            header_pos = header_pos + take;
            first_fragment = false;
          }
        } else {
          this.wbuf.append_buffer(encoded, 0, 9 + length);
        }
        encoded.consume(9 + length);
      }
    }

    // Emit RFC 8441 bytes within the peer's HTTP/2 flow-control windows.
    method flush_h2_websocket_data() void {
      while (this.h2_ws.stream != 0 and this.h2_ws.send_window > 0 and this.h2.send_window > 0 and this.h2_ws.outbound.readable_len() > 0) {
        var take: i64 = this.h2_ws.outbound.readable_len();
        if (take > this.h2.peer_frame_size) {
          take = this.h2.peer_frame_size;
        }
        if (take > this.h2_ws.send_window) {
          take = this.h2_ws.send_window;
        }
        if (take > this.h2.send_window) {
          take = this.h2.send_window;
        }
        h2_frame(this.wbuf, take, H2_DATA, _convert<u8>(0), this.h2_ws.stream);
        this.wbuf.append_bytes(this.h2_ws.outbound.readable_ptr(), take);
        this.h2_ws.outbound.consume(take);
        this.h2_ws.send_window = this.h2_ws.send_window - take;
        this.h2.send_window = this.h2.send_window - take;
      }
      if (this.h2_ws.stream != 0 and this.h2_ws.outbound.readable_len() == 0 and this.h2_ws.end_pending) {
        h2_frame(this.wbuf, 0, H2_DATA, H2_END_STREAM, this.h2_ws.stream);
        this.h2_ws.stream = 0;
        this.h2_ws.end_pending = false;
      }
    }

    // Emit queued DATA within the peer's connection and stream windows.
    method flush_h2_response_data() void {
      if (this.h2.send_window <= 0) {
        return;
      }
      for (var i: i64 = 0; i < this.h2.responses.size(); i = i + 1) {
        var pending: ref H2ResponseStream = this.h2.responses.get_unchecked(i);
        while (pending.active and pending.window > 0 and this.h2.send_window > 0 and pending.data.readable_len() > 0) {
          var take: i64 = pending.data.readable_len();
          if (take > this.h2.peer_frame_size) {
            take = this.h2.peer_frame_size;
          }
          if (take > pending.window) {
            take = pending.window;
          }
          if (take > this.h2.send_window) {
            take = this.h2.send_window;
          }
          var flags: u8 = 0;
          if (take == pending.data.readable_len()) {
            flags = H2_END_STREAM;
          }
          h2_frame(this.wbuf, take, H2_DATA, flags, pending.id);
          this.wbuf.append_bytes(pending.data.readable_ptr(), take);
          pending.data.consume(take);
          pending.window = pending.window - take;
          this.h2.send_window = this.h2.send_window - take;
          if (pending.data.readable_len() == 0) {
            pending.reset();
          }
        }
      }
    }

    // Find an active buffered request stream.
    method find_h2_request_stream(id: u32) i64 {
      for (var i: i64 = 0; i < this.h2.streams.size(); i = i + 1) {
        var pending: ref H2RequestStream = this.h2.streams.get_unchecked(i);
        if (pending.active and pending.id == id) {
          return i;
        }
      }
      return -1;
    }

    // Allocate a reusable request stream slot.
    method open_h2_request_stream(id: u32, cfg: const ref Config) i64 {
      if (this.find_h2_request_stream(id) >= 0 or this.h2.open_streams >= cfg.limits.max_h2_concurrent_streams) {
        return -1;
      }
      for (var i: i64 = 0; i < this.h2.streams.size(); i = i + 1) {
        if (not this.h2.streams.get_unchecked(i).active) {
          this.h2.streams.get_unchecked(i).begin(id, this.h2.headers);
          this.h2.open_streams = this.h2.open_streams + 1;
          return i;
        }
      }
      this.h2.streams.push(H2RequestStream(this.alloc));
      var added: i64 = this.h2.streams.size() - 1;
      this.h2.streams.get_unchecked(added).begin(id, this.h2.headers);
      this.h2.open_streams = this.h2.open_streams + 1;
      return added;
    }

    // Release one request stream and its aggregate body accounting.
    method reset_h2_request_stream(index: i64) void {
      if (index < 0 or index >= this.h2.streams.size()) {
        return;
      }
      var pending: ref H2RequestStream = this.h2.streams.get_unchecked(index);
      if (pending.active) {
        this.h2.buffered_bytes = this.h2.buffered_bytes - pending.body.readable_len();
        this.h2.open_streams = this.h2.open_streams - 1;
        pending.reset();
      }
    }

    // Send a stream-local HTTP/2 reset.
    method h2_send_rst(stream: u32, error_code: u32) void {
      h2_frame(this.wbuf, 4, H2_RST_STREAM, _convert<u8>(0), stream);
      h2_append_u32(this.wbuf, error_code);
    }

    // Store a decoded request header block or dispatch a bodyless request.
    method accept_h2_headers(stream: u32, end_stream: bool, handler: ref IHandler, date: ref DateCache, log: ref Logger, cfg: const ref Config, now_ms: i64, draining: bool) void {
      if (draining) {
        this.h2_send_rst(stream, 7);
        this.h2.headers.clear();
        return;
      }
      if (stream <= this.h2.last_client_stream) {
        this.h2_send_rst(stream, 5);
        this.h2.headers.clear();
        return;
      }
      if (not h2_valid_request_headers(this.h2.headers, cfg.limits)) {
        this.h2_send_rst(stream, 1);
        this.h2.headers.clear();
        return;
      }
      this.h2.last_client_stream = stream;
      this.h2.stream = stream;
      if (this.h2_is_extended_connect()) {
        this.handle_h2_request(handler, date, log, cfg, now_ms);
        return;
      }
      var index: i64 = this.open_h2_request_stream(stream, cfg);
      this.h2.headers.clear();
      if (index < 0) {
        this.h2_send_rst(stream, 7);
        return;
      }
      if (end_stream) {
        this.dispatch_h2_request_stream(index, handler, date, log, cfg, now_ms);
      }
    }

    // Move one completed stream into the shared request view and invoke it.
    method dispatch_h2_request_stream(index: i64, handler: ref IHandler, date: ref DateCache, log: ref Logger, cfg: const ref Config, now_ms: i64) void {
      this.h2.headers.clear();
      this.body_buf.clear();
      if (true) {
        var pending: ref H2RequestStream = this.h2.streams.get_unchecked(index);
        this.h2.stream = pending.id;
        for (var i: i64 = 0; i < pending.headers.size(); i = i + 1) {
          this.h2.headers.push(pending.headers.get_unchecked(i).clone(this.alloc));
        }
        this.body_buf.append_bytes(pending.body.readable_ptr(), pending.body.readable_len());
      }
      this.reset_h2_request_stream(index);
      this.handle_h2_request(handler, date, log, cfg, now_ms);
    }

    // Report whether the current headers request an extended CONNECT.
    method h2_is_extended_connect() bool {
      for (var i: i64 = 0; i < this.h2.headers.size(); i = i + 1) {
        var field: ref H2Header = this.h2.headers.get_unchecked(i);
        if (field.name.equals_literal(":protocol") and field.value.equals_literal("websocket")) {
          return true;
        }
      }
      return false;
    }

    // Convert decoded HTTP/2 headers into the existing handler request view.
    method handle_h2_request(handler: ref IHandler, date: ref DateCache, log: ref Logger, cfg: const ref Config, now_ms: i64) void {
      if (not h2_valid_request_headers(this.h2.headers, cfg.limits)) {
        this.close();
        return;
      }
      var method = String(this.alloc, "");
      var path = String(this.alloc, "");
      var authority = String(this.alloc, "");
      var protocol = String(this.alloc, "");
      var head = ByteBuffer(this.alloc, 512);
      for (var i: i64 = 0; i < this.h2.headers.size(); i = i + 1) {
        var h: ref H2Header = this.h2.headers.get_unchecked(i);
        if (h.name.equals_literal(":method")) {
          method.append(h.value);
        } else if (h.name.equals_literal(":path")) {
          path.append(h.value);
        } else if (h.name.equals_literal(":authority")) {
          authority.append(h.value);
        } else if (h.name.equals_literal(":protocol")) {
          protocol.append(h.value);
        }
      }
      if (method.length() == 0 or path.length() == 0) {
        this.close();
        return;
      }
      head.append_string(method);
      head.append_byte(b' ');
      head.append_string(path);
      head.append_literal(" HTTP/1.1\r\nHost: ");
      head.append_string(authority);
      head.append_literal("\r\n");
      for (var j: i64 = 0; j < this.h2.headers.size(); j = j + 1) {
        var field: ref H2Header = this.h2.headers.get_unchecked(j);
        if (not field.name.starts_with(":") and not field.name.equals_literal("host")) {
          head.append_string(field.name);
          head.append_literal(": ");
          head.append_string(field.value);
          head.append_literal("\r\n");
        }
      }
      head.append_literal("\r\n");
      if (this.request.parse_head(head, head.readable_len(), cfg.limits) != ParseStatus.Complete) {
        this.close();
        return;
      }
      this.request.set_body(this.body_buf, 0, this.body_buf.readable_len());
      if (protocol.equals_literal("websocket")) {
        this.begin_h2_websocket(handler, date, cfg);
        this.request.reset();
        this.h2.headers.clear();
        this.body_buf.clear();
        this.h2.headers_ready = false;
        return;
      }
      this.response.reset();
      handler.handle(this.request, this.response);
      this.queue_h2_response(date, this.h2.stream, cfg.server_header, not this.request.is_head());
      this.served = this.served + 1;
      this.started_ms = now_ms;
      this.bytes_sent = 0;
      this.log_access(log, now_ms);
      this.response.reset();
      this.request.reset();
      this.h2.headers.clear();
      this.body_buf.clear();
      this.h2.headers_ready = false;
      this.want_ = EPOLLIN | EPOLLOUT | EPOLLRDHUP;
    }

    // Set up body reading after the head parsed.
    method begin_body() void {
      this.framing.reset();
      this.body_buf.clear();
      if (this.request.is_chunked()) {
        this.framing.kind = BODY_CHUNKED;
      } else if (this.request.content_length() > 0) {
        this.framing.kind = BODY_LENGTH;
        this.framing.raw_len = this.request.content_length();
      }
    }

    /*
     * Make progress on the body from what rbuf holds. Returns zero when the
     * body is complete, a negative number when more bytes are needed, or an
     * error status.
     */
    method advance_body(cfg: const ref Config) i32 {
      var head: i64 = this.request.head_len();
      if (this.framing.kind == BODY_NONE) {
        this.request.set_body(this.rbuf, 0, 0);
        return 0;
      }
      if (this.framing.kind == BODY_LENGTH) {
        if (this.rbuf.readable_len() < head + this.framing.raw_len) {
          return -1;
        }
        this.request.set_body(this.rbuf, head, this.framing.raw_len);
        return 0;
      }
      return this.decode_chunks(cfg);
    }

    /*
     * Decode chunked framing from rbuf into body_buf. Same results as
     * advance_body().
     */
    method decode_chunks(cfg: const ref Config) i32 {
      var avail: i64 = this.rbuf.readable_len();
      var head: i64 = this.request.head_len();
      while (true) {
        var pos: i64 = head + this.framing.raw_len;
        if (this.framing.chunk_state == CHUNK_DONE) {
          this.request.set_body(this.body_buf, 0, this.body_buf.readable_len());
          return 0;
        }
        if (this.framing.chunk_state == CHUNK_SIZE) {
          var eol: i64 = find_crlf(this.rbuf, pos, avail);
          if (eol < 0) {
            if (avail - pos > MAX_CHUNK_SIZE_LINE) {
              return 400;
            }
            return -1;
          }
          var size: i64 = 0;
          var digits: i64 = 0;
          var i: i64 = pos;
          while (i < eol) {
            var d: i32 = hex_value(this.rbuf.byte_at(i));
            if (d < 0) {
              break;
            }
            size = size * 16 + _convert<i64>(d);
            digits = digits + 1;
            if (digits > 15) {
              return 400;
            }
            i = i + 1;
          }
          if (digits == 0) {
            return 400;
          }
          /*
           * Anything after the digits up to the line end is a chunk
           * extension, which is ignored.
           */
          this.framing.raw_len = eol + 2 - head;
          if (size == 0) {
            this.framing.chunk_state = CHUNK_TRAILERS;
          } else {
            if (this.body_buf.readable_len() + size > cfg.limits.max_body_bytes) {
              return 413;
            }
            this.framing.chunk_remaining = size;
            this.framing.chunk_state = CHUNK_DATA;
          }
          continue;
        }
        if (this.framing.chunk_state == CHUNK_DATA) {
          var have: i64 = avail - pos;
          if (have <= 0) {
            return -1;
          }
          var take: i64 = have;
          if (take > this.framing.chunk_remaining) {
            take = this.framing.chunk_remaining;
          }
          this.body_buf.append_buffer(this.rbuf, pos, take);
          this.framing.raw_len = this.framing.raw_len + take;
          this.framing.chunk_remaining = this.framing.chunk_remaining - take;
          if (this.framing.chunk_remaining == 0) {
            this.framing.chunk_state = CHUNK_DATA_END;
          }
          continue;
        }
        if (this.framing.chunk_state == CHUNK_DATA_END) {
          if (avail - pos < 2) {
            return -1;
          }
          if (this.rbuf.byte_at(pos) != 13 or this.rbuf.byte_at(pos + 1) != 10) {
            return 400;
          }
          this.framing.raw_len = this.framing.raw_len + 2;
          this.framing.chunk_state = CHUNK_SIZE;
          continue;
        }
        // Trailers: lines up to and including an empty one.
        var teol: i64 = find_crlf(this.rbuf, pos, avail);
        if (teol < 0) {
          if (avail - pos > cfg.limits.max_header_bytes) {
            return 431;
          }
          return -1;
        }
        this.framing.raw_len = teol + 2 - head;
        if (teol == pos) {
          this.framing.chunk_state = CHUNK_DONE;
        }
      }
      return -1;
    }

    // Upgrade an HTTP/1.1 request to cleartext HTTP/2 stream 1.
    method try_h2c_upgrade(handler: ref IHandler, date: ref DateCache, cfg: const ref Config) bool {
      if (not cfg.http2 or not this.request.header_equals("upgrade", "h2c")) {
        return false;
      }
      if (not this.request.header_contains_token("connection", "upgrade") or not this.request.header_contains_token("connection", "http2-settings") or not this.request.has_header("http2-settings")) {
        return false;
      }
      var absent_settings = String(this.alloc, "");
      var encoded_settings: String = match this.request.header("http2-settings", this.alloc) {
        Option.Some(value) => value,
        Option.None => absent_settings
      };
      var settings_payload = ByteBuffer(this.alloc, 32);
      if (not h2_decode_settings_header(encoded_settings, settings_payload) or settings_payload.readable_len() % 6 != 0) {
        return false;
      }
      for (var setting: i64 = 0; setting < settings_payload.readable_len(); setting = setting + 6) {
        var identifier: i32 = _convert<i32>(settings_payload.byte_at(setting)) * 256 + _convert<i32>(settings_payload.byte_at(setting + 1));
        var setting_value: u32 = h2_u32(settings_payload, setting + 2);
        if ((identifier == 2 or identifier == 8) and setting_value > 1) {
          return false;
        }
        if (identifier == 4 and setting_value > 2147483647) {
          return false;
        }
        if (identifier == 5 and (setting_value < 16384 or setting_value > 16777215)) {
          return false;
        }
        if (identifier == 4) {
          this.h2.peer_initial_window = _convert<i64>(setting_value);
        } else if (identifier == 5) {
          this.h2.peer_frame_size = _convert<i64>(setting_value);
        } else if (identifier == 8) {
          this.h2.enable_connect = setting_value == 1;
        }
      }
      this.response.reset();
      handler.handle(this.request, this.response);
      this.wbuf.append_literal("HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: h2c\r\n\r\n");
      this.proto = Protocol.Http2;
      this.h2.preface = true;
      this.h2.headers_ready = false;
      this.h2.hpack.reset();
      h2_frame(this.wbuf, 12, H2_SETTINGS, _convert<u8>(0), 0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(3);
      h2_append_u32(this.wbuf, _convert<u32>(cfg.limits.max_h2_concurrent_streams));
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(8);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(0);
      this.wbuf.append_byte(1);
      this.queue_h2_response(date, 1, cfg.server_header, not this.request.is_head());
      this.h2.upgrading = true;
      this.keep_alive = true;
      this.send_body = false;
      return true;
    }

    // Finish the h2c transition after the HTTP/1.1 101 response.
    method finish_h2c_upgrade(cfg: const ref Config) void {
      var used: i64 = this.request.head_len() + this.framing.raw_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      this.request.reset();
      this.response.reset();
      this.body_buf.clear();
      this.wbuf.clear();
      this.h2.upgrading = false;
      this.h2.last_client_stream = 1;
      this.state = ConnState.Http2;
      this.want_ = EPOLLIN | EPOLLRDHUP;
      this.deadline_ms = this.deadline_ms + cfg.timeouts.keep_alive_ms;
    }

    // Report whether the client offered permessage-deflate.
    method websocket_compression_offered() bool {
      var absent = String(this.alloc, "");
      var extensions: String = match this.request.header("sec-websocket-extensions", this.alloc) {
        Option.Some(value) => value,
        Option.None => absent
      };
      return extensions.contains("permessage-deflate");
    }

    // Validate and dispatch an HTTP/1.1 WebSocket opening handshake.
    method try_websocket_upgrade(handler: ref IHandler, date: ref DateCache, cfg: const ref Config) bool {
      if (not this.request.method_is("GET") or this.request.version_minor() != 1) {
        return false;
      }
      if (not this.request.header_contains_token("connection", "upgrade") or not this.request.header_equals("upgrade", "websocket")) {
        return false;
      }
      if (not this.request.header_equals("sec-websocket-version", "13")) {
        this.response.reset();
        this.response.set_status(426);
        this.response.add_header("Sec-WebSocket-Version", "13");
        this.response.set_body("WebSocket version 13 required\n");
        this.keep_alive = false;
        this.send_body = true;
        this.response.serialize_head(this.wbuf, date.value(), false, cfg.server_header);
        this.wbuf.append_bytes(this.response.body_buffer().readable_ptr(), this.response.body_buffer().readable_len());
        return true;
      }
      var missing = String(this.alloc, "");
      var key: String = match this.request.header("sec-websocket-key", this.alloc) {
        Option.Some(v) => v,
        Option.None => missing
      };
      if (not websocket_valid_key(key)) {
        return false;
      }
      var compression_available: bool = cfg.websocket_compression and this.websocket_compression_offered();
      var handshake = WebSocketHandshake(this.alloc, compression_available);
      handler.handle_websocket(this.request, handshake);
      handshake.compression = handshake.compression and compression_available;
      if (handshake.subprotocol.length() > 0 and not this.request.header_contains_token_string("sec-websocket-protocol", handshake.subprotocol)) {
        handshake.reject(400);
      }
      if (not handshake.accepted) {
        this.response.reset();
        this.response.set_status(handshake.reject_status);
        this.response.set_body("WebSocket upgrade rejected\n");
        this.keep_alive = false;
        this.send_body = true;
        this.response.serialize_head(this.wbuf, date.value(), false, cfg.server_header);
        this.wbuf.append_bytes(this.response.body_buffer().readable_ptr(), this.response.body_buffer().readable_len());
        return true;
      }
      var accept = websocket_accept(this.alloc, key);
      this.response.reset();
      this.response.set_status(101);
      this.wbuf.append_literal("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ");
      this.wbuf.append_string(accept);
      this.wbuf.append_literal("\r\n");
      if (handshake.subprotocol.length() > 0) {
        this.wbuf.append_literal("Sec-WebSocket-Protocol: ");
        this.wbuf.append_string(handshake.subprotocol);
        this.wbuf.append_literal("\r\n");
      }
      if (handshake.compression) {
        this.wbuf.append_literal("Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover\r\n");
      }
      this.wbuf.append_literal("\r\n");
      this.ws.activate(cfg.limits.max_body_bytes, handshake.compression);
      this.ws.upgrading = true;
      this.keep_alive = true;
      this.send_body = false;
      return true;
    }

    // Finish switching protocols after the 101 response reaches the client.
    method finish_websocket_upgrade(handler: ref IHandler, cfg: const ref Config) void {
      var used: i64 = this.request.head_len() + this.framing.raw_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      this.request.reset();
      this.response.reset();
      this.body_buf.clear();
      this.wbuf.clear();
      this.ws.upgrading = false;
      this.h2.upgrading = false;
      this.ws.fragmenting = false;
      this.ws.closing = false;
      this.state = ConnState.WebSocket;
      this.want_ = EPOLLIN | EPOLLRDHUP;
      this.deadline_ms = this.deadline_ms + cfg.timeouts.keep_alive_ms;
      var socket = this.ws.handle();
      handler.websocket_open(socket);
    }

    // Run the WebSocket frame state machine until the socket would block.
    method drive_websocket(handler: ref IHandler, cfg: const ref Config) void {
      while (true) {
        var active: bool = this.ws.drain_to(this.wbuf);
        if (this.wbuf.readable_len() > 0) {
          var wr: i64 = this.flush_wbuf();
          if (wr != 0) {
            if (not this.wait_for(wr)) {
              this.close();
            }
            return;
          }
        }
        if (this.ws.closing or not active) {
          this.close();
          return;
        }
        if (this.rbuf.readable_len() < 2) {
          if (not this.fill_rbuf()) {
            return;
          }
          continue;
        }
        var first: u8 = this.rbuf.byte_at(0);
        var second: u8 = this.rbuf.byte_at(1);
        var final_frame: bool = (first & 128) != 0;
        var compressed_frame: bool = (first & 64) != 0;
        var opcode: u8 = first & 15;
        if ((first & 48) != 0 or (second & 128) == 0 or (compressed_frame and (not this.ws.compression or (opcode != 1 and opcode != 2)))) {
          this.websocket_protocol_error(handler, 1002);
          continue;
        }
        var pos: i64 = 2;
        var length: i64 = _convert<i64>(second & 127);
        if (length == 126) {
          if (this.rbuf.readable_len() < 4) {
            if (not this.fill_rbuf()) {
              return;
            }
            continue;
          }
          length = (_convert<i64>(this.rbuf.byte_at(2)) << 8) | _convert<i64>(this.rbuf.byte_at(3));
          pos = 4;
        } else if (length == 127) {
          if (this.rbuf.readable_len() < 10) {
            if (not this.fill_rbuf()) {
              return;
            }
            continue;
          }
          length = 0;
          for (var k: i64 = 2; k < 10; k = k + 1) {
            length = (length << 8) | _convert<i64>(this.rbuf.byte_at(k));
          }
          pos = 10;
        }
        if ((opcode & 8) != 0 and (not final_frame or length > 125)) {
          this.websocket_protocol_error(handler, 1002);
          continue;
        }
        if (length > cfg.limits.max_body_bytes) {
          this.websocket_protocol_error(handler, 1009);
          continue;
        }
        if (this.rbuf.readable_len() < pos + 4 + length) {
          if (not this.fill_rbuf()) {
            return;
          }
          continue;
        }
        var mask_pos: i64 = pos;
        pos = pos + 4;
        var decoded = ByteBuffer(this.alloc, length);
        for (var n: i64 = 0; n < length; n = n + 1) {
          decoded.append_byte(this.rbuf.byte_at(pos + n) ^ this.rbuf.byte_at(mask_pos + n % 4));
        }
        if (opcode == 8) {
          var close_status: i32 = websocket_close_payload_status(decoded, decoded.readable_len());
          if (close_status != 0) {
            this.websocket_protocol_error(handler, close_status);
            continue;
          }
          var code: i32 = 1000;
          if (length >= 2) {
            code = _convert<i32>(decoded.byte_at(0)) * 256 + _convert<i32>(decoded.byte_at(1));
          }
          var socket = this.ws.handle();
          handler.websocket_close(socket, code);
          websocket_append_frame(this.wbuf, _convert<u8>(8), decoded, 0, decoded.readable_len());
          this.ws.closing = true;
        } else if (opcode == 9) {
          websocket_append_frame(this.wbuf, _convert<u8>(10), decoded, 0, decoded.readable_len());
        } else if (opcode == 10) {} else if (opcode == 1 or opcode == 2) {
          if (this.ws.fragmenting) {
            this.websocket_protocol_error(handler, 1002);
            continue;
          }
          this.body_buf.clear();
          this.body_buf.append_buffer(decoded, 0, decoded.readable_len());
          this.ws.fragment_opcode = opcode;
          this.ws.fragment_compressed = compressed_frame;
          this.ws.fragmenting = not final_frame;
          if (final_frame) {
            this.deliver_websocket_message(handler, cfg);
          }
        } else if (opcode == 0) {
          if (not this.ws.fragmenting or this.body_buf.readable_len() + length > cfg.limits.max_body_bytes) {
            this.websocket_protocol_error(handler, 1002);
            continue;
          }
          this.body_buf.append_buffer(decoded, 0, decoded.readable_len());
          if (final_frame) {
            this.ws.fragmenting = false;
            this.deliver_websocket_message(handler, cfg);
          }
        } else {
          this.websocket_protocol_error(handler, 1002);
          continue;
        }
        this.rbuf.consume(pos + length);
        this.rbuf.compact();
      }
    }

    // Accept or reject an RFC 8441 extended CONNECT stream.
    method begin_h2_websocket(handler: ref IHandler, date: ref DateCache, cfg: const ref Config) void {
      var compression_available: bool = cfg.websocket_compression and this.websocket_compression_offered();
      var handshake = WebSocketHandshake(this.alloc, compression_available);
      if (this.h2.enable_connect and this.request.method_is("CONNECT")) {
        handler.handle_websocket(this.request, handshake);
      }
      handshake.compression = handshake.compression and compression_available;
      if (not handshake.accepted) {
        this.response.reset();
        this.response.set_status(handshake.reject_status);
        this.response.set_body("WebSocket connect rejected\n");
        this.queue_h2_response(date, this.h2.stream, cfg.server_header, true);
        return;
      }
      var block = ByteBuffer(this.alloc, 64);
      hpack_status(block, 200, this.alloc);
      if (handshake.subprotocol.length() > 0) {
        var name = String(this.alloc, "sec-websocket-protocol");
        hpack_header(block, name, handshake.subprotocol);
      }
      if (handshake.compression) {
        var extension_name = String(this.alloc, "sec-websocket-extensions");
        var extension_value = String(this.alloc, "permessage-deflate; server_no_context_takeover; client_no_context_takeover");
        hpack_header(block, extension_name, extension_value);
      }
      h2_frame(this.wbuf, block.readable_len(), H2_HEADERS, H2_END_HEADERS, this.h2.stream);
      this.wbuf.append_bytes(block.readable_ptr(), block.readable_len());
      this.ws.activate(cfg.limits.max_body_bytes, handshake.compression);
      this.h2_ws.stream = this.h2.stream;
      this.h2_ws.inbound.clear();
      this.h2_ws.outbound.clear();
      this.h2_ws.send_window = this.h2.peer_initial_window;
      this.h2_ws.end_pending = false;
      var socket = this.ws.handle();
      handler.websocket_open(socket);
    }

    // Process complete WebSocket frames carried by HTTP/2 DATA.
    method process_h2_websocket(handler: ref IHandler, cfg: const ref Config) void {
      var replies = ByteBuffer(this.alloc, 128);
      while (this.h2_ws.inbound.readable_len() >= 2) {
        var first: u8 = this.h2_ws.inbound.byte_at(0);
        var second: u8 = this.h2_ws.inbound.byte_at(1);
        var final_frame: bool = (first & 128) != 0;
        var compressed_frame: bool = (first & 64) != 0;
        var opcode: u8 = first & 15;
        var pos: i64 = 2;
        var length: i64 = _convert<i64>(second & 127);
        if ((second & 128) == 0 or (first & 48) != 0 or (compressed_frame and (not this.ws.compression or (opcode != 1 and opcode != 2)))) {
          this.h2_ws.stream = 0;
          return;
        }
        if (length == 126) {
          if (this.h2_ws.inbound.readable_len() < 4) {
            return;
          }
          length = (_convert<i64>(this.h2_ws.inbound.byte_at(2)) << 8) | _convert<i64>(this.h2_ws.inbound.byte_at(3));
          pos = 4;
        } else if (length == 127) {
          if (this.h2_ws.inbound.readable_len() < 10) {
            return;
          }
          length = 0;
          for (var k: i64 = 2; k < 10; k = k + 1) {
            length = (length << 8) | _convert<i64>(this.h2_ws.inbound.byte_at(k));
          }
          pos = 10;
        }
        if (length > cfg.limits.max_body_bytes or this.h2_ws.inbound.readable_len() < pos + 4 + length) {
          return;
        }
        var mask_pos: i64 = pos;
        pos = pos + 4;
        var decoded = ByteBuffer(this.alloc, length);
        for (var n: i64 = 0; n < length; n = n + 1) {
          decoded.append_byte(this.h2_ws.inbound.byte_at(pos + n) ^ this.h2_ws.inbound.byte_at(mask_pos + n % 4));
        }
        if ((opcode & 8) != 0 and (not final_frame or length > 125)) {
          this.websocket_protocol_error(handler, 1002);
          return;
        }
        if (opcode == 9) {
          websocket_append_frame(replies, _convert<u8>(10), decoded, 0, decoded.readable_len());
        } else if (opcode == 10) {} else if (opcode == 8) {
          var close_status: i32 = websocket_close_payload_status(decoded, decoded.readable_len());
          if (close_status != 0) {
            this.websocket_protocol_error(handler, close_status);
            return;
          }
          var code: i32 = 1000;
          if (length >= 2) {
            code = _convert<i32>(decoded.byte_at(0)) * 256 + _convert<i32>(decoded.byte_at(1));
          }
          var socket = this.ws.handle();
          handler.websocket_close(socket, code);
          websocket_append_frame(replies, _convert<u8>(8), decoded, 0, decoded.readable_len());
          this.ws.deactivate();
        } else if (opcode == 1 or opcode == 2) {
          if (this.ws.fragmenting) {
            this.websocket_protocol_error(handler, 1002);
            return;
          }
          this.body_buf.clear();
          this.body_buf.append_buffer(decoded, 0, decoded.readable_len());
          this.ws.fragment_opcode = opcode;
          this.ws.fragment_compressed = compressed_frame;
          this.ws.fragmenting = not final_frame;
          if (final_frame) {
            this.deliver_websocket_message(handler, cfg);
          }
        } else if (opcode == 0) {
          if (not this.ws.fragmenting or this.body_buf.readable_len() + length > cfg.limits.max_body_bytes) {
            this.websocket_protocol_error(handler, 1002);
            return;
          }
          this.body_buf.append_buffer(decoded, 0, decoded.readable_len());
          if (final_frame) {
            this.ws.fragmenting = false;
            this.deliver_websocket_message(handler, cfg);
          }
        } else {
          this.websocket_protocol_error(handler, 1002);
          return;
        }
        this.h2_ws.inbound.consume(pos + length);
        this.h2_ws.inbound.compact();
      }
      if (replies.readable_len() > 0) {
        this.h2_ws.outbound.append_buffer(replies, 0, replies.readable_len());
        this.flush_h2_websocket_data();
      }
    }

    // Deliver one assembled data message to the application.
    method deliver_websocket_message(handler: ref IHandler, cfg: const ref Config) void {
      var message_data = ByteBuffer(this.alloc, this.body_buf.readable_len());
      if (this.ws.fragment_compressed) {
        var inflate_status: i32 = websocket_inflate(this.alloc, this.body_buf, 0, this.body_buf.readable_len(), cfg.limits.max_body_bytes, message_data);
        if (inflate_status != 0) {
          if (inflate_status == 2) {
            this.websocket_protocol_error(handler, 1009);
          } else {
            this.websocket_protocol_error(handler, 1002);
          }
          this.body_buf.clear();
          this.ws.fragment_compressed = false;
          return;
        }
      } else {
        message_data.append_buffer(this.body_buf, 0, this.body_buf.readable_len());
      }
      if (this.ws.fragment_opcode == 1 and not websocket_valid_utf8(message_data, 0, message_data.readable_len())) {
        this.websocket_protocol_error(handler, 1007);
        this.body_buf.clear();
        this.ws.fragment_compressed = false;
        return;
      }
      var kind: WebSocketMessageKind = WebSocketMessageKind.Binary;
      if (this.ws.fragment_opcode == 1) {
        kind = WebSocketMessageKind.Text;
      }
      var message = WebSocketMessage(kind, message_data);
      var socket = this.ws.handle();
      handler.websocket_message(socket, message);
      this.body_buf.clear();
      this.ws.fragment_compressed = false;
    }

    // Notify the application and start a protocol-error close.
    method websocket_protocol_error(handler: ref IHandler, code: i32) void {
      var socket = this.ws.handle();
      handler.websocket_error(socket, code);
      var bytes = ByteBuffer(this.alloc, 2);
      bytes.append_byte(_convert<u8>((code >> 8) & 255));
      bytes.append_byte(_convert<u8>(code & 255));
      if (this.h2_ws.stream != 0) {
        var close_frame = ByteBuffer(this.alloc, 4);
        websocket_append_frame(close_frame, _convert<u8>(8), bytes, 0, 2);
        this.h2_ws.outbound.append_buffer(close_frame, 0, close_frame.readable_len());
        this.h2_ws.end_pending = true;
        this.flush_h2_websocket_data();
        this.h2_ws.inbound.clear();
        this.ws.deactivate();
      } else {
        websocket_append_frame(this.wbuf, _convert<u8>(8), bytes, 0, 2);
        this.ws.closing = true;
        this.rbuf.clear();
      }
    }

    // Run the handler and serialize its response into wbuf.
    method handle_request(handler: ref IHandler, date: ref DateCache, cfg: const ref Config, draining: bool) void {
      this.response.reset();
      this.keep_alive = this.request.keep_alive() and not draining;
      if (not draining and this.try_h2c_upgrade(handler, date, cfg)) {
        return;
      }
      if (not draining and this.try_websocket_upgrade(handler, date, cfg)) {
        return;
      }
      this.send_body = not this.request.is_head();
      handler.handle(this.request, this.response);
      if (this.response.wants_close()) {
        this.keep_alive = false;
      }
      if (status_has_no_body(this.response.status)) {
        this.send_body = false;
      }
      this.bytes_sent = 0;
      this.response.serialize_head(this.wbuf, date.value(), this.keep_alive, cfg.server_header);
      if (this.send_body) {
        var body: ref ByteBuffer = this.response.body_buffer();
        this.wbuf.append_bytes(body.readable_ptr(), body.readable_len());
      }
    }

    // Answer a malformed or oversized request and close afterwards.
    method send_error(status: i32, date: ref DateCache, cfg: const ref Config) void {
      this.response.reset();
      this.response.set_status(status);
      this.response.set_content_type("text/plain");
      this.response.set_body(reason_phrase(status));
      this.response.append_body("\n");
      this.keep_alive = false;
      this.send_body = true;
      this.bytes_sent = 0;
      this.response.serialize_head(this.wbuf, date.value(), false, cfg.server_header);
      var body: ref ByteBuffer = this.response.body_buffer();
      this.wbuf.append_bytes(body.readable_ptr(), body.readable_len());
      this.state = ConnState.Writing;
    }

    // Write wbuf out. Returns zero when empty, else an IO_* value.
    method flush_wbuf() i64 {
      while (this.wbuf.readable_len() > 0) {
        var n: i64 = this.transport.write(this.wbuf.readable_ptr(), this.wbuf.readable_len());
        if (n > 0) {
          this.wbuf.consume(n);
          this.bytes_sent = this.bytes_sent + n;
          continue;
        }
        if (n == IO_CLOSED) {
          return IO_ERROR;
        }
        return n;
      }
      return 0;
    }

    /*
     * Write the response head, body, and any streamed file. Returns zero when
     * everything was sent, else an IO_* value.
     */
    method write_response() i64 {
      while (true) {
        var r: i64 = this.flush_wbuf();
        if (r != 0) {
          return r;
        }
        if (this.send_body and this.response.has_file_body()) {
          var before: i64 = this.response.file_bytes_remaining();
          var n: i64 = this.response.read_file_chunk(this.wbuf, FILE_CHUNK);
          if (n == 0 and before > 0) {
            /*
             * The file shrank or failed mid-stream; the response is short,
             * so the connection must not be reused.
             */
            this.keep_alive = false;
            return 0;
          }
          continue;
        }
        return 0;
      }
      return 0;
    }

    // Discard the finished request's bytes and get ready for the next one.
    method finish_request() void {
      var used: i64 = this.request.head_len() + this.framing.raw_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      this.rbuf.shrink_to(IDLE_BUFFER_CAP);
      this.wbuf.clear();
      this.wbuf.shrink_to(IDLE_BUFFER_CAP);
      this.body_buf.clear();
      this.body_buf.shrink_to(16);
      this.response.reset();
      this.request.reset();
      this.framing.continue_sent = false;
      this.state = ConnState.ReadingHead;
      this.want_ = EPOLLIN | EPOLLRDHUP;
    }

    // Write one access log line for the response just sent.
    method log_access(log: ref Logger, now_ms: i64) void {
      if (not log.access_enabled()) {
        return;
      }
      var entry = ByteBuffer(this.alloc, 256);
      if (this.transport.is_tls()) {
        entry.append_literal("https ");
      } else {
        entry.append_literal("http ");
      }
      entry.append_byte(b'"');
      var method: String = this.request.method_text(this.alloc);
      if (method.length() == 0) {
        entry.append_literal("-");
      } else {
        entry.append_string(method);
        entry.append_byte(b' ');
        var target: String = this.request.raw_target(this.alloc);
        entry.append_string(target);
      }
      entry.append_literal("\" ");
      entry.append_i64(_convert<i64>(this.response.status));
      entry.append_byte(b' ');
      entry.append_i64(this.bytes_sent);
      entry.append_byte(b' ');
      entry.append_i64(now_ms - this.started_ms);
      entry.append_literal("ms");
      log.access(entry);
    }
  }
}
