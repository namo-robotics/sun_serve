/*
 * connection.sun - One client connection's state machine
 *
 * A Connection owns a transport and the buffers for the request being read
 * and the response being written. The worker calls on_event() whenever epoll
 * reports the socket ready; the connection then runs as far as it can without
 * blocking and records which readiness it needs next in want(). Every request
 * on a keep-alive connection passes through the same states in turn.
 */

/*
 * Drives client connections through the supported protocols.
 */
public module sun_serve {

  using std;

  enum ConnState { Vacant, Handshaking, ReadingHead, ReadingBody, Writing, WebSocket, Http2, Closed }

  // The application protocol selected for a connection.
  public enum Protocol { Http1, Http2 }

  // How the request body is framed.
  enum BodyKind { None, Length, Chunked }

  // Chunked decoder states.
  enum ChunkState { Size, Data, DataEnd, Trailers, Done }

  const READ_CHUNK: i64 = 16384;
  const FILE_CHUNK: i64 = 65536;
  const IDLE_BUFFER_CAP: i64 = 65536;
  const MAX_CHUNK_SIZE_LINE: i64 = 64;
  // The largest chunk-size digit count accepted before the value is rejected.
  const MAX_CHUNK_SIZE_DIGITS: i64 = 15;

  // How the HTTP/1 request body is framed and how much of it has arrived.
  class BodyFraming {
    var kind: BodyKind = BodyKind.None;
    var raw_len: i64 = 0;  // bytes after the head belonging to this request
    var chunk_state: ChunkState = ChunkState.Size;
    var chunk_remaining: i64 = 0;
    var continue_sent: bool = false;

    // Forget the previous request's body.
    method reset() void {
      this.kind = BodyKind.None;
      this.raw_len = 0;
      this.chunk_state = ChunkState.Size;
      this.chunk_remaining = 0;
      this.continue_sent = false;
    }
  }

  // Drives one client through parsing, dispatch, and response delivery.
  public class Connection {
    var transport: Transport = Transport();
    var state: ConnState = ConnState.Vacant;
    var proto: Protocol = Protocol.Http1;
    var interest: u32 = 0;  // the mask the worker registered last
    var want_: u32 = 0;  // the mask the connection needs now
    var rbuf: ByteBuffer;  // inbound bytes; the current request stays put
    var body_buf: ByteBuffer;  // decoded chunked body or reassembled WebSocket message
    var wbuf: ByteBuffer;  // serialized response
    var request: Request;
    var response: Response;
    var framing: BodyFraming = BodyFraming();
    var h2: H2ConnectionState;
    var h2_ws: H2WebSocketTunnel;
    var ws: WebSocketState;
    var keep_alive: bool = false;
    var send_body: bool = true;
    var peer_closed: bool = false;
    var served: i64 = 0;
    var deadline_ms: i64 = 0;
    var started_ms: i64 = 0;
    var bytes_sent: i64 = 0;
    var alloc: HeapAllocator;

    // Build a vacant connection with its buffers ready.
    init(allocator: const ref HeapAllocator) std.AllocationResult<void> {
      this.alloc = allocator.copy();
      this.rbuf = try ByteBuffer(allocator, 8192);
      this.body_buf = try ByteBuffer(allocator, 16);
      this.wbuf = try ByteBuffer(allocator, 16384);
      this.request = try Request(allocator);
      this.response = try Response(allocator);
      this.h2 = try H2ConnectionState(allocator);
      this.h2_ws = try H2WebSocketTunnel(allocator);
      this.ws = try WebSocketState(allocator);
    }

    /*
     * Take over an accepted socket. For TLS the handshake starts on the first
     * event. Returns false if a TLS session could not be created.
     */
    public method open(
      fd: i32,
      tls: bool,
      acceptor: ref TlsAcceptor,
      now_ms: i64,
      timeouts: const ref Timeouts,
      wake_fd: i32
    ) bool {
      if (not this.transport.open(fd, tls, acceptor)) {
        return false;
      }
      this.interest = 0;
      this.want_ = EPOLLIN;
      this.served = 0;
      this.peer_closed = false;
      this.proto = Protocol.Http1;
      this.rbuf.clear();
      this.wbuf.clear();
      this.body_buf.clear();
      this.h2.reset();
      this.h2_ws.reset();
      this.ws.reset(wake_fd);
      if (tls) {
        this.state = ConnState.Handshaking;
        this.deadline_ms = now_ms + timeouts.handshake_ms;
      } else {
        this.state = ConnState.ReadingHead;
        this.deadline_ms = now_ms + timeouts.header_ms;
      }
      this.started_ms = now_ms;
      return true;
    }

    // Report whether the socket is still open.
    public const method is_open() bool {
      return this.transport.is_open();
    }

    // The socket descriptor.
    public const method get_fd() i32 {
      return this.transport.get_fd();
    }

    // The readiness mask the connection needs next.
    public const method want() u32 {
      return this.want_;
    }

    // The readiness mask registered with epoll.
    public const method registered() u32 {
      return this.interest;
    }

    // Record the mask the worker registered.
    public method set_registered(mask: u32) void {
      this.interest = mask;
    }

    /*
     * Report whether the connection is between requests with nothing
     * buffered, so it can be dropped at shutdown without losing anything.
     */
    public const method is_idle() bool {
      return this.state == ConnState.ReadingHead and this.rbuf.is_empty() and this.served > 0;
    }

    // Report whether this connection needs asynchronous WebSocket polling.
    public const method is_websocket() bool {
      return this.state == ConnState.WebSocket or
        (this.state == ConnState.Http2 and this.h2_ws.stream != 0);
    }

    // Report whether the connection is sending a response.
    public const method is_writing() bool {
      return this.state == ConnState.Writing;
    }

    // Report whether the current state's deadline has passed.
    public const method expired(now_ms: i64) bool {
      return this.state != ConnState.Vacant and now_ms >= this.deadline_ms;
    }

    /*
     * Close the socket and return to the vacant state, releasing memory a
     * large request may have grown.
     */
    public method close() std.AllocationResult<void> {
      this.transport.close();
      this.state = ConnState.Vacant;
      this.want_ = 0;
      this.interest = 0;
      this.response.reset();
      this.request.reset();
      this.rbuf.clear();
      this.wbuf.clear();
      this.body_buf.clear();
      this.ws.deactivate();
      this.h2.headers.clear();
      this.h2.headers_ready = false;
      try this.rbuf.shrink_to(IDLE_BUFFER_CAP);
      try this.wbuf.shrink_to(IDLE_BUFFER_CAP);
      try this.body_buf.shrink_to(16);

      return std.AllocationResult.Ok;
    }

    // Queue protocol-specific graceful shutdown notifications.
    public method begin_shutdown() std.AllocationResult<void> {
      if (this.state == ConnState.WebSocket) {
        try websocket_append_close(this.wbuf, WS_CLOSE_GOING_AWAY);
        this.ws.closing = true;
        this.ws.deactivate();
        this.want_ = EPOLLOUT;
      } else if (this.state == ConnState.Http2) {
        if (this.h2_ws.stream != 0) {
          try websocket_append_close(this.h2_ws.outbound, WS_CLOSE_GOING_AWAY);
          this.h2_ws.end_pending = true;
          this.ws.deactivate();
        }
        try h2_frame(this.wbuf, 8, H2FrameKind.Goaway, 0, 0);
        try h2_append_u32(this.wbuf, this.h2.last_client_stream);
        try h2_append_u32(this.wbuf, 0);
        this.want_ = EPOLLIN | EPOLLOUT | EPOLLRDHUP;
      }
    
      return std.AllocationResult.Ok;
}

    /*
     * Run the state machine for a readiness event. peer_hup says the peer
     * closed its side; draining says the server is shutting down and no
     * further requests should be accepted on this connection.
     */
    public method on_event(
      mask: u32,
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64,
      draining: bool
    ) std.AllocationResult<void> {
      if ((mask & EPOLLERR) != 0) {
        try this.close();
        return std.AllocationResult.Ok;
      }
      if ((mask & (EPOLLHUP | EPOLLRDHUP)) != 0) {
        this.peer_closed = true;
      }
      try this.drive(handler, date, log, cfg, now_ms, draining);
    
      return std.AllocationResult.Ok;
}

    // Advance through as many states as the socket allows.
    method drive(
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64,
      draining: bool
    ) std.AllocationResult<void> {
      while (true) {
        if (this.state == ConnState.Handshaking) {
          var r: i64 = this.transport.handshake();
          if (r == 0) {
            if (not try this.select_protocol()) {
              try log.log(LogLevel.Debug, "closing connection: negotiated protocol not supported");
              try this.close();
              return std.AllocationResult.Ok;
            }
            if (this.proto == Protocol.Http2) {
              try this.start_http2(now_ms, cfg);
            } else {
              this.state = ConnState.ReadingHead;
              this.deadline_ms = now_ms + cfg.timeouts.header_ms;
            }
            continue;
          }
          if (not this.wait_for(r)) {
            try this.close();
          }
          return std.AllocationResult.Ok;
        }
        if (this.state == ConnState.WebSocket) {
          try this.drive_websocket(handler, cfg);
          return std.AllocationResult.Ok;
        }
        if (this.state == ConnState.Http2) {
          try this.drive_http2(handler, date, log, cfg, now_ms, draining);
          return std.AllocationResult.Ok;
        }
        if (this.state == ConnState.ReadingHead) {
          if (cfg.http2 and not this.transport.is_tls() and this.rbuf.readable_len() > 0) {
            var preface: i32 = this.h2_preface_status();
            if (preface > 0) {
              try this.start_http2(now_ms, cfg);
              continue;
            }
            if (preface == 0) {
              if (not (try this.fill_rbuf())) {
                return std.AllocationResult.Ok;
              }
              continue;
            }
          }
          if (this.rbuf.readable_len() > 0) {
            var st: ParseStatus = try this.request.parse_head(
              this.rbuf,
              this.rbuf.readable_len(),
              cfg.limits
            );
            if (st == ParseStatus.Complete) {
              this.started_ms = now_ms;
              this.begin_body();
              this.state = ConnState.ReadingBody;
              this.deadline_ms = now_ms + cfg.timeouts.body_ms;
              continue;
            }
            if (st == ParseStatus.Failed) {
              this.started_ms = now_ms;
              try this.send_error(this.request.error_status(), date, cfg);
              this.deadline_ms = now_ms + cfg.timeouts.write_ms;
              continue;
            }
          }
          if (not (try this.fill_rbuf())) {
            return std.AllocationResult.Ok;
          }
          continue;
        }
        if (this.state == ConnState.ReadingBody) {
          var body_status: i32 = try this.advance_body(cfg);
          if (body_status == 0) {
            try this.handle_request(handler, date, cfg, draining);
            this.state = ConnState.Writing;
            this.deadline_ms = now_ms + cfg.timeouts.write_ms;
            continue;
          }
          if (body_status > 0) {
            try this.send_error(body_status, date, cfg);
            this.deadline_ms = now_ms + cfg.timeouts.write_ms;
            continue;
          }
          if (this.request.expects_continue() and not this.framing.continue_sent) {
            this.framing.continue_sent = true;
            try this.wbuf.append_literal("HTTP/1.1 100 Continue\r\n\r\n");
            var fr: i64 = this.flush_wbuf();
            if (fr == IO_ERROR) {
              try this.close();
              return std.AllocationResult.Ok;
            }
          }
          if (not (try this.fill_rbuf())) {
            return std.AllocationResult.Ok;
          }
          continue;
        }
        if (this.state == ConnState.Writing) {
          var w: i64 = try this.write_response();
          if (w == 0) {
            this.served = this.served + 1;
            try this.log_access(log, now_ms);
            if (this.ws.upgrading) {
              try this.finish_websocket_upgrade(handler, cfg);
              continue;
            }
            if (this.h2.upgrading) {
              this.finish_h2c_upgrade(cfg);
              continue;
            }
            if (not this.keep_alive or this.peer_closed) {
              try this.close();
              return std.AllocationResult.Ok;
            }
            try this.finish_request();
            this.deadline_ms = now_ms + cfg.timeouts.keep_alive_ms;
            continue;
          }
          if (not this.wait_for(w)) {
            try this.close();
          }
          return std.AllocationResult.Ok;
        }
        return std.AllocationResult.Ok;
      }

      return std.AllocationResult.Ok;
    }

    /*
     * Translate an IO_* wait value into the next interest mask. Returns false
     * when the value means the connection is finished.
     */
    method wait_for(r: i64) bool {
      if (r == IO_WANT_READ) {
        this.want_ = EPOLLIN | EPOLLRDHUP;
        return true;
      }
      if (r == IO_WANT_WRITE) {
        this.want_ = EPOLLOUT;
        return true;
      }
      return false;
    }

    // After a TLS handshake, adopt the negotiated application protocol.
    method select_protocol() std.AllocationResult<bool> {
      var name: String = try this.transport.alpn(this.alloc);
      if (name.equals_literal("h2")) {
        this.proto = Protocol.Http2;
      } else {
        this.proto = Protocol.Http1;
      }
      return std.AllocationResult.Ok(true);
    }

    /*
     * Read more bytes into rbuf. Returns true when bytes arrived, false when
     * the caller must return to the event loop (want() is set) or the
     * connection was closed.
     */
    method fill_rbuf() std.AllocationResult<bool> {
      try this.rbuf.reserve(READ_CHUNK);
      var n: i64 = this.transport.read(this.rbuf.writable_ptr(), this.rbuf.writable_len());
      if (n > 0) {
        this.rbuf.commit(n);
        // TLS may hold decrypted bytes that epoll will never announce.
        while (this.transport.pending() > 0) {
          try this.rbuf.reserve(READ_CHUNK);
          var more: i64 = this.transport.read(this.rbuf.writable_ptr(), this.rbuf.writable_len());
          if (more <= 0) {
            break;
          }
          this.rbuf.commit(more);
        }
        return std.AllocationResult.Ok(true);
      }
      if (n == IO_CLOSED) {
        try this.close();
        return std.AllocationResult.Ok(false);
      }
      if (not this.wait_for(n)) {
        try this.close();
      }
      return std.AllocationResult.Ok(false);
    }

    /*
     * Compare buffered cleartext bytes with the HTTP/2 client preface:
     * positive when it is complete, zero when more bytes could still match,
     * negative when the bytes are something else.
     */
    method h2_preface_status() i32 {
      var have: i64 = this.rbuf.readable_len();
      var check: i64 = have;
      if (check > H2_PREFACE.length()) {
        check = H2_PREFACE.length();
      }
      for (var i: i64 = 0; i < check; i = i + 1) {
        if (this.rbuf.byte_at(i) != literal_byte(H2_PREFACE, i)) {
          return -1;
        }
      }
      if (have < H2_PREFACE.length()) {
        return 0;
      }
      return 1;
    }

    // Enter HTTP/2 and queue the server settings.
    method start_http2(now_ms: i64, cfg: const ref Config) std.AllocationResult<void> {
      this.proto = Protocol.Http2;
      this.state = ConnState.Http2;
      this.h2.preface = true;
      this.h2.headers_ready = false;
      this.h2.headers.clear();
      this.body_buf.clear();
      this.deadline_ms = now_ms + cfg.timeouts.keep_alive_ms;
      try h2_append_settings(this.wbuf, cfg.limits.max_h2_concurrent_streams);
      this.want_ = EPOLLIN | EPOLLOUT | EPOLLRDHUP;
    
      return std.AllocationResult.Ok;
}

    // Process HTTP/2 frames until the transport would block.
    method drive_http2(
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64,
      draining: bool
    ) std.AllocationResult<void> {
      while (true) {
        if (this.h2_ws.stream != 0) {
          var websocket_active: bool = try this.ws.drain_to(this.h2_ws.outbound);
          if (not websocket_active) {
            this.h2_ws.end_pending = true;
          }
          try this.flush_h2_websocket_data();
        }
        try this.flush_h2_response_data();
        if (this.wbuf.readable_len() > 0) {
          var wr: i64 = this.flush_wbuf();
          if (wr != 0) {
            if (not this.wait_for(wr)) {
              try this.close();
            }
            return std.AllocationResult.Ok;
          }
          this.want_ = EPOLLIN | EPOLLRDHUP;
        }
        if (this.h2.preface) {
          if (this.rbuf.readable_len() < H2_PREFACE.length()) {
            if (not (try this.fill_rbuf())) {
              return std.AllocationResult.Ok;
            }
            continue;
          }
          if (this.h2_preface_status() <= 0) {
            try this.close();
            return std.AllocationResult.Ok;
          }
          this.rbuf.consume(H2_PREFACE.length());
          this.h2.preface = false;
        }
        if (this.rbuf.readable_len() < H2_FRAME_HEADER_LEN) {
          if (not (try this.fill_rbuf())) {
            return std.AllocationResult.Ok;
          }
          continue;
        }
        var frame_len: i64 = h2_frame_len(this.rbuf, 0);
        if (frame_len > H2_DEFAULT_FRAME_SIZE) {
          try this.close();
          return std.AllocationResult.Ok;
        }
        if (this.rbuf.readable_len() < H2_FRAME_HEADER_LEN + frame_len) {
          if (not (try this.fill_rbuf())) {
            return std.AllocationResult.Ok;
          }
          continue;
        }
        var flags: u8 = this.rbuf.byte_at(4);
        var stream: u32 = h2_u32(this.rbuf, 5) & H2_STREAM_ID_MASK;
        // Only CONTINUATION may follow an unfinished header block.
        if (this.h2.continuation_stream != 0 and
          this.rbuf.byte_at(3) != _convert<u8>(H2FrameKind.Continuation)) {
          try this.close();
          return std.AllocationResult.Ok;
        }
        // Unknown frame types are ignored, as the protocol requires.
        var kind: H2FrameKind = match h2_frame_kind(this.rbuf, 0) {
          Option.Some(value) => value,
          Option.None => {
            this.finish_h2_frame(frame_len, now_ms, cfg);
            continue;
          }
        };
        if (not try this.handle_h2_frame(
          kind,
          flags,
          stream,
          frame_len,
          handler,
          date,
          log,
          cfg,
          now_ms,
          draining
        )) {
          try this.close();
          return std.AllocationResult.Ok;
        }
        this.finish_h2_frame(frame_len, now_ms, cfg);
      }

      return std.AllocationResult.Ok;
    }

    // Discard a processed frame and extend the connection's idle deadline.
    method finish_h2_frame(frame_len: i64, now_ms: i64, cfg: const ref Config) void {
      this.rbuf.consume(H2_FRAME_HEADER_LEN + frame_len);
      this.rbuf.compact();
      this.deadline_ms = now_ms + cfg.timeouts.keep_alive_ms;
    }

    /*
     * Process one complete frame whose payload starts at H2_FRAME_HEADER_LEN
     * in rbuf. Returns false for a connection error, which closes the
     * connection.
     */
    method handle_h2_frame(
      kind: H2FrameKind,
      flags: u8,
      stream: u32,
      frame_len: i64,
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64,
      draining: bool
    ) std.AllocationResult<bool> {
      var payload: i64 = H2_FRAME_HEADER_LEN;
      match kind {
        H2FrameKind.Settings => {
          return std.AllocationResult.Ok(try this.handle_h2_settings(flags, stream, frame_len));
        },
        H2FrameKind.Ping => {
          if (stream != 0 or frame_len != 8) {
            return std.AllocationResult.Ok(false);
          }
          if ((flags & H2_ACK) == 0) {
            try h2_frame(this.wbuf, 8, H2FrameKind.Ping, H2_ACK, 0);
            try this.wbuf.append_buffer(this.rbuf, payload, 8);
          }
          return std.AllocationResult.Ok(true);
        },
        H2FrameKind.Headers => {
          if (stream == 0 or (stream & 1) == 0) {
            return std.AllocationResult.Ok(false);
          }
          var fragment_pos: i64 = 0;
          var fragment_len: i64 = frame_len;
          if ((flags & H2_PADDED) != 0) {
            if (fragment_len < 1) {
              return std.AllocationResult.Ok(false);
            }
            var padding: i64 = _convert<i64>(this.rbuf.byte_at(payload));
            fragment_pos = 1;
            fragment_len = fragment_len - 1 - padding;
            if (fragment_len < 0) {
              return std.AllocationResult.Ok(false);
            }
          }
          if ((flags & H2_PRIORITY_FLAG) != 0) {
            if (fragment_len < 5) {
              return std.AllocationResult.Ok(false);
            }
            fragment_pos = fragment_pos + 5;
            fragment_len = fragment_len - 5;
          }
          this.h2.headers.clear();
          this.body_buf.clear();
          this.h2.header_block.clear();
          try this.h2.header_block.append_buffer(this.rbuf, payload + fragment_pos, fragment_len);
          this.h2.header_end_stream = (flags & H2_END_STREAM) != 0;
          if ((flags & H2_END_HEADERS) == 0) {
            this.h2.continuation_stream = stream;
            return std.AllocationResult.Ok(true);
          }
          return std.AllocationResult.Ok(try this.finish_h2_header_block(stream, handler, date, log, cfg, now_ms, draining));
        },
        H2FrameKind.Continuation => {
          if (stream == 0 or stream != this.h2.continuation_stream) {
            return std.AllocationResult.Ok(false);
          }
          try this.h2.header_block.append_buffer(this.rbuf, payload, frame_len);
          if ((flags & H2_END_HEADERS) == 0) {
            return std.AllocationResult.Ok(true);
          }
          this.h2.continuation_stream = 0;
          return std.AllocationResult.Ok(try this.finish_h2_header_block(stream, handler, date, log, cfg, now_ms, draining));
        },
        H2FrameKind.Data => {
          if (stream == 0) {
            return std.AllocationResult.Ok(false);
          }
          var data_pos: i64 = 0;
          var data_len: i64 = frame_len;
          if ((flags & H2_PADDED) != 0) {
            if (data_len < 1) {
              return std.AllocationResult.Ok(false);
            }
            var data_padding: i64 = _convert<i64>(this.rbuf.byte_at(payload));
            data_pos = 1;
            data_len = data_len - 1 - data_padding;
            if (data_len < 0) {
              return std.AllocationResult.Ok(false);
            }
          }
          if (stream == this.h2_ws.stream) {
            try this.h2_ws.inbound.append_buffer(this.rbuf, payload + data_pos, data_len);
            try this.process_h2_websocket(handler, cfg);
            if ((flags & H2_END_STREAM) != 0) {
              handler.websocket_close(try this.ws.handle(), 1000);
              this.ws.deactivate();
              this.h2_ws.stream = 0;
            }
          } else {
            try this.receive_h2_request_data(
              stream,
              payload + data_pos,
              data_len,
              (flags & H2_END_STREAM) != 0,
              handler,
              date,
              log,
              cfg,
              now_ms
            );
          }
          if (frame_len > 0) {
            try this.h2_send_window_update(0, frame_len);
            try this.h2_send_window_update(stream, frame_len);
          }
          return std.AllocationResult.Ok(true);
        },
        H2FrameKind.Priority => {
          return std.AllocationResult.Ok(stream != 0 and frame_len == 5);
        },
        H2FrameKind.WindowUpdate => {
          var increment: i64 = 0;
          if (frame_len == 4) {
            increment = _convert<i64>(h2_u32(this.rbuf, payload) & H2_STREAM_ID_MASK);
          }
          if (increment == 0) {
            return std.AllocationResult.Ok(false);
          }
          if (stream == 0) {
            if (this.h2.send_window + increment > H2_MAX_WINDOW) {
              return std.AllocationResult.Ok(false);
            }
            this.h2.send_window = this.h2.send_window + increment;
          } else if (stream == this.h2_ws.stream) {
            if (this.h2_ws.send_window + increment > H2_MAX_WINDOW) {
              return std.AllocationResult.Ok(false);
            }
            this.h2_ws.send_window = this.h2_ws.send_window + increment;
          } else {
            var response_index: i64 = this.find_h2_response_stream(stream);
            if (response_index >= 0) {
              var next_window: i64 = this.h2.responses[response_index].window + increment;
              if (next_window > H2_MAX_WINDOW) {
                return std.AllocationResult.Ok(false);
              }
              this.h2.responses[response_index].window = next_window;
            }
          }
          return std.AllocationResult.Ok(true);
        },
        H2FrameKind.RstStream => {
          if (stream == 0 or frame_len != 4) {
            return std.AllocationResult.Ok(false);
          }
          var reset_index: i64 = this.find_h2_request_stream(stream);
          if (reset_index >= 0) {
            this.reset_h2_request_stream(reset_index);
          }
          var reset_response: i64 = this.find_h2_response_stream(stream);
          if (reset_response >= 0) {
            this.h2.responses[reset_response].reset();
          }
          if (stream == this.h2_ws.stream) {
            this.ws.deactivate();
            this.h2_ws.stream = 0;
            this.h2_ws.outbound.clear();
            this.h2_ws.end_pending = false;
          }
          return std.AllocationResult.Ok(true);
        },
        // The peer is leaving; a server never accepts pushed streams.
        H2FrameKind.Goaway => {
          return std.AllocationResult.Ok(false);
        },
        H2FrameKind.PushPromise => {
          return std.AllocationResult.Ok(false);
        }
      };
      return std.AllocationResult.Ok(true);
    }

    // Apply a SETTINGS frame and acknowledge it. Returns false on a protocol error.
    method handle_h2_settings(flags: u8, stream: u32, frame_len: i64) std.AllocationResult<bool> {
      if (stream != 0 or ((flags & H2_ACK) != 0 and frame_len != 0) or
        ((flags & H2_ACK) == 0 and frame_len % 6 != 0)) {
        return std.AllocationResult.Ok(false);
      }
      if ((flags & H2_ACK) != 0) {
        return std.AllocationResult.Ok(true);
      }
      for (var setting: i64 = 0; setting < frame_len; setting = setting + 6) {
        var at: i64 = H2_FRAME_HEADER_LEN + setting;
        if (not this.apply_h2_setting(
          h2_setting_id(this.rbuf, at),
          h2_u32(this.rbuf, at + 2),
          true
        )) {
          return std.AllocationResult.Ok(false);
        }
      }
      try h2_frame(this.wbuf, 0, H2FrameKind.Settings, H2_ACK, 0);
      return std.AllocationResult.Ok(true);
    }

    /*
     * Apply one peer setting. Returns false when the value is out of range.
     * A window change made after streams exist is applied to each of them.
     */
    method apply_h2_setting(identifier: i32, value: u32, adjust_streams: bool) bool {
      if (identifier == H2_SETTINGS_ENABLE_PUSH) {
        return value <= 1;
      }
      if (identifier == H2_SETTINGS_INITIAL_WINDOW_SIZE) {
        if (_convert<i64>(value) > H2_MAX_WINDOW) {
          return false;
        }
        var window_delta: i64 = _convert<i64>(value) - this.h2.peer_initial_window;
        this.h2.peer_initial_window = _convert<i64>(value);
        if (adjust_streams) {
          if (this.h2_ws.stream != 0) {
            this.h2_ws.send_window = this.h2_ws.send_window + window_delta;
          }
          for (var pending: ref H2ResponseStream in this.h2.responses) {
            if (pending.active) {
              pending.window = pending.window + window_delta;
            }
          }
        }
        return true;
      }
      if (identifier == H2_SETTINGS_MAX_FRAME_SIZE) {
        if (_convert<i64>(value) < H2_DEFAULT_FRAME_SIZE or
          _convert<i64>(value) > H2_MAX_FRAME_SIZE) {
          return false;
        }
        this.h2.peer_frame_size = _convert<i64>(value);
        return true;
      }
      if (identifier == H2_SETTINGS_ENABLE_CONNECT_PROTOCOL) {
        if (value > 1) {
          return false;
        }
        this.h2.enable_connect = value == 1;
        return true;
      }
      return true;
    }

    // Decode a complete header block and act on the request it describes.
    method finish_h2_header_block(
      stream: u32,
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64,
      draining: bool
    ) std.AllocationResult<bool> {
      if (not (try hpack_decode(
        this.alloc,
        this.h2.header_block,
        this.h2.header_block.readable_len(),
        this.h2.hpack,
        this.h2.headers
      ))) {
        return std.AllocationResult.Ok(false);
      }
      try this.accept_h2_headers(
        stream,
        this.h2.header_end_stream,
        handler,
        date,
        log,
        cfg,
        now_ms,
        draining
      );
      return std.AllocationResult.Ok(true);
    }

    // Buffer request DATA for a stream, dispatching the request at END_STREAM.
    method receive_h2_request_data(
      stream: u32,
      off: i64,
      len: i64,
      end_stream: bool,
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64
    ) std.AllocationResult<void> {
      var stream_index: i64 = this.find_h2_request_stream(stream);
      if (stream_index < 0) {
        try this.h2_send_rst(stream, H2_ERROR_STREAM_CLOSED);
        return std.AllocationResult.Ok;
      }
      var stream_body_len: i64 = this.h2.streams[stream_index].body.readable_len();
      if (stream_body_len + len > cfg.limits.max_body_bytes or
        this.h2.buffered_bytes + len > cfg.limits.max_h2_buffered_bytes) {
        try this.h2_send_rst(stream, H2_ERROR_ENHANCE_YOUR_CALM);
        this.reset_h2_request_stream(stream_index);
        return std.AllocationResult.Ok;
      }
      try this.h2.streams[stream_index].body.append_buffer(this.rbuf, off, len);
      this.h2.buffered_bytes = this.h2.buffered_bytes + len;
      if (end_stream) {
        try this.dispatch_h2_request_stream(stream_index, handler, date, log, cfg, now_ms);
      }

      return std.AllocationResult.Ok;
    }

    // Give the peer back the receive window a DATA frame consumed.
    method h2_send_window_update(stream: u32, increment: i64) std.AllocationResult<void> {
      try h2_frame(this.wbuf, 4, H2FrameKind.WindowUpdate, 0, stream);
      try h2_append_u32(this.wbuf, _convert<u32>(increment));
    
      return std.AllocationResult.Ok;
}

    // Find queued response data for a stream.
    method find_h2_response_stream(id: u32) i64 {
      for (var i: i64 = 0; i < this.h2.responses.size(); i = i + 1) {
        var pending: ref H2ResponseStream = this.h2.responses[i];
        if (pending.active and pending.id == id) {
          return i;
        }
      }
      return -1;
    }

    // Allocate a response-data slot with the peer's current stream window.
    method open_h2_response_stream(id: u32) std.AllocationResult<i64> {
      for (var i: i64 = 0; i < this.h2.responses.size(); i = i + 1) {
        if (not this.h2.responses[i].active) {
          this.h2.responses[i].begin(id, this.h2.peer_initial_window);
          return std.AllocationResult.Ok(i);
        }
      }
      try this.h2.responses.push(try H2ResponseStream(this.alloc));
      var added: i64 = this.h2.responses.size() - 1;
      this.h2.responses[added].begin(id, this.h2.peer_initial_window);
      return std.AllocationResult.Ok(added);
    }

    // Split a serialized response into immediate HEADERS and queued DATA.
    method queue_h2_response(
      date: ref DateCache,
      stream: u32,
      server_header: bool,
      send_body: bool
    ) std.AllocationResult<void> {
      var encoded = try ByteBuffer(this.alloc, 1024);
      try this.response.serialize_h2(encoded, date.value(), stream, server_header, send_body);
      var response_index: i64 = -1;
      while (encoded.readable_len() >= H2_FRAME_HEADER_LEN) {
        var length: i64 = h2_frame_len(encoded, 0);
        // Only frames this server serializes appear here, so unknown kinds pass through.
        var kind: H2FrameKind = match h2_frame_kind(encoded, 0) {
          Option.Some(known) => known,
          Option.None => H2FrameKind.Continuation
        };
        if (encoded.readable_len() < H2_FRAME_HEADER_LEN + length) {
          return std.AllocationResult.Ok;
        }
        if (kind == H2FrameKind.Data) {
          if (response_index < 0) {
            response_index = try this.open_h2_response_stream(stream);
          }
          try this.h2.responses[response_index].data.append_buffer(
            encoded,
            H2_FRAME_HEADER_LEN,
            length
          );
        } else if (kind == H2FrameKind.Headers and length > this.h2.peer_frame_size) {
          var original_flags: u8 = encoded.byte_at(4);
          var header_pos: i64 = 0;
          var first_fragment: bool = true;
          while (header_pos < length) {
            var take: i64 = length - header_pos;
            if (take > this.h2.peer_frame_size) {
              take = this.h2.peer_frame_size;
            }
            var fragment_kind: H2FrameKind = H2FrameKind.Continuation;
            var fragment_flags: u8 = 0;
            if (first_fragment) {
              fragment_kind = H2FrameKind.Headers;
              fragment_flags = original_flags & H2_END_STREAM;
            }
            if (header_pos + take == length) {
              fragment_flags = fragment_flags | H2_END_HEADERS;
            }
            try h2_frame(this.wbuf, take, fragment_kind, fragment_flags, stream);
            try this.wbuf.append_buffer(encoded, H2_FRAME_HEADER_LEN + header_pos, take);
            header_pos = header_pos + take;
            first_fragment = false;
          }
        } else {
          try this.wbuf.append_buffer(encoded, 0, H2_FRAME_HEADER_LEN + length);
        }
        encoded.consume(H2_FRAME_HEADER_LEN + length);
      }

      return std.AllocationResult.Ok;
    }

    // Emit RFC 8441 bytes within the peer's HTTP/2 flow-control windows.
    method flush_h2_websocket_data() std.AllocationResult<void> {
      while (this.h2_ws.stream != 0 and this.h2_ws.send_window > 0 and this.h2.send_window > 0 and
        this.h2_ws.outbound.readable_len() > 0) {
        var take: i64 = this.h2_ws.outbound.readable_len();
        if (take > this.h2.peer_frame_size) {
          take = this.h2.peer_frame_size;
        }
        if (take > this.h2_ws.send_window) {
          take = this.h2_ws.send_window;
        }
        if (take > this.h2.send_window) {
          take = this.h2.send_window;
        }
        try h2_frame(this.wbuf, take, H2FrameKind.Data, 0, this.h2_ws.stream);
        try this.wbuf.append_buffer(this.h2_ws.outbound, 0, take);
        this.h2_ws.outbound.consume(take);
        this.h2_ws.send_window = this.h2_ws.send_window - take;
        this.h2.send_window = this.h2.send_window - take;
      }
      if (this.h2_ws.stream != 0 and this.h2_ws.outbound.readable_len() == 0 and
        this.h2_ws.end_pending) {
        try h2_frame(this.wbuf, 0, H2FrameKind.Data, H2_END_STREAM, this.h2_ws.stream);
        this.h2_ws.stream = 0;
        this.h2_ws.end_pending = false;
      }
    
      return std.AllocationResult.Ok;
}

    // Emit queued DATA within the peer's connection and stream windows.
    method flush_h2_response_data() std.AllocationResult<void> {
      if (this.h2.send_window <= 0) {
        return std.AllocationResult.Ok;
      }
      for (var pending: ref H2ResponseStream in this.h2.responses) {
        while (pending.active and pending.window > 0 and this.h2.send_window > 0 and
          pending.data.readable_len() > 0) {
          var take: i64 = pending.data.readable_len();
          if (take > this.h2.peer_frame_size) {
            take = this.h2.peer_frame_size;
          }
          if (take > pending.window) {
            take = pending.window;
          }
          if (take > this.h2.send_window) {
            take = this.h2.send_window;
          }
          var flags: u8 = 0;
          if (take == pending.data.readable_len()) {
            flags = H2_END_STREAM;
          }
          try h2_frame(this.wbuf, take, H2FrameKind.Data, flags, pending.id);
          try this.wbuf.append_buffer(pending.data, 0, take);
          pending.data.consume(take);
          pending.window = pending.window - take;
          this.h2.send_window = this.h2.send_window - take;
          if (pending.data.readable_len() == 0) {
            pending.reset();
          }
        }
      }
    
      return std.AllocationResult.Ok;
}

    // Find an active buffered request stream.
    method find_h2_request_stream(id: u32) i64 {
      for (var i: i64 = 0; i < this.h2.streams.size(); i = i + 1) {
        var pending: ref H2RequestStream = this.h2.streams[i];
        if (pending.active and pending.id == id) {
          return i;
        }
      }
      return -1;
    }

    // Allocate a reusable request stream slot.
    method open_h2_request_stream(id: u32, cfg: const ref Config) std.AllocationResult<i64> {
      if (this.find_h2_request_stream(id) >= 0 or
        this.h2.open_streams >= cfg.limits.max_h2_concurrent_streams) {
        return std.AllocationResult.Ok(-1);
      }
      for (var i: i64 = 0; i < this.h2.streams.size(); i = i + 1) {
        if (not this.h2.streams[i].active) {
          try this.h2.streams[i].begin(id, this.h2.headers);
          this.h2.open_streams = this.h2.open_streams + 1;
          return std.AllocationResult.Ok(i);
        }
      }
      try this.h2.streams.push(try H2RequestStream(this.alloc));
      var added: i64 = this.h2.streams.size() - 1;
      try this.h2.streams[added].begin(id, this.h2.headers);
      this.h2.open_streams = this.h2.open_streams + 1;
      return std.AllocationResult.Ok(added);
    }

    // Release one request stream and its aggregate body accounting.
    method reset_h2_request_stream(index: i64) void {
      if (index < 0 or index >= this.h2.streams.size()) {
        return;
      }
      var pending: ref H2RequestStream = this.h2.streams[index];
      if (pending.active) {
        this.h2.buffered_bytes = this.h2.buffered_bytes - pending.body.readable_len();
        this.h2.open_streams = this.h2.open_streams - 1;
        pending.reset();
      }
    }

    // Send a stream-local HTTP/2 reset.
    method h2_send_rst(stream: u32, error_code: u32) std.AllocationResult<void> {
      try h2_frame(this.wbuf, 4, H2FrameKind.RstStream, 0, stream);
      try h2_append_u32(this.wbuf, error_code);
    
      return std.AllocationResult.Ok;
}

    // Store a decoded request header block or dispatch a bodyless request.
    method accept_h2_headers(
      stream: u32,
      end_stream: bool,
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64,
      draining: bool
    ) std.AllocationResult<void> {
      if (draining) {
        try this.h2_send_rst(stream, H2_ERROR_REFUSED_STREAM);
        this.h2.headers.clear();
        return std.AllocationResult.Ok;
      }
      if (stream <= this.h2.last_client_stream) {
        try this.h2_send_rst(stream, H2_ERROR_STREAM_CLOSED);
        this.h2.headers.clear();
        return std.AllocationResult.Ok;
      }
      if (not h2_valid_request_headers(this.h2.headers, cfg.limits)) {
        try this.h2_send_rst(stream, H2_ERROR_PROTOCOL);
        this.h2.headers.clear();
        return std.AllocationResult.Ok;
      }
      this.h2.last_client_stream = stream;
      this.h2.stream = stream;
      if (this.h2_is_extended_connect()) {
        try this.handle_h2_request(handler, date, log, cfg, now_ms);
        return std.AllocationResult.Ok;
      }
      var index: i64 = try this.open_h2_request_stream(stream, cfg);
      this.h2.headers.clear();
      if (index < 0) {
        try this.h2_send_rst(stream, H2_ERROR_REFUSED_STREAM);
        return std.AllocationResult.Ok;
      }
      if (end_stream) {
        try this.dispatch_h2_request_stream(index, handler, date, log, cfg, now_ms);
      }

      return std.AllocationResult.Ok;
    }

    // Move one completed stream into the shared request view and invoke it.
    method dispatch_h2_request_stream(
      index: i64,
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64
    ) std.AllocationResult<void> {
      this.h2.headers.clear();
      this.body_buf.clear();
      if (true) {
        var pending: ref H2RequestStream = this.h2.streams[index];
        this.h2.stream = pending.id;
        for (var field: ref H2Header in pending.headers) {
          try this.h2.headers.push(try field.clone(this.alloc));
        }
        try this.body_buf.append_buffer(pending.body, 0, pending.body.readable_len());
      }
      this.reset_h2_request_stream(index);
      try this.handle_h2_request(handler, date, log, cfg, now_ms);

      return std.AllocationResult.Ok;
    }

    // Report whether the current headers request an extended CONNECT.
    method h2_is_extended_connect() bool {
      for (var field: ref H2Header in this.h2.headers) {
        if (field.name.equals_literal(":protocol") and field.value.equals_literal("websocket")) {
          return true;
        }
      }
      return false;
    }

    // Convert decoded HTTP/2 headers into the existing handler request view.
    method handle_h2_request(
      handler: ref IHandler,
      date: ref DateCache,
      log: ref Logger,
      cfg: const ref Config,
      now_ms: i64
    ) std.AllocationResult<void> {
      if (not h2_valid_request_headers(this.h2.headers, cfg.limits)) {
        try this.close();
        return std.AllocationResult.Ok;
      }
      var method = try String(this.alloc, "");
      var path = try String(this.alloc, "");
      var authority = try String(this.alloc, "");
      var protocol = try String(this.alloc, "");
      var head = try ByteBuffer(this.alloc, 512);
      for (var h: ref H2Header in this.h2.headers) {
        if (h.name.equals_literal(":method")) {
          try method.append(h.value);
        } else if (h.name.equals_literal(":path")) {
          try path.append(h.value);
        } else if (h.name.equals_literal(":authority")) {
          try authority.append(h.value);
        } else if (h.name.equals_literal(":protocol")) {
          try protocol.append(h.value);
        }
      }
      if (method.is_empty() or path.is_empty()) {
        try this.close();
        return std.AllocationResult.Ok;
      }
      try head.append_string(method);
      try head.append_byte(b' ');
      try head.append_string(path);
      try head.append_literal(" HTTP/1.1\r\nHost: ");
      try head.append_string(authority);
      try head.append_literal("\r\n");
      for (var field: ref H2Header in this.h2.headers) {
        if (not field.name.starts_with(":") and not field.name.equals_literal("host")) {
          try head.append_string(field.name);
          try head.append_literal(": ");
          try head.append_string(field.value);
          try head.append_literal("\r\n");
        }
      }
      try head.append_literal("\r\n");
      if (try this.request.parse_head(head, head.readable_len(), cfg.limits) !=
        ParseStatus.Complete) {
        try this.close();
        return std.AllocationResult.Ok;
      }
      try this.request.set_body(this.body_buf, 0, this.body_buf.readable_len());
      if (protocol.equals_literal("websocket")) {
        try this.begin_h2_websocket(handler, date, cfg);
        this.request.reset();
        this.h2.headers.clear();
        this.body_buf.clear();
        this.h2.headers_ready = false;
        return std.AllocationResult.Ok;
      }
      this.response.reset();
      handler.handle(this.request, this.response);
      try this.queue_h2_response(date, this.h2.stream, cfg.server_header, not this.request.is_head());
      this.served = this.served + 1;
      this.started_ms = now_ms;
      this.bytes_sent = 0;
      try this.log_access(log, now_ms);
      this.response.reset();
      this.request.reset();
      this.h2.headers.clear();
      this.body_buf.clear();
      this.h2.headers_ready = false;
      this.want_ = EPOLLIN | EPOLLOUT | EPOLLRDHUP;

      return std.AllocationResult.Ok;
    }

    // Set up body reading after the head parsed.
    method begin_body() void {
      this.framing.reset();
      this.body_buf.clear();
      if (this.request.is_chunked()) {
        this.framing.kind = BodyKind.Chunked;
      } else if (this.request.content_length() > 0) {
        this.framing.kind = BodyKind.Length;
        this.framing.raw_len = this.request.content_length();
      }
    }

    /*
     * Make progress on the body from what rbuf holds. Returns zero when the
     * body is complete, a negative number when more bytes are needed, or an
     * error status.
     */
    method advance_body(cfg: const ref Config) std.AllocationResult<i32> {
      var head: i64 = this.request.head_len();
      if (this.framing.kind == BodyKind.None) {
        try this.request.set_body(this.rbuf, 0, 0);
        return std.AllocationResult.Ok(0);
      }
      if (this.framing.kind == BodyKind.Length) {
        if (this.rbuf.readable_len() < head + this.framing.raw_len) {
          return std.AllocationResult.Ok(-1);
        }
        try this.request.set_body(this.rbuf, head, this.framing.raw_len);
        return std.AllocationResult.Ok(0);
      }
      return std.AllocationResult.Ok(try this.decode_chunks(cfg));
    }

    /*
     * Decode chunked framing from rbuf into body_buf. Same results as
     * advance_body().
     */
    method decode_chunks(cfg: const ref Config) std.AllocationResult<i32> {
      var avail: i64 = this.rbuf.readable_len();
      var head: i64 = this.request.head_len();
      while (true) {
        var pos: i64 = head + this.framing.raw_len;
        if (this.framing.chunk_state == ChunkState.Done) {
          try this.request.set_body(this.body_buf, 0, this.body_buf.readable_len());
          return std.AllocationResult.Ok(0);
        }
        if (this.framing.chunk_state == ChunkState.Size) {
          var eol: i64 = find_crlf(this.rbuf, pos, avail);
          if (eol < 0) {
            if (avail - pos > MAX_CHUNK_SIZE_LINE) {
              return std.AllocationResult.Ok(400);
            }
            return std.AllocationResult.Ok(-1);
          }
          var size: i64 = 0;
          var digits: i64 = 0;
          var i: i64 = pos;
          while (i < eol) {
            var d: i32 = hex_value(this.rbuf.byte_at(i));
            if (d < 0) {
              break;
            }
            size = size * 16 + _convert<i64>(d);
            digits = digits + 1;
            if (digits > MAX_CHUNK_SIZE_DIGITS) {
              return std.AllocationResult.Ok(400);
            }
            i = i + 1;
          }
          if (digits == 0) {
            return std.AllocationResult.Ok(400);
          }
          /*
           * Anything after the digits up to the line end is a chunk
           * extension, which is ignored.
           */
          this.framing.raw_len = eol + 2 - head;
          if (size == 0) {
            this.framing.chunk_state = ChunkState.Trailers;
          } else {
            if (this.body_buf.readable_len() + size > cfg.limits.max_body_bytes) {
              return std.AllocationResult.Ok(413);
            }
            this.framing.chunk_remaining = size;
            this.framing.chunk_state = ChunkState.Data;
          }
          continue;
        }
        if (this.framing.chunk_state == ChunkState.Data) {
          var have: i64 = avail - pos;
          if (have <= 0) {
            return std.AllocationResult.Ok(-1);
          }
          var take: i64 = have;
          if (take > this.framing.chunk_remaining) {
            take = this.framing.chunk_remaining;
          }
          try this.body_buf.append_buffer(this.rbuf, pos, take);
          this.framing.raw_len = this.framing.raw_len + take;
          this.framing.chunk_remaining = this.framing.chunk_remaining - take;
          if (this.framing.chunk_remaining == 0) {
            this.framing.chunk_state = ChunkState.DataEnd;
          }
          continue;
        }
        if (this.framing.chunk_state == ChunkState.DataEnd) {
          if (avail - pos < 2) {
            return std.AllocationResult.Ok(-1);
          }
          if (this.rbuf.byte_at(pos) != 13 or this.rbuf.byte_at(pos + 1) != 10) {
            return std.AllocationResult.Ok(400);
          }
          this.framing.raw_len = this.framing.raw_len + 2;
          this.framing.chunk_state = ChunkState.Size;
          continue;
        }
        // Trailers: lines up to and including an empty one.
        var teol: i64 = find_crlf(this.rbuf, pos, avail);
        if (teol < 0) {
          if (avail - pos > cfg.limits.max_header_bytes) {
            return std.AllocationResult.Ok(431);
          }
          return std.AllocationResult.Ok(-1);
        }
        this.framing.raw_len = teol + 2 - head;
        if (teol == pos) {
          this.framing.chunk_state = ChunkState.Done;
        }
      }
      return std.AllocationResult.Ok(-1);
    }

    // Upgrade an HTTP/1.1 request to cleartext HTTP/2 stream 1.
    method try_h2c_upgrade(
      handler: ref IHandler,
      date: ref DateCache,
      cfg: const ref Config
    ) std.AllocationResult<bool> {
      if (not cfg.http2 or not this.request.header_equals("upgrade", "h2c")) {
        return std.AllocationResult.Ok(false);
      }
      if (not this.request.header_contains_token("connection", "upgrade") or
        not this.request.header_contains_token("connection", "http2-settings") or
        not this.request.has_header("http2-settings")) {
        return std.AllocationResult.Ok(false);
      }
      var encoded_settings: String = match try this.request.header("http2-settings", this.alloc) {
        Option.Some(value) => value,
        Option.None => try String(this.alloc, "")
      };
      var settings_payload = try ByteBuffer(this.alloc, 32);
      if (not try h2_decode_settings_header(encoded_settings, settings_payload) or
        settings_payload.readable_len() % 6 != 0) {
        return std.AllocationResult.Ok(false);
      }
      for (var setting: i64 = 0; setting < settings_payload.readable_len(); setting = setting + 6) {
        if (not this.apply_h2_setting(
          h2_setting_id(settings_payload, setting),
          h2_u32(settings_payload, setting + 2),
          false
        )) {
          return std.AllocationResult.Ok(false);
        }
      }
      this.response.reset();
      handler.handle(this.request, this.response);
      try this.wbuf.append_literal(
        "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: h2c\r\n\r\n"
      );
      this.proto = Protocol.Http2;
      this.h2.preface = true;
      this.h2.headers_ready = false;
      this.h2.hpack.reset();
      try h2_append_settings(this.wbuf, cfg.limits.max_h2_concurrent_streams);
      try this.queue_h2_response(date, 1, cfg.server_header, not this.request.is_head());
      this.h2.upgrading = true;
      this.keep_alive = true;
      this.send_body = false;
      return std.AllocationResult.Ok(true);
    }

    // Finish the h2c transition after the HTTP/1.1 101 response.
    method finish_h2c_upgrade(cfg: const ref Config) void {
      var used: i64 = this.request.head_len() + this.framing.raw_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      this.request.reset();
      this.response.reset();
      this.body_buf.clear();
      this.wbuf.clear();
      this.h2.upgrading = false;
      this.h2.last_client_stream = 1;
      this.state = ConnState.Http2;
      this.want_ = EPOLLIN | EPOLLRDHUP;
      this.deadline_ms = this.deadline_ms + cfg.timeouts.keep_alive_ms;
    }

    // Report whether the client offered permessage-deflate.
    method websocket_compression_offered() std.AllocationResult<bool> {
      return std.AllocationResult.Ok(
        match try this.request.header("sec-websocket-extensions", this.alloc) {
          Option.Some(value) => try websocket_offers_deflate(this.alloc, value),
          Option.None => false
        }
      );
    }

    // Validate and dispatch an HTTP/1.1 WebSocket opening handshake.
    method try_websocket_upgrade(
      handler: ref IHandler,
      date: ref DateCache,
      cfg: const ref Config
    ) std.AllocationResult<bool> {
      if (not this.request.method_is("GET") or this.request.version_minor() != 1) {
        return std.AllocationResult.Ok(false);
      }
      if (not this.request.header_contains_token("connection", "upgrade") or
        not this.request.header_equals("upgrade", "websocket")) {
        return std.AllocationResult.Ok(false);
      }
      if (not this.request.header_equals("sec-websocket-version", "13")) {
        this.response.reset();
        this.response.set_status(426);
        try this.response.add_header("Sec-WebSocket-Version", "13");
        try this.response.set_body("WebSocket version 13 required\n");
        this.keep_alive = false;
        this.send_body = true;
        try this.serialize_response(date, cfg);
        return std.AllocationResult.Ok(true);
      }
      var key: String = match try this.request.header("sec-websocket-key", this.alloc) {
        Option.Some(v) => v,
        Option.None => try String(this.alloc, "")
      };
      if (not websocket_valid_key(key)) {
        return std.AllocationResult.Ok(false);
      }
      var compression_available: bool = cfg.websocket_compression and
        try this.websocket_compression_offered();
      var handshake = try WebSocketHandshake(this.alloc, compression_available);
      handler.handle_websocket(this.request, handshake);
      handshake.compression = handshake.compression and compression_available;
      if (not handshake.subprotocol.is_empty() and
        not this.request.header_contains_token_string(
          "sec-websocket-protocol",
          handshake.subprotocol
        )) {
        handshake.reject(400);
      }
      if (not handshake.accepted) {
        this.response.reset();
        this.response.set_status(handshake.reject_status);
        try this.response.set_body("WebSocket upgrade rejected\n");
        this.keep_alive = false;
        this.send_body = true;
        try this.serialize_response(date, cfg);
        return std.AllocationResult.Ok(true);
      }
      var accept = try websocket_accept(this.alloc, key);
      this.response.reset();
      this.response.set_status(101);
      try this.wbuf.append_literal(
        "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
      );
      try this.wbuf.append_string(accept);
      try this.wbuf.append_literal("\r\n");
      if (not handshake.subprotocol.is_empty()) {
        try this.wbuf.append_literal("Sec-WebSocket-Protocol: ");
        try this.wbuf.append_string(handshake.subprotocol);
        try this.wbuf.append_literal("\r\n");
      }
      if (handshake.compression) {
        try this.wbuf.append_literal("Sec-WebSocket-Extensions: ");
        try this.wbuf.append_literal(WS_DEFLATE_PARAMS);
        try this.wbuf.append_literal("\r\n");
      }
      try this.wbuf.append_literal("\r\n");
      this.ws.activate(cfg.limits.max_body_bytes, handshake.compression);
      this.ws.upgrading = true;
      this.keep_alive = true;
      this.send_body = false;
      return std.AllocationResult.Ok(true);
    }

    // Finish switching protocols after the 101 response reaches the client.
    method finish_websocket_upgrade(handler: ref IHandler, cfg: const ref Config) std.AllocationResult<void> {
      var used: i64 = this.request.head_len() + this.framing.raw_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      this.request.reset();
      this.response.reset();
      this.body_buf.clear();
      this.wbuf.clear();
      this.ws.upgrading = false;
      this.h2.upgrading = false;
      this.ws.fragmenting = false;
      this.ws.closing = false;
      this.state = ConnState.WebSocket;
      this.want_ = EPOLLIN | EPOLLRDHUP;
      this.deadline_ms = this.deadline_ms + cfg.timeouts.keep_alive_ms;
      handler.websocket_open(try this.ws.handle());
    
      return std.AllocationResult.Ok;
}

    // Run the WebSocket frame state machine until the socket would block.
    method drive_websocket(
      handler: ref IHandler,
      cfg: const ref Config
    ) std.AllocationResult<void> {
      while (true) {
        var active: bool = try this.ws.drain_to(this.wbuf);
        if (this.wbuf.readable_len() > 0) {
          var wr: i64 = this.flush_wbuf();
          if (wr != 0) {
            if (not this.wait_for(wr)) {
              try this.close();
            }
            return std.AllocationResult.Ok;
          }
        }
        if (this.ws.closing or not active) {
          try this.close();
          return std.AllocationResult.Ok;
        }
        var frame = WebSocketFrame();
        var parsed: WebSocketParse = websocket_parse_frame(this.rbuf, this.ws.compression, frame);
        if (parsed == WebSocketParse.Malformed) {
          try this.websocket_protocol_error(handler, 1002);
          continue;
        }
        if (parsed == WebSocketParse.Ready and frame.length > cfg.limits.max_body_bytes) {
          try this.websocket_protocol_error(handler, 1009);
          continue;
        }
        if (parsed == WebSocketParse.Incomplete or this.rbuf.readable_len() < frame.total_len()) {
          if (not (try this.fill_rbuf())) {
            return std.AllocationResult.Ok;
          }
          continue;
        }
        var decoded: ByteBuffer = try websocket_unmask(this.alloc, this.rbuf, frame);
        var replies = try ByteBuffer(this.alloc, 128);
        if (not try this.receive_websocket_frame(frame, decoded, replies, handler, cfg)) {
          continue;
        }
        try this.wbuf.append_buffer(replies, 0, replies.readable_len());
        this.rbuf.consume(frame.total_len());
        this.rbuf.compact();
      }

      return std.AllocationResult.Ok;
    }

    /*
     * Act on one complete, unmasked client frame: answer control frames into
     * replies and reassemble data frames into a message for the handler.
     * Returns false after a protocol error has been reported.
     */
    method receive_websocket_frame(
      frame: const ref WebSocketFrame,
      decoded: const ref ByteBuffer,
      replies: ref ByteBuffer,
      handler: ref IHandler,
      cfg: const ref Config
    ) std.AllocationResult<bool> {
      var len: i64 = decoded.readable_len();
      if (frame.opcode == WebSocketOpcode.Close) {
        var close_status: i32 = websocket_close_payload_status(decoded, len);
        if (close_status != 0) {
          try this.websocket_protocol_error(handler, close_status);
          return std.AllocationResult.Ok(false);
        }
        handler.websocket_close(try this.ws.handle(), websocket_close_code(decoded));
        try websocket_append_frame(replies, WebSocketOpcode.Close, decoded, 0, len);
        this.end_websocket_session();
        return std.AllocationResult.Ok(true);
      }
      if (frame.opcode == WebSocketOpcode.Ping) {
        try websocket_append_frame(replies, WebSocketOpcode.Pong, decoded, 0, len);
        return std.AllocationResult.Ok(true);
      }
      if (frame.opcode == WebSocketOpcode.Pong) {
        return std.AllocationResult.Ok(true);
      }
      if (websocket_is_data(frame.opcode)) {
        if (this.ws.fragmenting) {
          try this.websocket_protocol_error(handler, 1002);
          return std.AllocationResult.Ok(false);
        }
        this.body_buf.clear();
        this.ws.fragment_opcode = frame.opcode;
        this.ws.fragment_compressed = frame.compressed;
      } else if (not this.ws.fragmenting or
        this.body_buf.readable_len() + len > cfg.limits.max_body_bytes) {
        try this.websocket_protocol_error(handler, 1002);
        return std.AllocationResult.Ok(false);
      }
      try this.body_buf.append_buffer(decoded, 0, len);
      this.ws.fragmenting = not frame.final_frame;
      if (frame.final_frame) {
        try this.deliver_websocket_message(handler, cfg);
      }
      return std.AllocationResult.Ok(true);
    }

    /*
     * Stop the session after a close exchange: an HTTP/1 socket closes once
     * the reply is flushed, while an HTTP/2 tunnel only stops accepting sends.
     */
    method end_websocket_session() void {
      if (this.h2_ws.stream != 0) {
        this.ws.deactivate();
      } else {
        this.ws.closing = true;
      }
    }

    // Accept or reject an RFC 8441 extended CONNECT stream.
    method begin_h2_websocket(
      handler: ref IHandler,
      date: ref DateCache,
      cfg: const ref Config
    ) std.AllocationResult<void> {
      var compression_available: bool = cfg.websocket_compression and
        try this.websocket_compression_offered();
      var handshake = try WebSocketHandshake(this.alloc, compression_available);
      if (this.h2.enable_connect and this.request.method_is("CONNECT")) {
        handler.handle_websocket(this.request, handshake);
      }
      handshake.compression = handshake.compression and compression_available;
      if (not handshake.accepted) {
        this.response.reset();
        this.response.set_status(handshake.reject_status);
        try this.response.set_body("WebSocket connect rejected\n");
        try this.queue_h2_response(date, this.h2.stream, cfg.server_header, true);
        return std.AllocationResult.Ok;
      }
      var block = try ByteBuffer(this.alloc, 64);
      try hpack_status(block, 200, this.alloc);
      if (not handshake.subprotocol.is_empty()) {
        try hpack_header(
          block,
          try String(this.alloc, "sec-websocket-protocol"),
          handshake.subprotocol
        );
      }
      if (handshake.compression) {
        try hpack_header_literal(block, "sec-websocket-extensions", WS_DEFLATE_PARAMS);
      }
      try h2_frame(
        this.wbuf,
        block.readable_len(),
        H2FrameKind.Headers,
        H2_END_HEADERS,
        this.h2.stream
      );
      try this.wbuf.append_buffer(block, 0, block.readable_len());
      this.ws.activate(cfg.limits.max_body_bytes, handshake.compression);
      this.h2_ws.stream = this.h2.stream;
      this.h2_ws.inbound.clear();
      this.h2_ws.outbound.clear();
      this.h2_ws.send_window = this.h2.peer_initial_window;
      this.h2_ws.end_pending = false;
      handler.websocket_open(try this.ws.handle());

      return std.AllocationResult.Ok;
    }

    // Process complete WebSocket frames carried by HTTP/2 DATA.
    method process_h2_websocket(
      handler: ref IHandler,
      cfg: const ref Config
    ) std.AllocationResult<void> {
      var replies = try ByteBuffer(this.alloc, 128);
      while (this.h2_ws.stream != 0) {
        var frame = WebSocketFrame();
        var parsed: WebSocketParse = websocket_parse_frame(
          this.h2_ws.inbound,
          this.ws.compression,
          frame
        );
        if (parsed == WebSocketParse.Malformed) {
          try this.websocket_protocol_error(handler, 1002);
          break;
        }
        if (parsed == WebSocketParse.Ready and frame.length > cfg.limits.max_body_bytes) {
          try this.websocket_protocol_error(handler, 1009);
          break;
        }
        if (parsed == WebSocketParse.Incomplete or
          this.h2_ws.inbound.readable_len() < frame.total_len()) {
          break;
        }
        var decoded: ByteBuffer = try websocket_unmask(this.alloc, this.h2_ws.inbound, frame);
        if (not try this.receive_websocket_frame(frame, decoded, replies, handler, cfg)) {
          break;
        }
        this.h2_ws.inbound.consume(frame.total_len());
        this.h2_ws.inbound.compact();
      }
      if (replies.readable_len() > 0) {
        try this.h2_ws.outbound.append_buffer(replies, 0, replies.readable_len());
        try this.flush_h2_websocket_data();
      }

      return std.AllocationResult.Ok;
    }

    // Deliver one assembled data message to the application.
    method deliver_websocket_message(
      handler: ref IHandler,
      cfg: const ref Config
    ) std.AllocationResult<void> {
      var message_data = try ByteBuffer(this.alloc, this.body_buf.readable_len());
      if (this.ws.fragment_compressed) {
        var inflate_status: i32 = try websocket_inflate(
          this.alloc,
          this.body_buf,
          0,
          this.body_buf.readable_len(),
          cfg.limits.max_body_bytes,
          message_data
        );
        if (inflate_status != 0) {
          if (inflate_status == 2) {
            try this.websocket_protocol_error(handler, 1009);
          } else {
            try this.websocket_protocol_error(handler, 1002);
          }
          this.body_buf.clear();
          this.ws.fragment_compressed = false;
          return std.AllocationResult.Ok;
        }
      } else {
        try message_data.append_buffer(this.body_buf, 0, this.body_buf.readable_len());
      }
      if (this.ws.fragment_opcode == WebSocketOpcode.Text and
        not websocket_valid_utf8(message_data, 0, message_data.readable_len())) {
        try this.websocket_protocol_error(handler, 1007);
        this.body_buf.clear();
        this.ws.fragment_compressed = false;
        return std.AllocationResult.Ok;
      }
      var kind: WebSocketMessageKind = WebSocketMessageKind.Binary;
      if (this.ws.fragment_opcode == WebSocketOpcode.Text) {
        kind = WebSocketMessageKind.Text;
      }
      var message = WebSocketMessage(kind, message_data);
      handler.websocket_message(try this.ws.handle(), message);
      this.body_buf.clear();
      this.ws.fragment_compressed = false;

      return std.AllocationResult.Ok;
    }

    // Notify the application and start a protocol-error close.
    method websocket_protocol_error(handler: ref IHandler, code: i32) std.AllocationResult<void> {
      handler.websocket_error(try this.ws.handle(), code);
      if (this.h2_ws.stream != 0) {
        try websocket_append_close(this.h2_ws.outbound, code);
        this.h2_ws.end_pending = true;
        try this.flush_h2_websocket_data();
        this.h2_ws.inbound.clear();
        this.ws.deactivate();
      } else {
        try websocket_append_close(this.wbuf, code);
        this.ws.closing = true;
        this.rbuf.clear();
      }
    
      return std.AllocationResult.Ok;
}

    // Run the handler and serialize its response into wbuf.
    method handle_request(
      handler: ref IHandler,
      date: ref DateCache,
      cfg: const ref Config,
      draining: bool
    ) std.AllocationResult<void> {
      this.response.reset();
      this.keep_alive = this.request.keep_alive() and not draining;
      if (not draining and (try this.try_h2c_upgrade(handler, date, cfg))) {
        return std.AllocationResult.Ok;
      }
      if (not draining and (try this.try_websocket_upgrade(handler, date, cfg))) {
        return std.AllocationResult.Ok;
      }
      this.send_body = not this.request.is_head();
      handler.handle(this.request, this.response);
      if (this.response.wants_close()) {
        this.keep_alive = false;
      }
      if (status_has_no_body(this.response.status)) {
        this.send_body = false;
      }
      try this.serialize_response(date, cfg);

      return std.AllocationResult.Ok;
    }

    // Write the response head into wbuf, followed by the body when it is sent.
    method serialize_response(
      date: ref DateCache,
      cfg: const ref Config
    ) std.AllocationResult<void> {
      this.bytes_sent = 0;
      try this.response.serialize_head(
        this.wbuf,
        date.value(),
        this.keep_alive,
        cfg.server_header
      );
      if (this.send_body) {
        var body: ref ByteBuffer = this.response.body_buffer();
        try this.wbuf.append_buffer(body, 0, body.readable_len());
      }

      return std.AllocationResult.Ok;
    }

    // Answer a malformed or oversized request and close afterwards.
    method send_error(
      status: i32,
      date: ref DateCache,
      cfg: const ref Config
    ) std.AllocationResult<void> {
      this.response.reset();
      this.response.set_status(status);
      try this.response.set_content_type("text/plain");
      try this.response.set_body(reason_phrase(status));
      try this.response.append_body("\n");
      this.keep_alive = false;
      this.send_body = true;
      try this.serialize_response(date, cfg);
      this.state = ConnState.Writing;

      return std.AllocationResult.Ok;
    }

    // Write wbuf out. Returns zero when empty, else an IO_* value.
    method flush_wbuf() i64 {
      while (this.wbuf.readable_len() > 0) {
        var n: i64 = this.transport.write(this.wbuf.readable_ptr(), this.wbuf.readable_len());
        if (n > 0) {
          this.wbuf.consume(n);
          this.bytes_sent = this.bytes_sent + n;
          continue;
        }
        if (n == IO_CLOSED) {
          return IO_ERROR;
        }
        return n;
      }
      return 0;
    }

    /*
     * Write the response head, body, and any streamed file. Returns zero when
     * everything was sent, else an IO_* value.
     */
    method write_response() std.AllocationResult<i64> {
      while (true) {
        var r: i64 = this.flush_wbuf();
        if (r != 0) {
          return std.AllocationResult.Ok(r);
        }
        if (this.send_body and this.response.has_file_body()) {
          var before: i64 = this.response.file_bytes_remaining();
          var n: i64 = try this.response.read_file_chunk(this.wbuf, FILE_CHUNK);
          if (n == 0 and before > 0) {
            /*
             * The file shrank or failed mid-stream; the response is short,
             * so the connection must not be reused.
             */
            this.keep_alive = false;
            return std.AllocationResult.Ok(0);
          }
          continue;
        }
        return std.AllocationResult.Ok(0);
      }
      return std.AllocationResult.Ok(0);
    }

    // Discard the finished request's bytes and get ready for the next one.
    method finish_request() std.AllocationResult<void> {
      var used: i64 = this.request.head_len() + this.framing.raw_len;
      this.rbuf.consume(used);
      this.rbuf.compact();
      try this.rbuf.shrink_to(IDLE_BUFFER_CAP);
      this.wbuf.clear();
      try this.wbuf.shrink_to(IDLE_BUFFER_CAP);
      this.body_buf.clear();
      try this.body_buf.shrink_to(16);
      this.response.reset();
      this.request.reset();
      this.framing.continue_sent = false;
      this.state = ConnState.ReadingHead;
      this.want_ = EPOLLIN | EPOLLRDHUP;

      return std.AllocationResult.Ok;
    }

    // Write one access log line for the response just sent.
    method log_access(log: ref Logger, now_ms: i64) std.AllocationResult<void> {
      if (not log.access_enabled()) {
        return std.AllocationResult.Ok;
      }
      var entry = try ByteBuffer(this.alloc, 256);
      if (this.transport.is_tls()) {
        try entry.append_literal("https ");
      } else {
        try entry.append_literal("http ");
      }
      try entry.append_byte(b'"');
      var method: String = try this.request.method_text(this.alloc);
      if (method.length() == 0) {
        try entry.append_literal("-");
      } else {
        try entry.append_string(method);
        try entry.append_byte(b' ');
        var target: String = try this.request.raw_target(this.alloc);
        try entry.append_string(target);
      }
      try entry.append_literal("\" ");
      try entry.append_i64(_convert<i64>(this.response.status));
      try entry.append_byte(b' ');
      try entry.append_i64(this.bytes_sent);
      try entry.append_byte(b' ');
      try entry.append_i64(now_ms - this.started_ms);
      try entry.append_literal("ms");
      try log.access(entry);

      return std.AllocationResult.Ok;
    }
  }
}
