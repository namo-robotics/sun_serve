    // Report whether the current headers request an extended CONNECT.
    method h2_is_extended_connect() bool {
      for (var i: i64 = 0; i < this.h2_headers.size(); i = i + 1) {
        var field: ref H2Header = this.h2_headers.get_unchecked(i);
        if (field.name.equals_literal(":protocol") and field.value.equals_literal("websocket")) {
          return true;
        }
      }
      return false;
    }

    // Convert decoded HTTP/2 headers into the existing handler request view.
    method handle_h2_request(handler: ref IHandler, date: ref DateCache, log: ref Logger, cfg: const ref Config, now_ms: i64) void {
      if (not h2_valid_request_headers(this.h2_headers, cfg.limits)) {
        this.close();
        return;
      }
      var method = String(this.alloc, "");
      var path = String(this.alloc, "");
      var authority = String(this.alloc, "");
      var protocol = String(this.alloc, "");
      var head = ByteBuffer(this.alloc, 512);
      for (var i: i64 = 0; i < this.h2_headers.size(); i = i + 1) {
        var h: ref H2Header = this.h2_headers.get_unchecked(i);
        if (h.name.equals_literal(":method")) {
          method.append(h.value);
        } else if (h.name.equals_literal(":path")) {
          path.append(h.value);
        } else if (h.name.equals_literal(":authority")) {
          authority.append(h.value);
        } else if (h.name.equals_literal(":protocol")) {
          protocol.append(h.value);
        }
      }
      if (method.length() == 0 or path.length() == 0) {
        this.close();
        return;
      }
      head.append_string(method);
      head.append_byte(b' ');
      head.append_string(path);
      head.append_literal(" HTTP/1.1\r\nHost: ");
      head.append_string(authority);
      head.append_literal("\r\n");
      for (var j: i64 = 0; j < this.h2_headers.size(); j = j + 1) {
        var field: ref H2Header = this.h2_headers.get_unchecked(j);
        if (not field.name.starts_with(":") and not field.name.equals_literal("host")) {
          head.append_string(field.name);
          head.append_literal(": ");
          head.append_string(field.value);
          head.append_literal("\r\n");
        }
      }
      head.append_literal("\r\n");
      if (this.request.parse_head(head.readable_ptr(), head.readable_len(), cfg.limits) != ParseStatus.Complete) {
        this.close();
        return;
      }
      this.request.set_body(this.body_buf.readable_ptr(), this.body_buf.readable_len());
      if (protocol.equals_literal("websocket")) {
        this.begin_h2_websocket(handler, date, cfg);
        this.request.reset();
        this.h2_headers.clear();
        this.body_buf.clear();
        this.h2_headers_ready = false;
        return;
      }
      this.response.reset();
      handler.handle(this.request, this.response);
      this.response.serialize_h2(this.wbuf, date.value(), this.h2_stream, cfg.server_header, not this.request.is_head());
      this.served = this.served + 1;
      this.started_ms = now_ms;
      this.bytes_sent = 0;
      this.log_access(log, now_ms);
      this.response.reset();
      this.request.reset();
      this.h2_headers.clear();
      this.body_buf.clear();
      this.h2_headers_ready = false;
      this.want_ = EPOLLIN | EPOLLOUT | EPOLLRDHUP;
    }

    // Set up body reading after the head parsed.
    method begin_body() void {
      this.raw_body_len = 0;
      this.continue_sent = false;
      this.body_buf.clear();
      this.chunk_state = CHUNK_SIZE;
      this.chunk_remaining = 0;
      if (this.request.is_chunked()) {
        this.body_kind = BODY_CHUNKED;
      } else if (this.request.content_length() > 0) {
        this.body_kind = BODY_LENGTH;
        this.raw_body_len = this.request.content_length();
      } else {
        this.body_kind = BODY_NONE;
      }
    }

    // Make progress on the body from what rbuf holds. Returns zero when the
    // body is complete, a negative number when more bytes are needed, or an
    // error status.
    method advance_body(cfg: const ref Config) i32 {
      var head: i64 = this.request.head_len();
      if (this.body_kind == BODY_NONE) {
        this.request.rebase(this.rbuf.readable_ptr());
        this.request.set_body(null, 0);
        return 0;
      }
      if (this.body_kind == BODY_LENGTH) {
        if (this.rbuf.readable_len() < head + this.raw_body_len) {
          return -1;
        }
        var base: raw_ptr<u8> = this.rbuf.readable_ptr();
        this.request.rebase(base);
        this.request.set_body(unsafe { _ptr_offset(base, head); }, this.raw_body_len);
        return 0;
      }
      return this.decode_chunks(cfg);
    }

    // Decode chunked framing from rbuf into body_buf. Same results as
    // advance_body().
    method decode_chunks(cfg: const ref Config) i32 {
