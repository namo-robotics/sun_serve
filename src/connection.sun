        hpack_header(block, name, handshake.subprotocol);
      }
      h2_frame(this.wbuf, block.readable_len(), H2_HEADERS, H2_END_HEADERS, this.h2_stream);
      this.wbuf.append_bytes(block.readable_ptr(), block.readable_len());
      this.ws_generation = this.activate_websocket(cfg.limits.max_body_bytes);
      this.h2_ws_stream = this.h2_stream;
      this.h2_ws_buf.clear();
      var socket = WebSocketHandle(this.ws_mailbox.clone(), this.ws_generation);
      handler.websocket_open(socket);
    }

