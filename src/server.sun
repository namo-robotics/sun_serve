/*
 * server.sun - Binds listeners, starts workers, and waits for them
 *
 * A Server takes one handler per worker thread. Each worker gets its own
 * clone of the configuration, its own listening sockets (sharing the port
 * through SO_REUSEPORT), and a counted reference to the shared TLS context.
 */

/*
 * Owns server listeners and worker threads.
 */
public module sun_serve {
  using std;
  using std.thread;
  using std.time;

  /*
   * Owns listeners and worker threads with concrete handlers implementing IHandler.
   */
  public class Server<H> {
    var alloc: HeapAllocator;
    var config: Config;
    var handlers: Vec<H>;
    var threads: Vec<Thread<i32>>;
    var stop_cell: Unique<i32>;
    var ports: Vec<i32>;
    var tls: TlsServerContext = TlsServerContext();
    var started: bool = false;

    /*
     * Prepare a server. The number of handlers is the number of worker
     * threads; use online_cpus() to size it. TLS listeners need set_tls() on
     * the config, and the certificate is loaded here so problems surface
     * before any socket is bound.
     */
    init(allocator: const ref HeapAllocator, config: Config, handlers: Vec<H>) throws IError {
      this.alloc = allocator.copy();
      this.handlers = handlers;
      this.threads = Vec<Thread<i32>>(allocator, 8);
      this.stop_cell = this.alloc.create_unique<i32>(0);
      this.ports = Vec<i32>(allocator, 4);
      if (this.handlers.size() == 0) {
        throw Error(-1, "a server needs at least one handler");
      }
      if (config.listen.size() == 0) {
        throw Error(-1, "a server needs at least one listen address");
      }
      if (config.has_tls_listener()) {
        if (not config.has_tls) {
          throw Error(-1, "TLS listeners need a certificate and key");
        }
        this.tls = TlsServerContext(allocator, config.tls, config.http2);
      }
      this.config = config;
    }

    // Stop and join on drop.
    deinit() {
      this.stop();
      this.join();
    }

    /*
     * Bind every listener and start the worker threads. Returns once the
     * workers are running; bind failures throw before any thread starts.
     */
    public method start() void throws IError {
      if (this.started) {
        throw Error(-1, "server already started");
      }
      var workers: i64 = this.handlers.size();
      var specs: i64 = this.config.listen.size();
      this.ports.clear();
      for (var spec: ref ListenSpec in this.config.listen) {
        this.ports.push(spec.port);
      }
      // Bind every socket first so a failure leaves nothing running.
      var all = Vec<ListenerSocket>(this.alloc, workers * specs);
      for (var w: i64 = 0; w < workers; w = w + 1) {
        for (var s: i64 = 0; s < specs; s = s + 1) {
          var spec: ref ListenSpec = this.config.listen[s];
          var l = ListenerSocket(spec.tls, s);
          l.bind(spec.addr, this.ports[s], this.config.backlog);
          if (this.ports[s] == 0) {
            this.ports.set(s, l.local_port());
          }
          all.push(l);
        }
      }
      this.started = true;
      // Hand out the handlers and listeners in order, first worker first.
      for (var id: i32 = 0; id < _convert<i32>(workers); id = id + 1) {
        var handler: H = this.handlers.remove(0);
        var mine = Vec<ListenerSocket>(this.alloc, specs);
        for (var s: i64 = 0; s < specs; s = s + 1) {
          mine.push(all.remove(0));
        }
        var acceptor: TlsAcceptor = this.tls.acceptor();
        var args = WorkerArgs<H>(id, this.config.clone(), handler, mine, StopToken(this.stop_cell), acceptor);
        this.threads.push(spawn((args: WorkerArgs<H>) => i32 { return run_worker<H>(args); }, args));
      }
    }

    /*
     * The port bound for the index-th listen entry, useful after asking
     * for port zero.
     */
    public const method port(index: i64) i32 {
      return this.ports[index];
    }

    // How many worker threads were started.
    public const method worker_count() i64 {
      return this.threads.size();
    }

    // Ask the workers to finish. Returns immediately.
    public method stop() void {
      if (this.stop_cell.is_null()) {
        return;
      }
      atomic_store(this.stop_cell, 1);
    }

    /*
     * Wait for every worker to finish. Returns the number of workers that
     * reported a failure.
     */
    public method join() i32 {
      var failures: i32 = 0;
      while (this.threads.size() > 0) {
        match this.threads.pop() {
          Option.Some(t) => {
            if (t.join() != 0) {
              failures = failures + 1;
            }
          },
          Option.None => {}
        };
      }
      return failures;
    }

    /*
     * Start, then block until stop() is called or a shutdown signal arrives,
     * then join. Returns zero on a clean shutdown.
     */
    public method run() i32 throws IError {
      this.start();
      var tick: Duration = create_duration_millis(this.config.timeouts.tick_ms);
      while (not shutdown_requested() and StopToken(this.stop_cell).load() == 0) {
        sleep(tick);
      }
      this.stop();
      if (this.join() != 0) {
        return 1;
      }
      return 0;
    }
  }
}
