/*
 * log.sun - Per-worker logging that never needs a lock
 *
 * Every log call formats one complete line and hands it to the kernel in a
 * single write, so lines from different workers interleave whole rather than
 * mid-line. Diagnostics go to stderr; access log lines go to stdout.
 */

/*
 * Provides per-worker diagnostic and access logging.
 */
public module sun_serve {

  using std;

  /*
   * How much to say. Each level includes the ones before it, so the integer
   * value of a level orders it.
   */
  public enum LogLevel { Error, Warn, Info, Debug }

  // The tag written at the start of a diagnostic line.
  function level_tag(level: LogLevel) static_ptr<u8> {
    return match level {
      LogLevel.Error => "error",
      LogLevel.Warn => "warn",
      LogLevel.Info => "info",
      LogLevel.Debug => "debug"
    };
  }

  // Parse a level name; unknown names come back as None.
  public function parse_log_level(name: const ref String) Option<LogLevel> {
    if (name.equals_literal("error")) {
      return Option.Some(LogLevel.Error);
    }
    if (name.equals_literal("warn")) {
      return Option.Some(LogLevel.Warn);
    }
    if (name.equals_literal("info")) {
      return Option.Some(LogLevel.Info);
    }
    if (name.equals_literal("debug")) {
      return Option.Some(LogLevel.Debug);
    }
    return Option.None;
  }

  // Formats diagnostics and access records for one worker.
  public class Logger {
    var level: i32;
    var worker: i32;
    var line: ByteBuffer;
    var access_enabled: bool;

    // Build a logger tagged with a worker id.
    init(
      alloc: const ref HeapAllocator,
      level: LogLevel,
      worker: i32,
      access_enabled: bool
    ) std.AllocationResult<void> {
      this.level = _convert<i32>(level);
      this.worker = worker;
      this.line = try ByteBuffer(alloc, 512);
      this.access_enabled = access_enabled;
    }

    // Report whether messages at level would be written.
    public const method enabled(level: LogLevel) bool {
      return _convert<i32>(level) <= this.level;
    }

    // Report whether access log lines are written.
    public const method access_enabled() bool {
      return this.access_enabled;
    }

    // Start a diagnostic line with its level tag and worker id.
    method begin(tag: static_ptr<u8>) std.AllocationResult<void> {
      this.line.clear();
      try this.line.append_literal(tag);
      try this.line.append_literal(" w");
      try this.line.append_i64(_convert<i64>(this.worker));
      try this.line.append_literal(" ");

      return std.AllocationResult.Ok;
    }

    // Finish the current line and write it to fd.
    method flush(fd: i32) std.AllocationResult<void> {
      try this.line.append_byte(b'\n');
      write_all(fd, this.line.readable_ptr(), this.line.readable_len());
      this.line.clear();

      return std.AllocationResult.Ok;
    }

    // Write one diagnostic line made of a message and an optional detail.
    method emit(level: LogLevel, message: static_ptr<u8>, detail: const ref String) std.AllocationResult<void> {
      if (not this.enabled(level)) {
        return std.AllocationResult.Ok;
      }
      try this.begin(level_tag(level));
      try this.line.append_literal(message);
      if (detail.length() > 0) {
        try this.line.append_literal(": ");
        try this.line.append_string(detail);
      }
      try this.flush(std.io.STDERR_FD);
    
      return std.AllocationResult.Ok;
}

    // Log an error with a detail string.
    public method error(message: static_ptr<u8>, detail: const ref String) std.AllocationResult<void> {
      try this.emit(LogLevel.Error, message, detail);
    
      return std.AllocationResult.Ok;
}

    // Log a warning with a detail string.
    public method warn(message: static_ptr<u8>, detail: const ref String) std.AllocationResult<void> {
      try this.emit(LogLevel.Warn, message, detail);
    
      return std.AllocationResult.Ok;
}

    // Log an informational message with a detail string.
    public method info(message: static_ptr<u8>, detail: const ref String) std.AllocationResult<void> {
      try this.emit(LogLevel.Info, message, detail);
    
      return std.AllocationResult.Ok;
}

    // Log a debug message with a detail string.
    public method debug(message: static_ptr<u8>, detail: const ref String) std.AllocationResult<void> {
      try this.emit(LogLevel.Debug, message, detail);
    
      return std.AllocationResult.Ok;
}

    // Log a literal message at the given level with no detail.
    public method log(level: LogLevel, message: static_ptr<u8>) std.AllocationResult<void> {
      try this.emit(level, message, try String(""));

      return std.AllocationResult.Ok;
    }

    /*
     * Log the message text of a caught error.
     */
    public method error_caught(
      message: static_ptr<u8>,
      e: const ref IError
    ) std.AllocationResult<void> {
      try this.error(message, try e.message());

      return std.AllocationResult.Ok;
    }

    /*
     * Write an access log line to stdout. The caller formats the request
     * part; this adds the worker id and a newline.
     */
    public method access(entry: const ref ByteBuffer) std.AllocationResult<void> {
      if (not this.access_enabled) {
        return std.AllocationResult.Ok;
      }
      this.line.clear();
      try this.line.append_literal("w");
      try this.line.append_i64(_convert<i64>(this.worker));
      try this.line.append_literal(" ");
      try this.line.append_bytes(entry.readable_ptr(), entry.readable_len());
      try this.flush(std.io.STDOUT_FD);

      return std.AllocationResult.Ok;
    }
  }
}
