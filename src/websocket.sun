// websocket.sun - Public WebSocket callbacks, handles, and wire helpers

/*
 * Implements WebSocket callbacks, handles, and framing.
 */
public module sun_serve {
  using std;

  extern "C" function ssl_sha1(data: raw_ptr<u8>, len: i64, out: raw_ptr<u8>) raw_ptr<u8> as "SHA1";
  extern "C" function zlib_version() raw_ptr<u8> as "zlibVersion";
  extern "C" function zlib_deflate_init(stream: ref ZStream, level: i32, method: i32, window_bits: i32, memory_level: i32, strategy: i32, version: raw_ptr<u8>, stream_size: i32) i32 as "deflateInit2_";
  extern "C" function zlib_deflate_bound(stream: ref ZStream, source_len: u64) u64 as "deflateBound";
  extern "C" function zlib_deflate(stream: ref ZStream, flush: i32) i32 as "deflate";
  extern "C" function zlib_deflate_end(stream: ref ZStream) i32 as "deflateEnd";
  extern "C" function zlib_inflate_init(stream: ref ZStream, window_bits: i32, version: raw_ptr<u8>, stream_size: i32) i32 as "inflateInit2_";
  extern "C" function zlib_inflate(stream: ref ZStream, flush: i32) i32 as "inflate";
  extern "C" function zlib_inflate_end(stream: ref ZStream) i32 as "inflateEnd";

  const Z_OK: i32 = 0;
  const Z_SYNC_FLUSH: i32 = 2;
  const Z_DEFLATED: i32 = 8;
  const Z_STREAM_SIZE: i32 = 112;
  // The largest byte count zlib's 32-bit stream lengths can describe.
  const ZLIB_MAX_LEN: i64 = 0xffff_ffff;

  // The frame opcodes of RFC 6455, stored as they appear on the wire.
  public enum WebSocketOpcode u8 { Continuation = 0, Text = 1, Binary = 2, Close = 8, Ping = 9, Pong = 10 }

  // The bits of a frame's first byte: FIN, the RSV1 compression flag, and the opcode.
  const WS_FIN: u8 = 0x80;
  const WS_RSV1: u8 = 0x40;
  const WS_RSV23: u8 = 0x30;
  const WS_OPCODE_MASK: u8 = 0x0f;
  // The mask bit and length bits of a frame's second byte.
  const WS_MASKED: u8 = 0x80;
  const WS_LENGTH_MASK: u8 = 0x7f;

  // The permessage-deflate parameters the server negotiates: no context takeover.
  const WS_DEFLATE_PARAMS: static_ptr<u8> = "permessage-deflate; server_no_context_takeover; client_no_context_takeover";

  // The close status sent when the server is shutting down (going away).
  const WS_CLOSE_GOING_AWAY: i32 = 1001;
  // The close status sent when the outbound queue overflowed (try again later).
  const WS_CLOSE_OVERLOADED: i32 = 1013;

  // Report whether an opcode is a control frame.
  function websocket_is_control(opcode: WebSocketOpcode) bool {
    return (_convert<u8>(opcode) & 0x8) != 0;
  }

  // Report whether an opcode starts a data message.
  function websocket_is_data(opcode: WebSocketOpcode) bool {
    return opcode == WebSocketOpcode.Text or opcode == WebSocketOpcode.Binary;
  }

  // The public zlib stream layout on 64-bit Linux.
  class ZStream {
    var next_in: raw_ptr<u8> = null;
    var avail_in: u32 = 0;
    var total_in: u64 = 0;
    var next_out: raw_ptr<u8> = null;
    var avail_out: u32 = 0;
    var total_out: u64 = 0;
    var message: raw_ptr<u8> = null;
    var state: raw_ptr<u8> = null;
    var allocate: raw_ptr<u8> = null;
    var free: raw_ptr<u8> = null;
    var opaque: raw_ptr<u8> = null;
    var data_type: i32 = 0;
    var adler: u64 = 0;
    var reserved: u64 = 0;
  }

  // Notify the owning worker that a handle queued output.
  public function websocket_wake(fd: i32) void {
    if (fd > 0) {
      notify_event_counter(fd);
    }
  }

  // Compress one message as a raw RFC 7692 DEFLATE block.
  public function websocket_deflate(data: const ref ByteBuffer, off: i64, len: i64, out: ref ByteBuffer) bool {
    if (off < 0 or len < 0 or len > ZLIB_MAX_LEN or off > data.readable_len() or len > data.readable_len() - off) {
      return false;
    }
    var stream = ZStream();
    if (unsafe zlib_deflate_init(stream, -1, Z_DEFLATED, -15, 8, 0, zlib_version(), Z_STREAM_SIZE) != Z_OK) {
      return false;
    }
    var bound: u64 = unsafe zlib_deflate_bound(stream, _convert<u64>(len)) + 8;
    if (bound > _convert<u64>(ZLIB_MAX_LEN)) {
      unsafe zlib_deflate_end(stream);
      return false;
    }
    out.reserve(_convert<i64>(bound));
    stream.next_in = unsafe _ptr_offset(data.readable_ptr(), off);
    stream.avail_in = _convert<u32>(len);
    stream.next_out = out.writable_ptr();
    stream.avail_out = _convert<u32>(bound);
    var result: i32 = unsafe zlib_deflate(stream, Z_SYNC_FLUSH);
    var produced: i64 = _convert<i64>(stream.total_out);
    unsafe zlib_deflate_end(stream);
    if (result != Z_OK or stream.avail_in != 0 or produced < 4) {
      return false;
    }
    out.commit(produced - 4);
    return true;
  }

  // Inflate one RFC 7692 message, returning malformed or oversized status.
  public function websocket_inflate(alloc: const ref HeapAllocator, data: const ref ByteBuffer, off: i64, len: i64, max_bytes: i64, out: ref ByteBuffer) i32 {
    if (off < 0 or len < 0 or len > ZLIB_MAX_LEN - 4 or off > data.readable_len() or len > data.readable_len() - off or max_bytes < 0 or max_bytes >= ZLIB_MAX_LEN) {
      return 1;
    }
    var input = ByteBuffer(alloc, len + 4);
    input.append_buffer(data, off, len);
    input.append_literal("\x00\x00\xff\xff");
    out.reserve(max_bytes + 1);
    var stream = ZStream();
    if (unsafe zlib_inflate_init(stream, -15, zlib_version(), Z_STREAM_SIZE) != Z_OK) {
      return 1;
    }
    stream.next_in = input.readable_ptr();
    stream.avail_in = _convert<u32>(input.readable_len());
    stream.next_out = out.writable_ptr();
    stream.avail_out = _convert<u32>(max_bytes + 1);
    var result: i32 = unsafe zlib_inflate(stream, Z_SYNC_FLUSH);
    var produced: i64 = _convert<i64>(stream.total_out);
    unsafe zlib_inflate_end(stream);
    if (produced > max_bytes) {
      return 2;
    }
    if (result != Z_OK or stream.avail_in != 0) {
      return 1;
    }
    out.commit(produced);
    return 0;
  }

  // Compute SHA-1 bytes for the WebSocket opening handshake.
  public function websocket_sha1(source: const ref String, digest: ref ContiguousBuffer<u8>) void {
    unsafe ssl_sha1(source.bytes(), source.length(), digest.raw_data());
  }

  // Distinguishes text messages from binary messages.
  public enum WebSocketMessageKind { Text, Binary }
  // Reports what happened when application data was queued.
  public enum WebSocketSendResult { Queued, Closed, Invalid, Overloaded }

  // A complete decoded WebSocket application message.
  public class WebSocketMessage {
    // Whether the message contains text or binary data.
    public var kind: WebSocketMessageKind;
    var data_: ByteBuffer;

    // Take ownership of a complete message buffer.
    init(kind: WebSocketMessageKind, data: ByteBuffer) {
      this.kind = kind;
      this.data_ = data;
    }

    // The owned message buffer.
    public const method data() ref ByteBuffer {
      return this.data_;
    }

    // The message byte count.
    public const method length() i64 {
      return this.data_.readable_len();
    }

    // Copy the message into an owned string.
    public const method text(alloc: const ref HeapAllocator) String {
      return this.data_.range_text(alloc, 0, this.data_.readable_len());
    }
  }

  // The application decision for a valid WebSocket opening request.
  public class WebSocketHandshake {
    // Whether the application accepted the opening request.
    public var accepted: bool = false;
    // The selected subprotocol, or an empty string when none was selected.
    public var subprotocol: String;
    // Whether compression was negotiated for the connection.
    public var compression: bool;
    // The HTTP status used when the request is rejected.
    public var reject_status: i32 = 404;
    var alloc: HeapAllocator;

    // Start as a rejected handshake.
    init(allocator: const ref HeapAllocator, compression: bool) {
      this.alloc = allocator.copy();
      this.subprotocol = String(allocator, "");
      this.compression = compression;
    }

    // Accept without selecting a subprotocol.
    public method accept() void {
      this.accepted = true;
    }

    // Accept and select one protocol offered by the client.
    public method accept_subprotocol(protocol: static_ptr<u8>) void {
      this.accepted = true;
      this.subprotocol.clear();
      this.subprotocol.append(protocol);
    }

    // Reject with an HTTP status.
    public method reject(status: i32) void {
      this.accepted = false;
      this.reject_status = status;
    }
  }

  // State shared by the worker and every asynchronous handle clone.
  class WebSocketMailbox {
    var active: bool = false;
    var generation: i64 = 0;
    var max_bytes: i64 = 0;
    var compression: bool = false;
    var wake_fd: i32 = 0;
    var queue: ByteBuffer;

    // Build an inactive mailbox.
    init(alloc: const ref HeapAllocator) {
      this.queue = ByteBuffer(alloc, 256);
    }

    // Begin a new session and invalidate handles from an earlier one.
    method activate(max_bytes: i64, compression: bool, wake_fd: i32) i64 {
      this.generation = this.generation + 1;
      this.active = true;
      this.max_bytes = max_bytes;
      this.compression = compression;
      this.wake_fd = wake_fd;
      this.queue.clear();
      return this.generation;
    }

    // Invalidate the current session.
    method deactivate(generation: i64) void {
      if (generation == this.generation) {
        this.active = false;
      }
    }

    // Move queued frames into the worker write buffer.
    method drain(generation: i64, out: ref ByteBuffer) bool {
      if (generation != this.generation) {
        return false;
      }
      out.append_buffer(this.queue, 0, this.queue.readable_len());
      this.queue.clear();
      return this.active;
    }

    // Queue one unmasked server frame.
    method enqueue(generation: i64, opcode: WebSocketOpcode, data: const ref ByteBuffer, off: i64, len: i64) WebSocketSendResult {
      if (generation != this.generation) {
        return WebSocketSendResult.Invalid;
      }
      if (not this.active) {
        return WebSocketSendResult.Closed;
      }
      var wire = ByteBuffer(HeapAllocator(), len + 16);
      var compressed_message: bool = this.compression and websocket_is_data(opcode);
      if (compressed_message) {
        if (not websocket_deflate(data, off, len, wire)) {
          return WebSocketSendResult.Invalid;
        }
      } else {
        wire.append_buffer(data, off, len);
      }
      var wire_len: i64 = wire.readable_len();
      var overhead: i64 = 2;
      if (wire_len >= 126 and wire_len <= 65535) {
        overhead = 4;
      }
      if (wire_len > 65535) {
        overhead = 10;
      }
      if (this.queue.readable_len() + overhead + wire_len > this.max_bytes) {
        this.active = false;
        this.queue.clear();
        websocket_append_close(this.queue, WS_CLOSE_OVERLOADED);
        websocket_wake(this.wake_fd);
        return WebSocketSendResult.Overloaded;
      }
      websocket_append_frame_flags(this.queue, opcode, compressed_message, wire, 0, wire_len);
      if (opcode == WebSocketOpcode.Close) {
        this.active = false;
      }
      websocket_wake(this.wake_fd);
      return WebSocketSendResult.Queued;
    }
  }

  /*
   * One connection's WebSocket session: the shared mailbox behind its handles
   * and the reassembly state of the message being received.
   */
  class WebSocketState {
    var mailbox: Shared<WebSocketMailbox>;
    var generation: i64 = 0;  // handles from earlier sessions are ignored
    var wake_fd: i32 = 0;  // the owning worker's wake descriptor
    var upgrading: bool = false;  // the 101 response is being written
    var fragmenting: bool = false;
    var fragment_compressed: bool = false;
    var fragment_opcode: WebSocketOpcode = WebSocketOpcode.Continuation;
    var compression: bool = false;
    var closing: bool = false;

    // Create the mailbox shared with asynchronous handles.
    init(alloc: const ref HeapAllocator) {
      this.mailbox = Shared<WebSocketMailbox>(alloc, WebSocketMailbox(alloc));
    }

    // Prepare for a new connection owned by the worker behind wake_fd.
    method reset(wake_fd: i32) void {
      this.wake_fd = wake_fd;
      this.upgrading = false;
      this.fragmenting = false;
      this.fragment_compressed = false;
      this.fragment_opcode = WebSocketOpcode.Continuation;
      this.compression = false;
      this.closing = false;
    }

    // Start a new session generation that handles may send into.
    method activate(max_bytes: i64, compression: bool) void {
      this.compression = compression;
      var guard = this.mailbox.lock();
      this.generation = guard.get().activate(max_bytes, compression, this.wake_fd);
    }

    // Move queued asynchronous frames into out. Returns false once deactivated.
    method drain_to(out: ref ByteBuffer) bool {
      var guard = this.mailbox.lock();
      return guard.get().drain(this.generation, out);
    }

    // Invalidate every handle of the current session.
    method deactivate() void {
      var guard = this.mailbox.lock();
      guard.get().deactivate(this.generation);
    }

    // A handle for the application to keep or clone.
    method handle() WebSocketHandle {
      return WebSocketHandle(this.mailbox.clone(), this.generation);
    }
  }

  // A cloneable, thread-safe reference to one WebSocket session.
  public class WebSocketHandle {
    var mailbox: Shared<WebSocketMailbox>;
    var generation: i64;

    // Attach to one mailbox generation.
    init(mailbox: Shared<WebSocketMailbox>, generation: i64) {
      this.mailbox = mailbox;
      this.generation = generation;
    }

    // Create another handle for another thread or owner.
    public const method clone() WebSocketHandle {
      return WebSocketHandle(this.mailbox.clone(), this.generation);
    }

    // Queue a UTF-8 text message.
    public const method send_text(text: const ref String) WebSocketSendResult {
      var bytes = ByteBuffer(HeapAllocator(), text.length());
      bytes.append_string(text);
      if (not websocket_valid_utf8(bytes, 0, bytes.readable_len())) {
        return WebSocketSendResult.Invalid;
      }
      var guard = this.mailbox.lock();
      return guard.get().enqueue(this.generation, WebSocketOpcode.Text, bytes, 0, bytes.readable_len());
    }

    // Queue a binary buffer range.
    public const method send_binary(data: const ref ByteBuffer, off: i64, len: i64) WebSocketSendResult {
      if (off < 0 or len < 0 or off > data.readable_len() or len > data.readable_len() - off) {
        return WebSocketSendResult.Invalid;
      }
      var guard = this.mailbox.lock();
      return guard.get().enqueue(this.generation, WebSocketOpcode.Binary, data, off, len);
    }

    // Queue a ping control-frame buffer range.
    public const method ping(data: const ref ByteBuffer, off: i64, len: i64) WebSocketSendResult {
      if (off < 0 or len < 0 or len > 125 or off > data.readable_len() or len > data.readable_len() - off) {
        return WebSocketSendResult.Invalid;
      }
      var guard = this.mailbox.lock();
      return guard.get().enqueue(this.generation, WebSocketOpcode.Ping, data, off, len);
    }

    // Start a normal close exchange.
    public const method close(code: i32) WebSocketSendResult {
      if (not websocket_valid_close_code(code)) {
        return WebSocketSendResult.Invalid;
      }
      var bytes = ByteBuffer(HeapAllocator(), 2);
      websocket_append_close_code(bytes, code);
      var guard = this.mailbox.lock();
      return guard.get().enqueue(this.generation, WebSocketOpcode.Close, bytes, 0, 2);
    }
  }

  // The header fields of one client frame, parsed ahead of its payload.
  class WebSocketFrame {
    var final_frame: bool = false;
    var compressed: bool = false;
    var opcode: WebSocketOpcode = WebSocketOpcode.Continuation;
    var header_len: i64 = 0;  // bytes before the masking key
    var length: i64 = 0;  // payload byte count

    // Bytes the whole frame occupies: header, masking key, and payload.
    const method total_len() i64 {
      return this.header_len + 4 + this.length;
    }
  }

  // What parsing a frame header found in the bytes so far.
  enum WebSocketParse { Ready, Incomplete, Malformed }

  /*
   * Parse the masked client frame at the start of data into frame.
   * compression says whether RSV1 may be set on data frames. Ready means the
   * header is complete; the payload may still be missing.
   */
  function websocket_parse_frame(data: const ref ByteBuffer, compression: bool, frame: ref WebSocketFrame) WebSocketParse {
    if (data.readable_len() < 2) {
      return WebSocketParse.Incomplete;
    }
    var first: u8 = data.byte_at(0);
    var second: u8 = data.byte_at(1);
    frame.final_frame = (first & WS_FIN) != 0;
    frame.compressed = (first & WS_RSV1) != 0;
    frame.opcode = match _enum_from_int<WebSocketOpcode>(first & WS_OPCODE_MASK) {
      Option.Some(opcode) => opcode,
      Option.None => {
        return WebSocketParse.Malformed;
      }
    };
    if ((first & WS_RSV23) != 0 or (second & WS_MASKED) == 0) {
      return WebSocketParse.Malformed;
    }
    if (frame.compressed and (not compression or not websocket_is_data(frame.opcode))) {
      return WebSocketParse.Malformed;
    }
    frame.header_len = 2;
    frame.length = _convert<i64>(second & WS_LENGTH_MASK);
    if (frame.length == 126) {
      if (data.readable_len() < 4) {
        return WebSocketParse.Incomplete;
      }
      frame.length = (_convert<i64>(data.byte_at(2)) << 8) | _convert<i64>(data.byte_at(3));
      frame.header_len = 4;
    } else if (frame.length == 127) {
      if (data.readable_len() < 10) {
        return WebSocketParse.Incomplete;
      }
      frame.length = 0;
      for (var k: i64 = 2; k < 10; k = k + 1) {
        frame.length = (frame.length << 8) | _convert<i64>(data.byte_at(k));
      }
      frame.header_len = 10;
    }
    if (websocket_is_control(frame.opcode) and (not frame.final_frame or frame.length > 125)) {
      return WebSocketParse.Malformed;
    }
    return WebSocketParse.Ready;
  }

  // Copy a complete frame's payload out of data, removing the client mask.
  function websocket_unmask(alloc: const ref HeapAllocator, data: const ref ByteBuffer, frame: const ref WebSocketFrame) ByteBuffer {
    var mask_pos: i64 = frame.header_len;
    var pos: i64 = mask_pos + 4;
    var decoded = ByteBuffer(alloc, frame.length);
    for (var n: i64 = 0; n < frame.length; n = n + 1) {
      decoded.append_byte(data.byte_at(pos + n) ^ data.byte_at(mask_pos + n % 4));
    }
    return decoded;
  }

  // Append one final unmasked server frame.
  function websocket_append_frame(out: ref ByteBuffer, opcode: WebSocketOpcode, data: const ref ByteBuffer, off: i64, len: i64) void {
    websocket_append_frame_flags(out, opcode, false, data, off, len);
  }

  // Append one final server frame with an optional RSV1 compression flag.
  function websocket_append_frame_flags(out: ref ByteBuffer, opcode: WebSocketOpcode, compressed: bool, data: const ref ByteBuffer, off: i64, len: i64) void {
    var first: u8 = WS_FIN | _convert<u8>(opcode);
    if (compressed) {
      first = first | WS_RSV1;
    }
    out.append_byte(first);
    if (len < 126) {
      out.append_byte(_convert<u8>(len));
    } else if (len <= 0xffff) {
      out.append_byte(126);
      out.append_byte(_convert<u8>((len >> 8) & 0xff));
      out.append_byte(_convert<u8>(len & 0xff));
    } else {
      out.append_byte(127);
      for (var shift: i32 = 56; shift >= 0; shift = shift - 8) {
        out.append_byte(_convert<u8>((len >> shift) & 0xff));
      }
    }
    out.append_buffer(data, off, len);
  }

  // Append a close status code as its two big-endian payload bytes.
  function websocket_append_close_code(out: ref ByteBuffer, code: i32) void {
    out.append_byte(_convert<u8>((code >> 8) & 0xff));
    out.append_byte(_convert<u8>(code & 0xff));
  }

  // Append a complete close frame carrying a status code.
  function websocket_append_close(out: ref ByteBuffer, code: i32) void {
    var payload = ByteBuffer(HeapAllocator(), 2);
    websocket_append_close_code(payload, code);
    websocket_append_frame(out, WebSocketOpcode.Close, payload, 0, 2);
  }

  // The status code carried by a close payload, or 1000 when it has none.
  function websocket_close_code(payload: const ref ByteBuffer) i32 {
    if (payload.readable_len() < 2) {
      return 1000;
    }
    return _convert<i32>(payload.byte_at(0)) * 256 + _convert<i32>(payload.byte_at(1));
  }

  // Validate a received close payload and return its failure close code.
  function websocket_close_payload_status(data: const ref ByteBuffer, len: i64) i32 {
    if (len == 0) {
      return 0;
    }
    if (len == 1) {
      return 1002;
    }
    if (not websocket_valid_close_code(websocket_close_code(data))) {
      return 1002;
    }
    if (len > 2 and not websocket_valid_utf8(data, 2, len - 2)) {
      return 1007;
    }
    return 0;
  }

  // Report whether an application may put a status code on the wire.
  function websocket_valid_close_code(code: i32) bool {
    if (code >= 3000 and code <= 4999) {
      return true;
    }
    if (code < 1000 or code > 1014) {
      return false;
    }
    return code != 1004 and code != 1005 and code != 1006;
  }

  // Report whether bytes are canonical UTF-8.
  function websocket_valid_utf8(data: const ref ByteBuffer, off: i64, len: i64) bool {
    var i: i64 = 0;
    while (i < len) {
      var a: u8 = data.byte_at(off + i);
      if (a < 128) {
        i = i + 1;
        continue;
      }
      var need: i64 = 0;
      if (a >= 194 and a <= 223) {
        need = 1;
      } else if (a >= 224 and a <= 239) {
        need = 2;
      } else if (a >= 240 and a <= 244) {
        need = 3;
      } else {
        return false;
      }
      if (i + need >= len) {
        return false;
      }
      for (var j: i64 = 1; j <= need; j = j + 1) {
        var c: u8 = data.byte_at(off + i + j);
        if (c < 128 or c > 191) {
          return false;
        }
      }
      var b: u8 = data.byte_at(off + i + 1);
      if (a == 224 and b < 160) {
        return false;
      }
      if (a == 237 and b > 159) {
        return false;
      }
      if (a == 240 and b < 144) {
        return false;
      }
      if (a == 244 and b > 143) {
        return false;
      }
      i = i + need + 1;
    }
    return true;
  }

  // Report whether an extension list contains a permessage-deflate offer.
  function websocket_offers_deflate(alloc: const ref HeapAllocator, value: const ref String) bool {
    var offers: Vec<String> = value.split(alloc, b',');
    for (var offer: ref String in offers) {
      // The extension name ends at the first parameter separator.
      var parts: Vec<String> = offer.split(alloc, b';');
      var name: String = parts[0].clone(alloc);
      name.trim();
      name.to_lower();
      if (name.equals_literal("permessage-deflate")) {
        return true;
      }
    }
    return false;
  }

  // Validate the canonical base64 shape of a 16-byte WebSocket nonce.
  function websocket_valid_key(key: const ref String) bool {
    if (key.length() != 24 or string_byte(key, 22) != b'=' or string_byte(key, 23) != b'=') {
      return false;
    }
    for (var i: i64 = 0; i < 22; i = i + 1) {
      var c: u8 = string_byte(key, i);
      if (not ((c >= b'A' and c <= b'Z') or (c >= b'a' and c <= b'z') or (c >= b'0' and c <= b'9') or c == b'+' or c == b'/')) {
        return false;
      }
    }
    return true;
  }

  // Compute the RFC 6455 Sec-WebSocket-Accept value.
  function websocket_accept(alloc: const ref HeapAllocator, key: const ref String) String {
    var source = String(alloc, "");
    source.append(key);
    source.append("258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
    var digest = ContiguousBuffer<u8>(alloc, 20);
    websocket_sha1(source, digest);
    var alphabet: static_ptr<u8> = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var out = String(alloc, "");
    for (var i: i64 = 0; i < 20; i = i + 3) {
      var left: i64 = 20 - i;
      var n: i32 = _convert<i32>(digest[i]) << 16;
      if (left > 1) {
        n = n | (_convert<i32>(digest[i + 1]) << 8);
      }
      if (left > 2) {
        n = n | _convert<i32>(digest[i + 2]);
      }
      out.append_char(literal_byte(alphabet, _convert<i64>((n >> 18) & 63)));
      out.append_char(literal_byte(alphabet, _convert<i64>((n >> 12) & 63)));
      if (left > 1) {
        out.append_char(literal_byte(alphabet, _convert<i64>((n >> 6) & 63)));
      } else {
        out.append_char(b'=');
      }
      if (left > 2) {
        out.append_char(literal_byte(alphabet, _convert<i64>(n & 63)));
      } else {
        out.append_char(b'=');
      }
    }
    return out;
  }
}
