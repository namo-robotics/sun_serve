// websocket.sun - Public WebSocket callbacks, handles, and wire helpers

public module sun_serve {
  using std;

  extern "C" function ssl_sha1(data: raw_ptr<u8>, len: i64, out: raw_ptr<u8>) raw_ptr<u8> as "SHA1";
  extern "C" function zlib_version() raw_ptr<u8> as "zlibVersion";
  extern "C" function zlib_deflate_init(stream: ref ZStream, level: i32, method: i32, window_bits: i32, memory_level: i32, strategy: i32, version: raw_ptr<u8>, stream_size: i32) i32 as "deflateInit2_";
  extern "C" function zlib_deflate_bound(stream: ref ZStream, source_len: u64) u64 as "deflateBound";
  extern "C" function zlib_deflate(stream: ref ZStream, flush: i32) i32 as "deflate";
  extern "C" function zlib_deflate_end(stream: ref ZStream) i32 as "deflateEnd";
  extern "C" function zlib_inflate_init(stream: ref ZStream, window_bits: i32, version: raw_ptr<u8>, stream_size: i32) i32 as "inflateInit2_";
  extern "C" function zlib_inflate(stream: ref ZStream, flush: i32) i32 as "inflate";
  extern "C" function zlib_inflate_end(stream: ref ZStream) i32 as "inflateEnd";

  const Z_OK: i32 = 0;
  const Z_SYNC_FLUSH: i32 = 2;
  const Z_DEFLATED: i32 = 8;
  const Z_STREAM_SIZE: i32 = 112;

  // The public zlib stream layout on 64-bit Linux.
  class ZStream {
    var next_in: raw_ptr<u8>;
    var avail_in: u32;
    var total_in: u64;
    var next_out: raw_ptr<u8>;
    var avail_out: u32;
    var total_out: u64;
    var message: raw_ptr<u8>;
    var state: raw_ptr<u8>;
    var allocate: raw_ptr<u8>;
    var free: raw_ptr<u8>;
    var opaque: raw_ptr<u8>;
    var data_type: i32;
    var adler: u64;
    var reserved: u64;

    // Initialize a stream for zlib to populate.
    init() {
      this.next_in = null;
      this.avail_in = 0;
      this.total_in = 0;
      this.next_out = null;
      this.avail_out = 0;
      this.total_out = 0;
      this.message = null;
      this.state = null;
      this.allocate = null;
      this.free = null;
      this.opaque = null;
      this.data_type = 0;
      this.adler = 0;
      this.reserved = 0;
    }
  }

  public enum WebSocketMessageKind { Text, Binary }
  public enum WebSocketSendResult { Queued, Closed, Invalid, Overloaded }

  // A complete decoded WebSocket application message.
  public class WebSocketMessage {
    public var kind: WebSocketMessageKind;
    var data_: raw_ptr<u8>;
    var len_: i64;

    // View a message buffer for the duration of its callback.
    init(kind: WebSocketMessageKind, data: raw_ptr<u8>, len: i64) {
      this.kind = kind;
      this.data_ = data;
      this.len_ = len;
    }

    // The message bytes.
    public const method data() raw_ptr<u8> {
      return this.data_;
    }

    // The message byte count.
    public const method length() i64 {
      return this.len_;
    }

    // Copy the message into an owned string.
    public const method text(alloc: const ref HeapAllocator) String {
      return bytes_to_string(alloc, this.data_, 0, this.len_);
    }
  }

  // The application decision for a valid WebSocket opening request.
  public class WebSocketHandshake {
    public var accepted: bool;
    public var subprotocol: String;
    public var compression: bool;
    public var reject_status: i32;
    var alloc: HeapAllocator;

    // Start as a rejected handshake.
    init(allocator: const ref HeapAllocator, compression: bool) {
      this.alloc = allocator.copy();
      this.accepted = false;
      this.subprotocol = String(allocator, "");
      this.compression = compression;
      this.reject_status = 404;
    }

    // Accept without selecting a subprotocol.
    public method accept() void {
      this.accepted = true;
    }

    // Accept and select one protocol offered by the client.
    public method accept_subprotocol(protocol: static_ptr<u8>) void {
      this.accepted = true;
      this.subprotocol.clear();
      this.subprotocol.append(protocol);
    }

    // Reject with an HTTP status.
    public method reject(status: i32) void {
      this.accepted = false;
      this.reject_status = status;
    }
  }

  // State shared by the worker and every asynchronous handle clone.
  class WebSocketMailbox {
    var active: bool;
    var generation: i64;
    var max_bytes: i64;
    var compression: bool;
    var wake_fd: i32;
    var queue: ByteBuffer;

    // Build an inactive mailbox.
    init(alloc: const ref HeapAllocator) {
      this.active = false;
      this.generation = 0;
      this.max_bytes = 0;
      this.compression = false;
      this.wake_fd = 0;
      this.queue = ByteBuffer(alloc, 256);
    }

    // Begin a new session and invalidate handles from an earlier one.
    method activate(max_bytes: i64, compression: bool, wake_fd: i32) i64 {
      this.generation = this.generation + 1;
      this.active = true;
      this.max_bytes = max_bytes;
      this.compression = compression;
      this.wake_fd = wake_fd;
      this.queue.clear();
      return this.generation;
    }

    // Invalidate the current session.
    method deactivate(generation: i64) void {
      if (generation == this.generation) {
        this.active = false;
      }
    }

    // Move queued frames into the worker write buffer.
    method drain(generation: i64, out: ref ByteBuffer) bool {
      if (generation != this.generation) {
        return false;
      }
      out.append_bytes(this.queue.readable_ptr(), this.queue.readable_len());
      this.queue.clear();
      return this.active;
    }

    // Queue one unmasked server frame.
    method enqueue(generation: i64, opcode: u8, data: raw_ptr<u8>, len: i64) WebSocketSendResult {
      if (generation != this.generation) {
        return WebSocketSendResult.Invalid;
      }
      if (not this.active) {
        return WebSocketSendResult.Closed;
      }
      var compressed = ByteBuffer(HeapAllocator(), 16);
      var wire_data: raw_ptr<u8> = data;
      var wire_len: i64 = len;
      var compressed_message: bool = this.compression and (opcode == 1 or opcode == 2);
      if (compressed_message) {
        if (not websocket_deflate(data, len, compressed)) {
          return WebSocketSendResult.Invalid;
        }
        wire_data = compressed.readable_ptr();
        wire_len = compressed.readable_len();
      }
      var overhead: i64 = 2;
      if (wire_len >= 126 and wire_len <= 65535) {
        overhead = 4;
      }
      if (wire_len > 65535) {
        overhead = 10;
      }
      if (this.queue.readable_len() + overhead + wire_len > this.max_bytes) {
        this.active = false;
        this.queue.clear();
        var close_bytes = ContiguousBuffer<u8>(HeapAllocator(), 2);
        close_bytes.set_unchecked(0, 3);
        close_bytes.set_unchecked(1, 245);
        websocket_append_frame(this.queue, _convert<u8>(8), close_bytes.raw_data(), _convert<i64>(2));
        websocket_wake(this.wake_fd);
        return WebSocketSendResult.Overloaded;
      }
      websocket_append_frame_flags(this.queue, opcode, compressed_message, wire_data, wire_len);
      if (opcode == 8) {
        this.active = false;
      }
      websocket_wake(this.wake_fd);
      return WebSocketSendResult.Queued;
    }
  }

  // A cloneable, thread-safe reference to one WebSocket session.
  public class WebSocketHandle {
    var mailbox: Shared<WebSocketMailbox>;
    var generation: i64;

    // Attach to one mailbox generation.
    init(mailbox: Shared<WebSocketMailbox>, generation: i64) {
      this.mailbox = mailbox;
      this.generation = generation;
    }

    // Create another handle for another thread or owner.
    public const method clone() WebSocketHandle {
      return WebSocketHandle(this.mailbox.clone(), this.generation);
    }

    // Queue a UTF-8 text message.
    public const method send_text(text: ref String) WebSocketSendResult {
      if (not websocket_valid_utf8(text.c_str(), text.length())) {
        return WebSocketSendResult.Invalid;
      }
      var guard = this.mailbox.lock();
      return guard.get().enqueue(this.generation, _convert<u8>(1), text.c_str(), text.length());
    }

    // Queue a binary message.
    public const method send_binary(data: raw_ptr<u8>, len: i64) WebSocketSendResult {
      if (len < 0) {
        return WebSocketSendResult.Invalid;
      }
      var guard = this.mailbox.lock();
      return guard.get().enqueue(this.generation, _convert<u8>(2), data, len);
    }

    // Queue a ping control frame.
    public const method ping(data: raw_ptr<u8>, len: i64) WebSocketSendResult {
      if (len < 0 or len > 125) {
        return WebSocketSendResult.Invalid;
      }
      var guard = this.mailbox.lock();
      return guard.get().enqueue(this.generation, _convert<u8>(9), data, len);
    }

    // Start a normal close exchange.
    public const method close(code: i32) WebSocketSendResult {
      if (not websocket_valid_close_code(code)) {
        return WebSocketSendResult.Invalid;
      }
      var bytes = ContiguousBuffer<u8>(HeapAllocator(), 2);
      bytes.set_unchecked(0, _convert<u8>((code >> 8) & 255));
      bytes.set_unchecked(1, _convert<u8>(code & 255));
      var guard = this.mailbox.lock();
      return guard.get().enqueue(this.generation, _convert<u8>(8), bytes.raw_data(), 2);
    }
  }

  // Notify the owning worker that a handle queued output.
  function websocket_wake(fd: i32) void {
    if (fd <= 0) {
      return;
    }
    var one: u64 = 1;
    unsafe { sys_write_u64(fd, _address_of<u64>(one), 8); };
  }

  // Compress one message as a raw RFC 7692 DEFLATE block.
  function websocket_deflate(data: raw_ptr<u8>, len: i64, out: ref ByteBuffer) bool {
    if (len < 0 or len > 4294967295) {
      return false;
    }
    var stream = ZStream();
    if (unsafe { zlib_deflate_init(stream, -1, Z_DEFLATED, -15, 8, 0, zlib_version(), Z_STREAM_SIZE); } != Z_OK) {
      return false;
    }
    var bound: u64 = unsafe { zlib_deflate_bound(stream, _convert<u64>(len)); } + 8;
    if (bound > 4294967295) {
      unsafe { zlib_deflate_end(stream); };
      return false;
    }
    out.reserve(_convert<i64>(bound));
    stream.next_in = data;
    stream.avail_in = _convert<u32>(len);
    stream.next_out = out.writable_ptr();
    stream.avail_out = _convert<u32>(bound);
    var result: i32 = unsafe { zlib_deflate(stream, Z_SYNC_FLUSH); };
    var produced: i64 = _convert<i64>(stream.total_out);
    unsafe { zlib_deflate_end(stream); };
    if (result != Z_OK or stream.avail_in != 0 or produced < 4) {
      return false;
    }
    out.commit(produced - 4);
    return true;
  }

  // Inflate one RFC 7692 message, returning malformed or oversized status.
  function websocket_inflate(alloc: const ref HeapAllocator, data: raw_ptr<u8>, len: i64, max_bytes: i64, out: ref ByteBuffer) i32 {
    if (len < 0 or len > 4294967291 or max_bytes < 0 or max_bytes >= 4294967295) {
      return 1;
    }
    var input = ByteBuffer(alloc, len + 4);
    input.append_bytes(data, len);
    input.append_byte(0);
    input.append_byte(0);
    input.append_byte(255);
    input.append_byte(255);
    out.reserve(max_bytes + 1);
    var stream = ZStream();
    if (unsafe { zlib_inflate_init(stream, -15, zlib_version(), Z_STREAM_SIZE); } != Z_OK) {
      return 1;
    }
    stream.next_in = input.readable_ptr();
    stream.avail_in = _convert<u32>(input.readable_len());
    stream.next_out = out.writable_ptr();
    stream.avail_out = _convert<u32>(max_bytes + 1);
    var result: i32 = unsafe { zlib_inflate(stream, Z_SYNC_FLUSH); };
    var produced: i64 = _convert<i64>(stream.total_out);
    unsafe { zlib_inflate_end(stream); };
    if (produced > max_bytes) {
      return 2;
    }
    if (result != Z_OK or stream.avail_in != 0) {
      return 1;
    }
    out.commit(produced);
    return 0;
  }

  // Append one final unmasked server frame.
  function websocket_append_frame(out: ref ByteBuffer, opcode: u8, data: raw_ptr<u8>, len: i64) void {
    websocket_append_frame_flags(out, opcode, false, data, len);
  }

  // Append one final server frame with an optional RSV1 compression flag.
  function websocket_append_frame_flags(out: ref ByteBuffer, opcode: u8, compressed: bool, data: raw_ptr<u8>, len: i64) void {
    var first: u8 = 128 | opcode;
    if (compressed) {
      first = first | 64;
    }
    out.append_byte(first);
    if (len < 126) {
      out.append_byte(_convert<u8>(len));
    } else if (len <= 65535) {
      out.append_byte(126);
      out.append_byte(_convert<u8>((len >> 8) & 255));
      out.append_byte(_convert<u8>(len & 255));
    } else {
      out.append_byte(127);
      for (var shift: i32 = 56; shift >= 0; shift = shift - 8) {
        out.append_byte(_convert<u8>((len >> shift) & 255));
      }
    }
    out.append_bytes(data, len);
  }

  // Validate a received close payload and return its failure close code.
  function websocket_close_payload_status(data: raw_ptr<u8>, len: i64) i32 {
    if (len == 0) {
      return 0;
    }
    if (len == 1) {
      return 1002;
    }
    var code: i32 = _convert<i32>(unsafe { _load<u8>(data, 0); }) * 256 + _convert<i32>(unsafe { _load<u8>(data, 1); });
    if (not websocket_valid_close_code(code)) {
      return 1002;
    }
    if (len > 2 and not websocket_valid_utf8(unsafe { _ptr_offset(data, 2); }, len - 2)) {
      return 1007;
    }
    return 0;
  }

  // Report whether an application may put a status code on the wire.
  function websocket_valid_close_code(code: i32) bool {
    if (code >= 3000 and code <= 4999) {
      return true;
    }
    if (code < 1000 or code > 1014) {
      return false;
    }
    return code != 1004 and code != 1005 and code != 1006;
  }

  // Report whether bytes are canonical UTF-8.
  function websocket_valid_utf8(data: raw_ptr<u8>, len: i64) bool {
    var i: i64 = 0;
    while (i < len) {
      var a: u8 = unsafe { _load<u8>(data, i); };
      if (a < 128) {
        i = i + 1;
        continue;
      }
      var need: i64 = 0;
      if (a >= 194 and a <= 223) {
        need = 1;
      } else if (a >= 224 and a <= 239) {
        need = 2;
      } else if (a >= 240 and a <= 244) {
        need = 3;
      } else {
        return false;
      }
      if (i + need >= len) {
        return false;
      }
      for (var j: i64 = 1; j <= need; j = j + 1) {
        var c: u8 = unsafe { _load<u8>(data, i + j); };
        if (c < 128 or c > 191) {
          return false;
        }
      }
      var b: u8 = unsafe { _load<u8>(data, i + 1); };
      if (a == 224 and b < 160) {
        return false;
      }
      if (a == 237 and b > 159) {
        return false;
      }
      if (a == 240 and b < 144) {
        return false;
      }
      if (a == 244 and b > 143) {
        return false;
      }
      i = i + need + 1;
    }
    return true;
  }

  // Report whether an extension list contains a permessage-deflate offer.
  function websocket_offers_deflate(value: ref String) bool {
    var pos: i64 = 0;
    while (pos < value.length()) {
      while (pos < value.length() and (value.at(pos) == b' ' or value.at(pos) == b'\t' or value.at(pos) == b',')) {
        pos = pos + 1;
      }
      var start: i64 = pos;
      while (pos < value.length() and value.at(pos) != b';' and value.at(pos) != b',') {
        pos = pos + 1;
      }
      var end: i64 = pos;
      while (end > start and (value.at(end - 1) == b' ' or value.at(end - 1) == b'\t')) {
        end = end - 1;
      }
      var token: static_ptr<u8> = "permessage-deflate";
      if (end - start == token.length()) {
        var equal: bool = true;
        for (var i: i64 = 0; i < token.length(); i = i + 1) {
          if (lower_ascii(value.at(start + i)) != unsafe { _load<u8>(token.raw(), i); }) {
            equal = false;
          }
        }
        if (equal) {
          return true;
        }
      }
      while (pos < value.length() and value.at(pos) != b',') {
        pos = pos + 1;
      }
    }
    return false;
  }

  // Validate the canonical base64 shape of a 16-byte WebSocket nonce.
  function websocket_valid_key(key: ref String) bool {
    if (key.length() != 24 or key.at(22) != b'=' or key.at(23) != b'=') {
      return false;
    }
    for (var i: i64 = 0; i < 22; i = i + 1) {
      var c: u8 = key.at(i);
      if (not ((c >= b'A' and c <= b'Z') or (c >= b'a' and c <= b'z') or (c >= b'0' and c <= b'9') or c == b'+' or c == b'/')) {
        return false;
      }
    }
    return true;
  }

  // Compute the RFC 6455 Sec-WebSocket-Accept value.
  function websocket_accept(alloc: const ref HeapAllocator, key: ref String) String {
    var source = String(alloc, "");
    source.append(key);
    source.append("258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
    var digest = ContiguousBuffer<u8>(alloc, 20);
    unsafe { ssl_sha1(source.c_str(), source.length(), digest.raw_data()); };
    var alphabet: static_ptr<u8> = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var out = String(alloc, "");
    for (var i: i64 = 0; i < 20; i = i + 3) {
      var left: i64 = 20 - i;
      var n: i32 = _convert<i32>(digest.get_unchecked(i)) << 16;
      if (left > 1) {
        n = n | (_convert<i32>(digest.get_unchecked(i + 1)) << 8);
      }
      if (left > 2) {
        n = n | _convert<i32>(digest.get_unchecked(i + 2));
      }
      out.append_char(unsafe { _load<u8>(alphabet.raw(), _convert<i64>((n >> 18) & 63)); });
      out.append_char(unsafe { _load<u8>(alphabet.raw(), _convert<i64>((n >> 12) & 63)); });
      if (left > 1) {
        out.append_char(unsafe { _load<u8>(alphabet.raw(), _convert<i64>((n >> 6) & 63)); });
      } else {
        out.append_char(b'=');
      }
      if (left > 2) {
        out.append_char(unsafe { _load<u8>(alphabet.raw(), _convert<i64>(n & 63)); });
      } else {
        out.append_char(b'=');
      }
    }
    return out;
  }
}
