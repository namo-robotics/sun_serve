// hello_handler.sun - The smallest program built on sun_serve
//
// Build:  sun -c sun-config.json        (produces build/hello_handler)
// Run:    build/hello_handler            (then curl http://127.0.0.1:8080/hi?name=sun)
//
// The library is compiled in from source through the $SUN_SERVE_SRC path
// variable in sun-config.json. Importing build/sun_serve.moon instead is
// blocked by two compiler issues recorded in SUN_FEEDBACK.md.

using std;
using sun_serve;

// Answer /hi with a greeting and everything else with 404.
function hello(req: const ref Request, resp: ref Response) void {
  var alloc = make_heap_allocator();
  if (req.path_is("/hi")) {
    var fallback = String(alloc, "world");
    var name: String = match req.query_param("name", alloc) {
      Option.Some(n) => n,
      Option.None => fallback
    };
    var body = String(alloc, "hello, ");
    body.append(name);
    body.append("\n");
    resp.set_content_type("text/plain");
    resp.set_body_string(body);
    return;
  }
  resp.set_status(404);
  resp.set_content_type("text/plain");
  resp.set_body("not here\n");
}

function main() i32 {
  var alloc = make_heap_allocator();
  var cfg = Config(alloc);
  cfg.add_listen(ipv4_any(), 8080);
  try {
    install_signal_handlers();
    var server = Server(alloc, cfg, fn_handlers(alloc, hello, online_cpus()));
    return server.run();
  } catch (e: IError) {
    var msg: String = e.message();
    eprintln(msg);
    return 1;
  }
}

manifest {
  source_files: [
    "$SUN_SERVE_SRC/version.sun",
    "$SUN_SERVE_SRC/sys_ffi.sun",
    "$SUN_SERVE_SRC/abi_linux.sun",
    "$SUN_SERVE_SRC/buffer.sun",
    "$SUN_SERVE_SRC/net.sun",
    "$SUN_SERVE_SRC/epoll.sun",
    "$SUN_SERVE_SRC/log.sun",
    "$SUN_SERVE_SRC/config.sun",
    "$SUN_SERVE_SRC/http/status.sun",
    "$SUN_SERVE_SRC/http/date.sun",
    "$SUN_SERVE_SRC/http/mime.sun",
    "$SUN_SERVE_SRC/http/request.sun",
    "$SUN_SERVE_SRC/http/response.sun",
    "$SUN_SERVE_SRC/handler.sun",
    "$SUN_SERVE_SRC/tls/openssl_server.sun",
    "$SUN_SERVE_SRC/tls/tls_context.sun",
    "$SUN_SERVE_SRC/tls/tls_session.sun",
    "$SUN_SERVE_SRC/transport.sun",
    "$SUN_SERVE_SRC/signals.sun",
    "$SUN_SERVE_SRC/connection.sun",
    "$SUN_SERVE_SRC/worker.sun",
    "$SUN_SERVE_SRC/server.sun",
    "$SUN_SERVE_SRC/static_files.sun"
  ]
  libraries: ["stdlib.moon", "tls.moon"]
}
