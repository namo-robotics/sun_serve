/*
 * main.sun - A custom handler built on the sun_serve library
 *
 * The sun_serve binary only serves files. This program shows the other way
 * to use sun_serve: link the library and answer requests yourself with a
 * handler class. It keeps per-worker state (a request counter), reads query
 * parameters and request bodies, and falls through to a not-found response.
 *
 * Build from the repository root with `sun -c sun-config.json`, which
 * produces build/hello_handler and build/hello_handler_test. Then:
 *
 *   build/hello_handler
 * Set SERVER to the address printed at startup, then try:
 *   curl "${SERVER}/hi?name=sun"
 *   curl -d 'ping' "${SERVER}/echo"
 *   curl "${SERVER}/stats"
 *   websocat "${SERVER/http:/ws:}/ws"
 *
 * The program links build/sun_serve.moon, which sun-config.json builds before
 * this example.
 */

using std;
using sun_serve;

/*
 * Implements the custom handler example.
 */
module hello_handler {

  using std;
  using sun_serve;

  /*
   * Answers a few routes and counts the requests it has handled. Each worker
   * thread owns one instance, so the counter needs no locking.
   */
  public class HelloHandler implements IHandler {
    var served: i64 = 0;
    var alloc: HeapAllocator;

    // Start with an empty counter.
    init(allocator: const ref HeapAllocator) {
      this.alloc = allocator.copy();
    }

    // Route the request by path.
    public method handle_result(req: const ref Request, resp: ref Response) void throws {
      this.served = this.served + 1;
      if (req.path_is("/hi")) {
        this.greet(req, resp);
      } else if (req.path_is("/echo")) {
        this.echo(req, resp);
      } else if (req.path_is("/stats")) {
        this.stats(resp);
      } else {
        resp.set_status(404);
        resp.set_content_type("text/plain");
        resp.set_body("not here\n");
      }

      return;
    }

    /** Runs the callback and terminates if its response storage cannot be allocated. */
    public method handle(req: const ref Request, resp: ref Response) void {
      try {
        this.handle_result(req, resp);
      } catch {
        _panic("allocation failed in server callback");
      }
    }

    // GET /hi?name=NAME greets NAME, or "world" without a name.
    method greet(req: const ref Request, resp: ref Response) void throws {
      var fallback = String(this.alloc, "world");
      var name: String = match req.query_param("name", this.alloc) {
        Option.Some(n) => n,
        Option.None => fallback
      };
      var body = String(this.alloc, "hello, ");
      body.append(name);
      body.append("\n");
      resp.set_content_type("text/plain");
      resp.set_body_string(body);

      return;
    }

    // POST /echo sends the request body straight back.
    method echo(req: const ref Request, resp: ref Response) void throws {
      if (not req.method_is("POST")) {
        resp.set_status(405);
        resp.add_header("Allow", "POST");
        resp.set_content_type("text/plain");
        resp.set_body("POST a body to /echo\n");
        return;
      }
      resp.set_content_type("application/octet-stream");
      resp.set_body_buffer(req.body_buffer(), 0, req.body_len());

      return;
    }

    // GET /stats reports how many requests this worker has handled.
    method stats(resp: ref Response) void throws {
      var body = String(this.alloc, "requests handled by this worker: ");

      body.append(this.served);
      body.append("\n");
      resp.set_content_type("text/plain");
      resp.set_body_string(body);

      return;
    }

    // Accept WebSocket echo sessions on /ws.
    public method handle_websocket(req: const ref Request, handshake: ref WebSocketHandshake) void {
      if (req.path_is("/ws")) {
        handshake.accept();
      }
    }

    // A new echo session needs no setup.
    public method websocket_open(socket: const ref WebSocketHandle) void {}

    // Echo complete text and binary messages.
    public method websocket_message_result(
      socket: const ref WebSocketHandle,
      message: const ref WebSocketMessage
    ) void throws {
      if (message.kind == WebSocketMessageKind.Text) {
        var text = message.text(this.alloc);
        socket.send_text(text);
      } else {
        socket.send_binary(message.data(), 0, message.length());
      }

      return;
    }

    /** Runs the callback and terminates if its response storage cannot be allocated. */
    public method websocket_message(
      socket: const ref WebSocketHandle,
      message: const ref WebSocketMessage
    ) void {
      try {
        this.websocket_message_result(socket, message);
      } catch {
        _panic("allocation failed in server callback");
      }
    }

    // Echo sessions keep no close state.
    public method websocket_close(socket: const ref WebSocketHandle, code: i32) void {}

    // Echo sessions keep no error state.
    public method websocket_error(socket: const ref WebSocketHandle, code: i32) void {}
  }

  /*
   * Builds one HelloHandler per worker for the server to own.
   */
  public function hello_handlers(
    alloc: const ref HeapAllocator,
    count: i32
  ) Vec<HelloHandler> throws {
    var out = Vec<HelloHandler>(alloc, _convert<i64>(count));
    for (var i: i32 = 0; i < count; i = i + 1) {
      out.push(HelloHandler(alloc));
    }
    return out;
  }
}

/* Serve on every interface until SIGINT or SIGTERM. */
function serve() i32 throws {
  var alloc = make_heap_allocator();
  var cfg = Config(alloc);
  cfg.add_listen(std.net.ipv4_any(), 8080);
  install_signal_handlers();
  var server = Server<hello_handler.HelloHandler>(
    alloc,
    cfg,
    hello_handler.hello_handlers(alloc, online_cpus())
  );
  return server.run();
}

/* Report startup failures and return the server exit status. */
function main() i32 throws {
  try {
    var status = serve();
    return status;
  } catch (e: std.Error) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.AllocationError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.InvalidArgumentError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.OverflowError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.IndexOutOfBoundsError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.NotFoundError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.EmptyError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.IOError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.ConversionError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.DivisionByZeroError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.ArithmeticError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.json.JsonError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.xml.XmlError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: std.ProtoDecodeError) {
    std.io.eprintln(e.message());
    return 1;
  } catch (e: sun_serve.TlsError) {
    std.io.eprintln(e.message());
    return 1;
  }
}

manifest {
  test_files: [
    "hello_tests.sun"
  ]
  libraries: [
    "stdlib.moon",
    "sun_serve.moon"
  ]
}
