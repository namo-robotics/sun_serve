// main.sun - A custom handler built on the sun_serve library
//
// The sun_serve binary only serves files. This program shows the other way
// to use sun_serve: link the library and answer requests yourself with a
// handler class. It keeps per-worker state (a request counter), reads query
// parameters and request bodies, and falls through to a 404.
//
// Build from the repository root with `sun -c sun-config.json`, which
// produces build/hello_handler and build/hello_handler_test. Then:
//
//   build/hello_handler
//   curl 'http://127.0.0.1:8080/hi?name=sun'
//   curl -d 'ping' http://127.0.0.1:8080/echo
//   curl http://127.0.0.1:8080/stats
//
// The library is compiled in from source through the $SUN_SERVE_SRC path
// variable in sun-config.json. Importing build/sun_serve.moon instead is
// blocked by two compiler issues recorded in SUN_FEEDBACK.md.

using std;
using sun_serve;

module hello_handler {
  using std;
  using sun_serve;

  // Answers a few routes and counts the requests it has handled. Each worker
  // thread owns one instance, so the counter needs no locking.
  public class HelloHandler implements IHandler {
    var served: i64;
    var alloc: HeapAllocator;

    // Start with an empty counter.
    init(allocator: const ref HeapAllocator) {
      this.alloc = allocator.copy();
      this.served = 0;
    }

    // Route the request by path.
    public method handle(req: const ref Request, resp: ref Response) void {
      this.served = this.served + 1;
      if (req.path_is("/hi")) {
        this.greet(req, resp);
      } else if (req.path_is("/echo")) {
        this.echo(req, resp);
      } else if (req.path_is("/stats")) {
        this.stats(resp);
      } else {
        resp.set_status(404);
        resp.set_content_type("text/plain");
        resp.set_body("not here\n");
      }
    }

    // GET /hi?name=NAME greets NAME, or "world" without a name.
    method greet(req: const ref Request, resp: ref Response) void {
      var fallback = String(this.alloc, "world");
      var name: String = match req.query_param("name", this.alloc) {
        Option.Some(n) => n,
        Option.None => fallback
      };
      var body = String(this.alloc, "hello, ");
      body.append(name);
      body.append("\n");
      resp.set_content_type("text/plain");
      resp.set_body_string(body);
    }

    // POST /echo sends the request body straight back.
    method echo(req: const ref Request, resp: ref Response) void {
      if (not req.method_is("POST")) {
        resp.set_status(405);
        resp.add_header("Allow", "POST");
        resp.set_content_type("text/plain");
        resp.set_body("POST a body to /echo\n");
        return;
      }
      resp.set_content_type("application/octet-stream");
      resp.set_body_bytes(req.body_ptr(), req.body_len());
    }

    // GET /stats reports how many requests this worker has handled.
    method stats(resp: ref Response) void {
      var body = String(this.alloc, "requests handled by this worker: ");
      body.append(this.served);
      body.append("\n");
      resp.set_content_type("text/plain");
      resp.set_body_string(body);
    }
  }

  // Build one HelloHandler per worker, as a Server expects.
  public function hello_handlers(alloc: const ref HeapAllocator, count: i32) Vec<IHandler> {
    var out = Vec<IHandler>(alloc, _convert<i64>(count));
    for (var i: i32 = 0; i < count; i = i + 1) {
      out.push(HelloHandler(alloc));
    }
    return out;
  }
}

// Serve on every interface until SIGINT or SIGTERM.
function main() i32 {
  var alloc = make_heap_allocator();
  var cfg = Config(alloc);
  cfg.add_listen(ipv4_any(), 8080);
  try {
    install_signal_handlers();
    var server = Server(alloc, cfg, hello_handler.hello_handlers(alloc, online_cpus()));
    return server.run();
  } catch (e: IError) {
    var msg: String = e.message();
    eprintln(msg);
    return 1;
  }
}

manifest {
  source_files: [
    "$SUN_SERVE_SRC/version.sun",
    "$SUN_SERVE_SRC/sys_ffi.sun",
    "$SUN_SERVE_SRC/abi_linux.sun",
    "$SUN_SERVE_SRC/buffer.sun",
    "$SUN_SERVE_SRC/net.sun",
    "$SUN_SERVE_SRC/epoll.sun",
    "$SUN_SERVE_SRC/log.sun",
    "$SUN_SERVE_SRC/config.sun",
    "$SUN_SERVE_SRC/http/status.sun",
    "$SUN_SERVE_SRC/http/date.sun",
    "$SUN_SERVE_SRC/http/mime.sun",
    "$SUN_SERVE_SRC/http/request.sun",
    "$SUN_SERVE_SRC/http/response.sun",
    "$SUN_SERVE_SRC/handler.sun",
    "$SUN_SERVE_SRC/tls/openssl_server.sun",
    "$SUN_SERVE_SRC/tls/tls_context.sun",
    "$SUN_SERVE_SRC/tls/tls_session.sun",
    "$SUN_SERVE_SRC/transport.sun",
    "$SUN_SERVE_SRC/signals.sun",
    "$SUN_SERVE_SRC/connection.sun",
    "$SUN_SERVE_SRC/worker.sun",
    "$SUN_SERVE_SRC/server.sun",
    "$SUN_SERVE_SRC/static_files.sun"
  ]
  test_files: ["hello_tests.sun"]
  libraries: ["stdlib.moon", "tls.moon"]
}
