/*
 * hello_tests.sun - The example handler, exercised end to end over loopback
 *
 * Each test starts a real server on a kernel-picked port, sends one request
 * with a plain TCP socket, and checks the reply. The same pattern works for
 * testing any handler built on sun_serve.
 */

/*
 * Extends the example module with integration tests.
 */
module hello_handler {
  /*
   * Contains the example integration tests.
   */
  module tests {
    using std;
    using sun_serve;

    /*
     * A HelloHandler server on loopback with one worker, so /stats counts
     * every request the test sends.
     */
    class TestServer {
      // The running example server.
      public var server: Server;
      // The loopback port assigned to the server.
      public var port: i32;

      init(alloc: ref HeapAllocator) throws IError {
        var cfg = Config(alloc);
        cfg.add_listen(ipv4_loopback(), 0);
        cfg.timeouts.drain_ms = 500;
        cfg.timeouts.tick_ms = 50;
        cfg.access_log = false;
        cfg.log_level = LogLevel.Error;
        this.server = Server(alloc, cfg, hello_handlers(alloc, 1));
        this.server.start();
        this.port = this.server.port(0);
      }

      /*
       * Send one request with Connection: close and return the whole reply.
       * A receive timeout turns a server that never answers into a failure
       * instead of a hang.
       */
      public method exchange(alloc: ref HeapAllocator, request: static_ptr<u8>) String throws IError {
        var stream = TcpStream();
        stream.connect_local(this.port);
        set_socket_receive_timeout(stream.get_fd(), 10);
        stream.send_str(request);
        var reply = String(alloc, "");
        var chunk = ContiguousBuffer<u8>(alloc, 4096);
        while (true) {
          var n: i64 = stream.recv(chunk);
          if (n <= 0) {
            break;
          }
          reply.append(String(alloc, chunk, n));
        }
        stream.close();
        return reply;
      }
    }

    // Append an HTTP/2 frame header to a binary test string.
    function append_h2_frame(out: ref String, len: i64, kind: H2FrameKind, flags: u8, stream: u32) void {
      out.append_char(_convert<u8>((len >> 16) & 0xff));
      out.append_char(_convert<u8>((len >> 8) & 0xff));
      out.append_char(_convert<u8>(len & 0xff));
      out.append_char(_convert<u8>(kind));
      out.append_char(flags);
      out.append_char(_convert<u8>((stream >> 24) & 0x7f));
      out.append_char(_convert<u8>((stream >> 16) & 0xff));
      out.append_char(_convert<u8>((stream >> 8) & 0xff));
      out.append_char(_convert<u8>(stream & 0xff));
    }

    // HTTP/2 frame flags used by the fixtures.
    const H2_END_STREAM: u8 = 0x1;
    const H2_END_HEADERS: u8 = 0x4;

    // WebSocket fields used by client-frame fixtures.
    const WS_FIN_FLAG: u8 = 0x80;
    const WS_COMPRESSED_FLAG: u8 = 0x40;
    const WS_MASK_FLAG: u8 = 0x80;
    const WS_TEXT_OPCODE: u8 = _convert<u8>(WebSocketOpcode.Text);
    const WS_SHORT_PAYLOAD_MAX: i64 = 125;
    const WS_HEADER_BYTES: i64 = 2;
    const WS_MASK_BYTES: i64 = 4;
    const TEST_MASK_FIRST_BYTE: i64 = 1;

    // Build a masked client text frame from a literal.
    function masked_text_frame(alloc: const ref HeapAllocator, text: static_ptr<u8>, compressed: bool) ContiguousBuffer<u8> throws IError {
      var source = ByteBuffer(alloc, text.length());
      source.append_literal(text);
      var payload = ByteBuffer(alloc, text.length());
      if (compressed) {
        std.test.assert(websocket_deflate(source, 0, source.readable_len(), payload), "compress test frame");
      } else {
        payload.append_buffer(source, 0, source.readable_len());
      }
      var payload_len: i64 = payload.readable_len();
      std.test.assert(payload_len <= WS_SHORT_PAYLOAD_MAX, "test frame uses short payload encoding");
      var wire = ByteBuffer(alloc, WS_HEADER_BYTES + WS_MASK_BYTES + payload_len);
      var first: u8 = WS_FIN_FLAG | WS_TEXT_OPCODE;
      if (compressed) {
        first = first | WS_COMPRESSED_FLAG;
      }
      wire.append_byte(first);
      wire.append_byte(WS_MASK_FLAG | _convert<u8>(payload_len));
      for (var i: i64 = 0; i < WS_MASK_BYTES; i = i + 1) {
        wire.append_byte(_convert<u8>(TEST_MASK_FIRST_BYTE + i));
      }
      for (var i: i64 = 0; i < payload_len; i = i + 1) {
        var mask: u8 = _convert<u8>(TEST_MASK_FIRST_BYTE + (i % WS_MASK_BYTES));
        wire.append_byte(payload.byte_at(i) ^ mask);
      }
      var frame = ContiguousBuffer<u8>(alloc, wire.readable_len());
      for (var i: i64 = 0; i < wire.readable_len(); i = i + 1) {
        frame[i] = wire.byte_at(i);
      }
      return frame;
    }

    // The body is everything after the blank line that ends the head.
    function body_of(alloc: ref HeapAllocator, reply: const ref String) String throws IError {
      var start: i64 = find_header_end(reply) + 4;
      return reply.substr(alloc, start, reply.length() - start);
    }

    test_function greets_by_name() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      var reply: String = ts.exchange(alloc, "GET /hi?name=sun HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
      std.test.assert(reply.starts_with("HTTP/1.1 200 "), "status");
      std.test.assert(reply.contains("Content-Type: text/plain"), "content type");
      var body: String = body_of(alloc, reply);
      std.test.assert(body.equals_literal("hello, sun\n"), "greeting");
    }

    test_function greets_the_world_without_a_name() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      var reply: String = ts.exchange(alloc, "GET /hi HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
      var body: String = body_of(alloc, reply);
      std.test.assert(body.equals_literal("hello, world\n"), "default greeting");
    }

    test_function echoes_a_posted_body() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      var reply: String = ts.exchange(alloc, "POST /echo HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\nConnection: close\r\n\r\nping");
      std.test.assert(reply.starts_with("HTTP/1.1 200 "), "status");
      var body: String = body_of(alloc, reply);
      std.test.assert(body.equals_literal("ping"), "echoed body");
    }

    test_function echo_rejects_other_methods() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      var reply: String = ts.exchange(alloc, "GET /echo HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
      std.test.assert(reply.starts_with("HTTP/1.1 405 "), "method not allowed");
      std.test.assert(reply.contains("Allow: POST"), "allow header");
    }

    test_function counts_requests_per_worker() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      ts.exchange(alloc, "GET /hi HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
      ts.exchange(alloc, "GET /hi HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
      var reply: String = ts.exchange(alloc, "GET /stats HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
      var body: String = body_of(alloc, reply);
      std.test.assert(body.equals_literal("requests handled by this worker: 3\n"), "third request");
    }

    test_function websocket_upgrade_and_echo() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      var stream = TcpStream();
      stream.connect_local(ts.port);
      set_socket_receive_timeout(stream.get_fd(), 2);
      stream.send_str("GET /ws HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
      var reply = ContiguousBuffer<u8>(alloc, 4096);
      var got: i64 = stream.recv(reply);
      var head = String(alloc, reply, got);
      std.test.assert(head.contains("101 Switching Protocols"), "upgrade accepted");
      std.test.assert(head.contains("s3pPLMBiTxaQ9kYGzzhZRbK+xOo="), "accept key");
      var message = String(alloc, "hello");
      var frame = masked_text_frame(alloc, "hello", false);
      stream.send_bytes(frame.raw_data(), frame.size());
      var echoed = ContiguousBuffer<u8>(alloc, 16);
      var echoed_len: i64 = stream.recv(echoed);
      std.test.assert_eq(echoed_len, WS_HEADER_BYTES + message.length());
      std.test.assert_eq(echoed[0], WS_FIN_FLAG | WS_TEXT_OPCODE);
      std.test.assert_eq(echoed[1], _convert<u8>(message.length()));
      var text: String = String(alloc, echoed, echoed_len).substr(alloc, WS_HEADER_BYTES, message.length());
      std.test.assert(text.equals(message), "message echoed");
      stream.close();
    }

    test_function http2_websocket_and_http_share_connection() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      var stream = TcpStream();
      stream.connect_local(ts.port);
      set_socket_receive_timeout(stream.get_fd(), 2);
      var wire = String(alloc, "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n");
      // SETTINGS: enable the extended CONNECT protocol.
      append_h2_frame(wire, 6, H2FrameKind.Settings, 0, 0);
      wire.append("\x00\x08\x00\x00\x00\x01");
      // HEADERS on stream 1: CONNECT /ws with :protocol websocket.
      append_h2_frame(wire, 39, H2FrameKind.Headers, H2_END_HEADERS, 1);
      wire.append("\x02\x07CONNECT");  // literal :method
      wire.append("\x00\x09:protocol\x09websocket");  // literal name and value
      wire.append("\x86");  // indexed :scheme http
      wire.append("\x04\x03/ws");  // literal :path
      wire.append("\x01\x01a");  // literal :authority
      // DATA on stream 1: a masked WebSocket text frame saying "hello".
      append_h2_frame(wire, 11, H2FrameKind.Data, 0, 1);
      wire.append("\x81\x85\x01\x02\x03\x04igohn");
      // HEADERS on stream 3: GET /hi over the same connection.
      append_h2_frame(wire, 7, H2FrameKind.Headers, H2_END_HEADERS | H2_END_STREAM, 3);
      wire.append("\x82\x86\x04\x03/hi");
      stream.send_string(wire);
      var received = String(alloc, "");
      var chunk = ContiguousBuffer<u8>(alloc, 4096);
      while (not received.contains("hello, world") or not received.contains("hello")) {
        var got: i64 = stream.recv(chunk);
        if (got <= 0) {
          break;
        }
        received.append(String(alloc, chunk, got));
      }
      std.test.assert(received.contains("hello"), "WebSocket stream echoed");
      std.test.assert(received.contains("hello, world"), "HTTP stream completed");
      stream.close();
    }

    test_function websocket_permessage_deflate_echo() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      var stream = TcpStream();
      stream.connect_local(ts.port);
      set_socket_receive_timeout(stream.get_fd(), 2);
      stream.send_str("GET /ws HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n");
      var reply = ContiguousBuffer<u8>(alloc, 4096);
      var got: i64 = stream.recv(reply);
      var head = String(alloc, reply, got);
      std.test.assert(head.contains("permessage-deflate; server_no_context_takeover; client_no_context_takeover"), "compression negotiated");
      var message = String(alloc, "hello");
      var frame = masked_text_frame(alloc, "hello", true);
      stream.send_bytes(frame.raw_data(), frame.size());
      var echoed = ContiguousBuffer<u8>(alloc, 32);
      var echoed_len: i64 = stream.recv(echoed);
      std.test.assert_eq(echoed[0], WS_FIN_FLAG | WS_COMPRESSED_FLAG | WS_TEXT_OPCODE);
      var compressed_len: i64 = _convert<i64>(echoed[1]);
      std.test.assert_eq(echoed_len, WS_HEADER_BYTES + compressed_len);
      var compressed = ByteBuffer(alloc, compressed_len);
      for (var i: i64 = WS_HEADER_BYTES; i < echoed_len; i = i + 1) {
        compressed.append_byte(echoed[i]);
      }
      var decoded = ByteBuffer(alloc, message.length());
      std.test.assert_eq(websocket_inflate(alloc, compressed, 0, compressed.readable_len(), message.length(), decoded), 0);
      var text: String = decoded.range_text(alloc, 0, decoded.readable_len());
      std.test.assert(text.equals(message), "compressed message echoed");
      stream.close();
    }

    test_function unknown_paths_are_404() {
      var alloc = make_heap_allocator();
      var ts = TestServer(alloc);
      var reply: String = ts.exchange(alloc, "GET /missing HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
      std.test.assert(reply.starts_with("HTTP/1.1 404 "), "not found");
    }
  }
}
